diff --git a/init/do_mounts.c b/init/do_mounts.c
index 811e94daf..aa1999a8b 100644
--- a/init/do_mounts.c
+++ b/init/do_mounts.c
@@ -31,6 +31,7 @@ int root_mountflags = MS_RDONLY | MS_SILENT;
 static char * __initdata root_device_name;
 static char __initdata saved_root_name[64];
 static int root_wait;
+static unsigned int rootwait_timeout = 30;	/* seconds */
 
 dev_t ROOT_DEV;
 
@@ -312,6 +313,25 @@ static int __init rootwait_setup(char *str)
 
 __setup("rootwait", rootwait_setup);
 
+/*
+ * eMMC rescan is asynchronous and can legitimately finish after
+ * prepare_namespace() has already tried to resolve root=.  Waiting for the
+ * device is therefore required, but an unbounded wait turns a genuinely
+ * missing device into a silent hang.  Bound it so a failure is reported and
+ * mount_root() can dump the available partitions.
+ * Override with rootwait_timeout=<seconds> (1..600, default 30).
+ */
+static int __init rootwait_timeout_setup(char *str)
+{
+	unsigned long seconds = simple_strtoul(str, NULL, 0);
+
+	if (seconds > 0 && seconds <= 600)
+		rootwait_timeout = (unsigned int)seconds;
+	return 1;
+}
+
+__setup("rootwait_timeout=", rootwait_timeout_setup);
+
 static char * __initdata root_mount_data;
 static int __init root_data_setup(char *str)
 {
@@ -633,11 +653,33 @@ void __init prepare_namespace(void)
 
 	/* wait for any asynchronous scanning to complete */
 	if ((ROOT_DEV == 0) && root_wait) {
-		printk(KERN_INFO "Waiting for root device %s...\n",
-			saved_root_name);
-		while (driver_probe_done() != 0 ||
-			(ROOT_DEV = name_to_dev_t(saved_root_name)) == 0)
+		unsigned int waited_ms = 0;
+
+		printk(KERN_INFO "Waiting for root device %s (max %us)...\n",
+			saved_root_name, rootwait_timeout);
+		/*
+		 * Resolve the root device on EVERY iteration, independent of
+		 * driver_probe_done(). The old form
+		 *   driver_probe_done() != 0 || (ROOT_DEV = name_to_dev_t(...)) == 0
+		 * short-circuits: while any driver is still probing (e.g. a GPU
+		 * with an unpowered domain, or a device looping -EPROBE_DEFER),
+		 * name_to_dev_t() is never called, ROOT_DEV stays 0 and the
+		 * bounded timeout then panics with unknown-block(0,0) even though
+		 * the eMMC partition is already present. Probing is unrelated to
+		 * whether /dev/mmcblk0p8 exists, so never gate it on probe state.
+		 */
+		while (1) {
+			ROOT_DEV = name_to_dev_t(saved_root_name);
+			if (ROOT_DEV != 0)
+				break;
+			if (waited_ms >= rootwait_timeout * 1000) {
+				pr_emerg("rootwait: %s did not appear within %us, giving up\n",
+					saved_root_name, rootwait_timeout);
+				break;
+			}
 			msleep(5);
+			waited_ms += 5;
+		}
 		async_synchronize_full();
 	}
 
