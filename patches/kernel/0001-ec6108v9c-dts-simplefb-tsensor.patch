--- a/arch/arm/boot/dts/hi3798mv100-ec6108v9c.dts
+++ b/arch/arm/boot/dts/hi3798mv100-ec6108v9c.dts
@@ -8,6 +8,7 @@
 
 	chosen {
 		stdout-path = "serial0:115200n8";
+		bootargs = "__CMDLINE__";
 	};
 
 	leds {
@@ -31,6 +32,29 @@
 			panic-indicator;
 			default-state = "off";
 		};
+	};
+
+/*
+ * Memory map: DDR starts at physical 0x0 on this board (verified via
+ * /proc/iomem: 00000000-3fffffff System RAM). The kernel command line
+ * (/chosen/bootargs) carries mem=, blkdevparts= and root=, so the tree
+ * stays correct even if the bootloader passes nothing useful.
+ */
+	memory@0 {
+		device_type = "memory";
+		reg = <0x0 __MEM_SIZE__>;
+	};
+
+/* Framebuffer node block injected by scripts/apply-dts-placeholders.py.
+ * It stays empty unless a framebuffer address is confirmed.
+ */
+__FB_BLOCK__
+
+/* on-chip Tsensor (PMC 0xF8A23000) - exposed via thermal_zone */
+	tsensor: tsensor@f8a23000 {
+		compatible = "hisilicon,hi3798mv100-tsensor";
+		reg = <0xf8a23000 0x1000>;
+		status = "okay";
 	};
 };
 
