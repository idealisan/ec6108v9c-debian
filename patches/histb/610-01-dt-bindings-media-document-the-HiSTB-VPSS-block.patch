From bbc802bee6e13909eee2c63e52d552380ba95227 Mon Sep 17 00:00:00 2001
From: David Yang <mmyangfl@gmail.com>
Date: Tue, 3 Nov 2026 13:49:29 +0800
Subject: [PATCH 1/2] dt-bindings: media: document the HiSTB VPSS block

The video processing block the mv100 and mv200 device trees already
carry has no schema. It takes one register window, its clock gate, an
optional SMMU clock and reset, and its buffers from a reserved region.
Document the compatible, the register window, clocks, resets and the
reserved-memory phandle; the interrupt line stays optional because the
driver polls for completion.

Signed-off-by: David Yang <mmyangfl@gmail.com>
---
 .../media/hisilicon,hi3798mv100-vpss.yaml     | 110 ++++++++++++++++++
 1 file changed, 110 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/media/hisilicon,hi3798mv100-vpss.yaml

--- /dev/null
+++ b/Documentation/devicetree/bindings/media/hisilicon,hi3798mv100-vpss.yaml
@@ -0,0 +1,110 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/media/hisilicon,hi3798mv100-vpss.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: HiSilicon HiSTB Video Processing Subsystem (VPSS)
+
+maintainers:
+  - David Yang <mmyangfl@gmail.com>
+
+description: |-
+  The video processing subsystem sits between a decoder and an encoder or a
+  display: it converts a frame between YUV layouts, scales it, rotates it
+  and de-interlaces it. The block has its own register window, clock gate and
+  reset request in the clock and reset generator.
+
+  Hi3798MV200 has the same block a generation on (its VPSS_VERSION answers
+  0x4000 out of reset, Hi3798MV100 an earlier value) and gives it a second
+  clock and reset for the memory accessor's own SMMU.
+
+properties:
+  compatible:
+    enum:
+      - hisilicon,hi3798mv100-vpss
+      - hisilicon,hi3798mv200-vpss
+
+  reg:
+    maxItems: 1
+    description:
+      Register window. The window has to cover the block's own SMMU band at
+      the top of it, which is why the length reaches past the control
+      registers.
+
+  interrupts:
+    maxItems: 1
+    description:
+      The block's completion interrupt. The driver polls for completion
+      instead, so this line is described but not requested.
+
+  clocks:
+    minItems: 1
+    maxItems: 2
+
+  clock-names:
+    oneOf:
+      - const: vpss
+      - items:
+          - const: vpss
+          - const: vpss-smmu
+
+  resets:
+    minItems: 1
+    maxItems: 2
+
+  reset-names:
+    oneOf:
+      - const: vpss
+      - items:
+          - const: vpss
+          - const: vpss-smmu
+
+  memory-region:
+    maxItems: 1
+    description:
+      Phandle to a reserved memory region to allocate buffers from. The block
+      is programmed with single physical addresses, so buffers have to be
+      physically contiguous. Without this property they are taken from the
+      default CMA area.
+
+allOf:
+  - if:
+      properties:
+        compatible:
+          contains:
+            const: hisilicon,hi3798mv100-vpss
+    then:
+      properties:
+        clocks:
+          maxItems: 1
+        clock-names:
+          const: vpss
+        resets:
+          maxItems: 1
+        reset-names:
+          const: vpss
+
+required:
+  - compatible
+  - reg
+  - clocks
+  - clock-names
+
+additionalProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/interrupt-controller/arm-gic.h>
+    #include <dt-bindings/clock/hisilicon,hi3798mv100-crg.h>
+
+    vpss: video-processor@8cb0000 {
+        compatible = "hisilicon,hi3798mv100-vpss";
+        reg = <0x8cb0000 0x10000>;
+        interrupts = <GIC_SPI 93 IRQ_TYPE_LEVEL_HIGH>;
+        clocks = <&crg HI3798MV100_VPSS_CLK>;
+        clock-names = "vpss";
+        resets = <&crg 0xf0 4>;
+        reset-names = "vpss";
+        status = "disabled";
+    };
