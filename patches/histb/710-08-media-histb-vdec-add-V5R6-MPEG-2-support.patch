From 56b6f1a61d96a76e2a91039a031c2cf6b0f8a61e Mon Sep 17 00:00:00 2001
From: David Yang <mmyangfl@gmail.com>
Date: Tue, 3 Nov 2026 14:41:30 +0800
Subject: [PATCH 8/10] media: histb-vdec: add V5R6 MPEG-2 support

The stateless controls carry the sequence, picture and quantisation
headers but not the slices, so the driver walks the submitted access
unit for slice_start_code and decodes the 13818-2 6.2.2.4 slice header
itself into the 8-word descriptors the picture message links. The
reference pictures are named by the two timestamps the picture control
carries, so no picture buffer list is needed here: each timestamp
resolves to the capture buffer it was queued on.

Signed-off-by: David Yang <mmyangfl@gmail.com>
---
 .../platform/hisilicon/histb-vdec/Makefile    |   1 +
 .../hisilicon/histb-vdec/histb_vdec_v5_core.c |   1 +
 .../histb-vdec/histb_vdec_v5_mpeg2.c          | 627 ++++++++++++++++++
 3 files changed, 629 insertions(+)
 create mode 100644 drivers/media/platform/hisilicon/histb-vdec/histb_vdec_v5_mpeg2.c

--- a/drivers/media/platform/hisilicon/histb-vdec/Makefile
+++ b/drivers/media/platform/hisilicon/histb-vdec/Makefile
@@ -13,3 +13,4 @@ histb-vdec-y += histb_vdec_v5_hw.o
 histb-vdec-y += histb_vdec_v5_core.o
 histb-vdec-y += histb_vdec_v5_h264.o
 histb-vdec-y += histb_vdec_v5_hevc.o
+histb-vdec-y += histb_vdec_v5_mpeg2.o
--- a/drivers/media/platform/hisilicon/histb-vdec/histb_vdec_v5_core.c
+++ b/drivers/media/platform/hisilicon/histb-vdec/histb_vdec_v5_core.c
@@ -67,6 +67,7 @@ struct histb_vdec_v5 *histb_vdec_v5_of_c
 static const histb_vdec_v5_fmt_desc *const histb_vdec_v5_fmt_list[] = {
 	&histb_vdec_v5_h264_fmt,
