From fe981b80882e75e300cdc722e52d16438dfca087 Mon Sep 17 00:00:00 2001
From: David Yang <mmyangfl@gmail.com>
Date: Fri, 23 Oct 2026 10:06:53 +0800
Subject: [PATCH 3/4] dt-bindings: mtd: describe the Hi3716CV200 NAND
 controller

The flash controller the system boots from needs a node of its own, and
it names two windows because the block separates its register file from
the byte window commands travel through. The ECC pair is stated as a
const because that is the only strength this part has ever been read
with -- the vendor system's live CON carries ECCTYPE 1, which the
block's table calls eight bits per 1024-byte step.

The node also names the block's own soft reset, CRG24 bit 4: the driver
holds it and releases it before writing any register, so the block is
never configured on top of the state a previous owner left in it.

The example takes its clock id from the SoC's own CRG header, spelled
with the vendor prefix the way the Hi3798MV100 line spells its header,
so the binding does not lean on the deprecated histb-clock.h shim.

make dt_binding_check on this file is clean, and the example builds.

Signed-off-by: David Yang <mmyangfl@gmail.com>
---
 ...hisilicon,hi3716cv200-nand-controller.yaml | 72 +++++++++++++++++++
 1 file changed, 72 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/mtd/hisilicon,hi3716cv200-nand-controller.yaml

--- /dev/null
+++ b/Documentation/devicetree/bindings/mtd/hisilicon,hi3716cv200-nand-controller.yaml
@@ -0,0 +1,72 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/mtd/hisilicon,hi3716cv200-nand-controller.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: HiSilicon Hi3716CV200 NAND Flash Controller (hinfc610)
+
+maintainers:
+  - David Yang <mmyangfl@gmail.com>
+
+description: |
+  The NAND flash controller of the Hi3716CV200 separates its register file
+  from the window the command, address and status bytes travel through, so
+  both ranges are listed. Transfers are set up in the register file and moved
+  by the block's own DMA engine; the completion is polled, because the
+  interrupts of this instance are not wired to the distributor.
+
+  The engine corrects eight bits per 1024-byte step, and the only page size
+  this generation has been used with is 2 KiB.
+
+  The reset is the block's own soft reset, CRG24 bit 4, which sits beside the
+  clock gate in the same register; the driver holds it and releases it before
+  it writes any of its registers, so the block is never configured with the
+  state a previous owner left in it.
+
+allOf:
+  - $ref: nand-controller.yaml
+
+properties:
+  compatible:
+    const: hisilicon,hi3716cv200-nand-controller
+
+  reg:
+    minItems: 2
+    maxItems: 2
+
+  clocks:
+    maxItems: 1
+
+  resets:
+    maxItems: 1
+
+  nand-ecc-strength:
+    const: 8
+
+  nand-ecc-step-size:
+    enum: [ 512, 1024 ]
+
+required:
+  - compatible
+  - reg
+  - clocks
+  - resets
+
+unevaluatedProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/clock/hisilicon,hi3716cv200-crg.h>
+
+    nandc: nand-controller@f9810000 {
+        compatible = "hisilicon,hi3716cv200-nand-controller";
+        reg = <0xf9810000 0x100>, <0xfe000000 0x2176>;
+        clocks = <&crg HI3716CV200_NAND_CLK>;
+        resets = <&crg 0x60 4>;
+        #address-cells = <1>;
+        #size-cells = <0>;
+
+        nand-ecc-strength = <8>;
+        nand-ecc-step-size = <1024>;
+    };
