From 6fd4cb8f3b2063a1a48a17a01ad1dbdc3a91f8bf Mon Sep 17 00:00:00 2001
From: David Yang <mmyangfl@gmail.com>
Date: Sun, 18 Oct 2026 15:56:41 +0800
Subject: [PATCH] dt-bindings: rng: document the HiSilicon STB TRNG

The TRNG block has had a driver for a while but no binding. Describe it
as the 4 KiB register window that the manual maps at 0xf8005000: a
control word that selects the source and programs the post-processor
depth, a data word, and a status word whose low bits count ready words.
Its clock gate and soft reset are the ones the SHA engine uses, and the
boot loader already leaves the gate enabled, so a node needs neither
clocks nor resets.

Signed-off-by: David Yang <mmyangfl@gmail.com>
---
 .../bindings/rng/hisilicon,histb-rng.yaml     | 43 +++++++++++++++++++
 1 file changed, 43 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/rng/hisilicon,histb-rng.yaml

--- /dev/null
+++ b/Documentation/devicetree/bindings/rng/hisilicon,histb-rng.yaml
@@ -0,0 +1,43 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/rng/hisilicon,histb-rng.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: HiSilicon STB true random number generator
+
+maintainers:
+  - David Yang <mmyangfl@gmail.com>
+
+description: |
+  The TRNG block of HiSilicon STB SoCs. It exposes three registers -- a control
+  word that starts the post processor and sets its depth, a data word, and a
+  status word whose low bits count how many words are ready. The block has no
+  gate of its own in the CRG: on hi3798mv100 it shares the SHA engine's clock
+  gate and soft reset (PERI CRG register +0xc4, bits 0 and 4), which the boot
+  loader leaves enabled, so reading the block needs no clocks or resets
+  property.
+
+properties:
+  compatible:
+    const: hisilicon,histb-rng
+
+  reg:
+    maxItems: 1
+    description:
+      The three registers, so the entry starts at the control word. On
+      hi3798mv100 the control word sits at the base of the enclosing 4 KiB TRNG
+      window at 0xf8005000.
+
+required:
+  - compatible
+  - reg
+
+additionalProperties: false
+
+examples:
+  - |
+    rng@8005000 {
+        compatible = "hisilicon,histb-rng";
+        reg = <0x8005000 0x1000>;
+    };
