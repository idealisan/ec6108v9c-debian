+static void histb_jpgd_v4l2_release(struct v4l2_device *v4l2_dev)
+{
+	struct histb_jpgd *jpgd = container_of(v4l2_dev, struct histb_jpgd, v4l2_dev);
+
+	v4l2_device_unregister(v4l2_dev);
+	if (jpgd->m2m_dev)
+		v4l2_m2m_release(jpgd->m2m_dev);
+	put_device(jpgd->memdev);
+	kfree(jpgd);
+}
+
+static void histb_jpgd_v4l2_put(void *data)
+{
+	struct histb_jpgd *jpgd = data;
+
+	v4l2_device_put(&jpgd->v4l2_dev);
+}
+
+static int histb_jpgd_probe(struct platform_device *pdev)
+{
+	struct platform_device *mem;
+	struct histb_jpgd *jpgd;
+	struct video_device *vdev;
+	int ret, irq;
+
+	jpgd = kzalloc_obj(*jpgd);
+	if (!jpgd)
+		return -ENOMEM;
+
+	ret = v4l2_device_register(&pdev->dev, &jpgd->v4l2_dev);
+	if (ret) {
+		kfree(jpgd);
+		return ret;
+	}
+	jpgd->v4l2_dev.release = histb_jpgd_v4l2_release;
+	ret = devm_add_action_or_reset(&pdev->dev, histb_jpgd_v4l2_put, jpgd);
+	if (ret)
+		return ret;
+
+	jpgd->dev = &pdev->dev;
+	jpgd->chip = of_device_get_match_data(&pdev->dev);
+	if (!jpgd->chip)
+		return dev_err_probe(&pdev->dev, -ENODEV, "unknown device\n");
+	platform_set_drvdata(pdev, jpgd);
+	mutex_init(&jpgd->hw_lock);
+	mutex_init(&jpgd->vdev_lock);
+	init_waitqueue_head(&jpgd->done);
+
+	jpgd->regs = devm_platform_ioremap_resource(pdev, 0);
+	if (IS_ERR(jpgd->regs))
+		return PTR_ERR(jpgd->regs);
+
+	jpgd->clk = devm_clk_get(&pdev->dev, "jpgd");
+	if (IS_ERR(jpgd->clk))
+		return dev_err_probe(&pdev->dev, PTR_ERR(jpgd->clk),
+				     "no clock\n");
+
+	ret = clk_prepare_enable(jpgd->clk);
+	if (ret)
+		return dev_err_probe(&pdev->dev, ret, "cannot enable clock\n");
+
+	jpgd->rst = devm_reset_control_get_exclusive(&pdev->dev, "jpgd");
+	if (IS_ERR(jpgd->rst)) {
+		ret = PTR_ERR(jpgd->rst);
+		goto err_clk;
+	}
+
+	irq = platform_get_irq(pdev, 0);
+	if (irq < 0) {
+		ret = irq;
+		goto err_clk;
+	}
+
+	/* Exported buffers retain the allocator across unbind and rebind. */
+	mem = platform_device_alloc("histb-jpgd-dma", PLATFORM_DEVID_NONE);
+	if (!mem) {
+		ret = -ENOMEM;
+		goto err_clk;
+	}
+	jpgd->memdev = &mem->dev;
+	platform_device_set_of_node(mem, pdev->dev.of_node);
+	mem->dev.coherent_dma_mask = DMA_BIT_MASK(32);
+	ret = of_dma_configure(&mem->dev, mem->dev.of_node, true);
+	if (ret) {
+		dev_err_probe(&pdev->dev, ret, "failed to configure DMA\n");
+		goto err_clk;
+	}
+
+	/* A DT without "memory-region" keeps using the default CMA area. */
+	ret = devm_of_reserved_mem_device_init(&mem->dev);
+	if (ret && ret != -ENODEV) {
+		dev_err(&pdev->dev, "failed to bind reserved memory\n");
+		goto err_clk;
+	}
+
+	ret = dma_set_mask_and_coherent(&pdev->dev, DMA_BIT_MASK(32));
+	if (ret) {
+		dev_err(&pdev->dev, "failed to set DMA mask\n");
+		goto err_clk;
+	}
+	vb2_dma_contig_set_max_seg_size(jpgd->memdev, DMA_BIT_MASK(32));
+
+	jpgd->m2m_dev = v4l2_m2m_init(&histb_jpgd_m2m_ops);
+	if (IS_ERR(jpgd->m2m_dev)) {
+		ret = PTR_ERR(jpgd->m2m_dev);
+		jpgd->m2m_dev = NULL;
+		v4l2_err(&jpgd->v4l2_dev, "failed to init mem2mem device\n");
+		goto err_clk;
+	}
+
+	vdev = video_device_alloc();
+	if (!vdev) {
+		ret = -ENOMEM;
+		goto err_clk;
+	}
+	jpgd->vdev = vdev;
+	vdev->v4l2_dev = &jpgd->v4l2_dev;
+	vdev->fops = &histb_jpgd_fops;
+	vdev->ioctl_ops = &histb_jpgd_ioctl_ops;
+	vdev->lock = &jpgd->vdev_lock;
+	vdev->release = video_device_release;
+	vdev->vfl_dir = VFL_DIR_M2M;
+	vdev->device_caps = V4L2_CAP_VIDEO_M2M | V4L2_CAP_STREAMING;
+	strscpy(vdev->name, HISTB_JPGD_NAME, sizeof(vdev->name));
+	video_set_drvdata(vdev, jpgd);
+
+	/*
+	 * The block may come up mid-job from the bootloader: reset it, wait for it
+	 * to idle, mask the low-delay source and only then take the line over.
+	 */
+	ret = histb_jpgd_reset(jpgd);
+	if (ret)
+		goto err_vdev;
+
+	ret = devm_request_irq(&pdev->dev, irq, histb_jpgd_irq, 0,
+			       HISTB_JPGD_NAME, jpgd);
+	if (ret) {
+		dev_err(&pdev->dev, "failed to request irq\n");
+		goto err_assert;
+	}
+	jpgd->irq = irq;
+
+	ret = video_register_device(vdev, VFL_TYPE_VIDEO, -1);
+	if (ret) {
+		v4l2_err(&jpgd->v4l2_dev, "failed to register video device\n");
+		goto err_irq;
+	}
+
+	/* The block is only clocked while a job is in flight. */
+	clk_disable_unprepare(jpgd->clk);
+	pm_runtime_set_suspended(&pdev->dev);
+	pm_runtime_set_autosuspend_delay(&pdev->dev, 100);
+	pm_runtime_use_autosuspend(&pdev->dev);
+	pm_runtime_enable(&pdev->dev);
+
+	return 0;
+
+err_irq:
+	disable_irq(jpgd->irq);
+err_assert:
+	reset_control_assert(jpgd->rst);
+err_vdev:
+	video_device_release(vdev);
+err_clk:
+	clk_disable_unprepare(jpgd->clk);
+	return ret;
+}
+
+static void histb_jpgd_remove(struct platform_device *pdev)
+{
+	struct histb_jpgd *jpgd = platform_get_drvdata(pdev);
+
+	/*
+	 * v4l2_m2m_release() is only a kfree() in this tree, so it cannot be what
+	 * waits for a job: a client parked in device_run would keep using the
+	 * m2m device after remove returned. Pause the queue and let the running
+	 * job finish while its interrupt is still live, then mask the line
+	 * before the clock and reset go away -- a late report against an
+	 * unclocked block is an abort inside the handler, not a lost wakeup.
+	 */
+	mutex_lock(&jpgd->vdev_lock);
+	WRITE_ONCE(jpgd->removing, true);
+	v4l2_m2m_suspend(jpgd->m2m_dev);
+	disable_irq(jpgd->irq);
+	video_unregister_device(jpgd->vdev);
+	mutex_unlock(&jpgd->vdev_lock);
+	reset_control_assert(jpgd->rst);
+	pm_runtime_dont_use_autosuspend(&pdev->dev);
+	pm_runtime_disable(&pdev->dev);
+	if (!pm_runtime_status_suspended(&pdev->dev))
+		pm_runtime_suspend(&pdev->dev);
+}
+
+static int histb_jpgd_runtime_suspend(struct device *dev)
+{
+	struct histb_jpgd *jpgd = dev_get_drvdata(dev);
+
+	clk_disable_unprepare(jpgd->clk);
+	return 0;
+}
+
+static int histb_jpgd_runtime_resume(struct device *dev)
+{
+	struct histb_jpgd *jpgd = dev_get_drvdata(dev);
+
+	return clk_prepare_enable(jpgd->clk);
+}
+
+static const struct dev_pm_ops histb_jpgd_pm_ops = {
+	RUNTIME_PM_OPS(histb_jpgd_runtime_suspend,
+		       histb_jpgd_runtime_resume, NULL)
+	SET_SYSTEM_SLEEP_PM_OPS(pm_runtime_force_suspend,
+				pm_runtime_force_resume)
+};
+
+static struct platform_driver histb_jpgd_driver = {
+	.probe = histb_jpgd_probe,
+	.remove = histb_jpgd_remove,
+	.driver = {
+		.name = HISTB_JPGD_NAME,
+		.of_match_table = histb_jpgd_of_match,
+		.pm = pm_ptr(&histb_jpgd_pm_ops),
+	},
+};
+module_platform_driver(histb_jpgd_driver);
+
+MODULE_DESCRIPTION("HiSilicon Hi3798MV100 JPEG decoder driver");
+MODULE_LICENSE("GPL");
