+#define V5R6_PROBE_CHUNK	BITS_PER_LONG
+
+static void histb_vdec_v5_probe_stamp(const u8 *base, size_t size, u32 *sums)
+{
+	size_t off;
+
+	for (off = 0; off < size; off += V5R6_PROBE_CHUNK * 1024)
+		sums[off / (V5R6_PROBE_CHUNK * 1024)] =
+			crc32(~0U, base + off,
+			      min(V5R6_PROBE_CHUNK * 1024, size - off));
+}
+
+/*
+ * Where the engine wrote. The pool and the picture are compared block by block
+ * against a snapshot taken before the launch, so a launch that consumed a
+ * message but produced nothing shows up as which blocks moved.
+ */
+static void histb_vdec_v5_probe_changed(const char *what, const u8 *base,
+				      size_t size, const u32 *before)
+{
+	size_t off;
+	char line[120];
+	int n = 0;
+
+	for (off = 0; off < size; off += V5R6_PROBE_CHUNK * 1024) {
+		u32 now = crc32(~0U, base + off,
+				min(V5R6_PROBE_CHUNK * 1024, size - off));
+
+		if (now == before[off / (V5R6_PROBE_CHUNK * 1024)])
+			continue;
+		n += scnprintf(line + n, sizeof(line) - n, " %s+%zuK", what,
+			       off / 1024);
+		if (n > (int)sizeof(line) - 24)
+			break;
+	}
+	if (!n)
+		n = scnprintf(line, sizeof(line), " none");
+	pr_info("histb-vdec5: changed:%s\n", line);
+}
+
+static void histb_vdec_v5_probe_diff(struct histb_vdec_v5_probe *probe,
+				   const u32 *pool_before,
+				   const u32 *recon_before)
+{
+	struct histb_vdec_v5 *dec = probe->dec;
+
+	histb_vdec_v5_probe_changed("pool", dec->pool.va, V5R6_POOL_BYTES,
+				  pool_before);
+	histb_vdec_v5_probe_changed("recon", probe->recon_va, probe->recon_size,
+				  recon_before);
+}
+
+/*
+ * The register image around one launch. What the engine leaves behind in its
+ * own words tells whether it got as far as the message, the bitstream or the
+ * surface.
