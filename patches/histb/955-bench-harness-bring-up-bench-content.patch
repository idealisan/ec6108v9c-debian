+	{ V5R6_WR_REQ_PER_PIC, "wrreq" }, { V5R6_MB0_QP, "mb0qp" },
+	{ V5R6_RPR_START, "rprst" },
+	{ V5R6_SED_FSTMB, "sedfst" }, { V5R6_SED_LSTMB, "sedlst" },
