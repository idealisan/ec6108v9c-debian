+	{ V5R6_STREAM_BASE, "strm" }, { V5R6_STATE, "state" },
+	{ V5R6_INT_STATE, "int" }, { V5R6_INT_MASK, "mask" },
+	{ V5R6_VCTRL_STATE, "vctrl" }, { V5R6_EMAR_ID, "emarid" },
+	{ V5R6_YSTADDR_1D, "yst" }, { V5R6_YSTRIDE_1D, "ystr" },
+	{ V5R6_UVOFFSET_1D, "uvoff" }, { V5R6_HEAD_INF_OFFSET, "head" },
+	{ V5R6_PPFD_ADDR, "ppfd" }, { V5R6_PPFD_LEN, "pflen" },
