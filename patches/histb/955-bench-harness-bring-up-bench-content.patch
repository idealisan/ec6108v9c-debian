+++ b/drivers/media/platform/hisilicon/histb-vdec/histb_vdec_v5_probe.c
@@ -0,0 +1,659 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Bring-up probe for the HiSilicon HiSTB V5R6 decoder.
+ *
+ * Feeds the core one synthetic access unit whose luma carries one label per
+ * macroblock row, then hands the reconstructed buffer back through debugfs.
+ * That measures the band pitch, the chroma placement and the address encoding
+ * the vendor documentation does not settle, without a guessed geometry being
+ * baked into the driver first. Not part of the driver's contract.
+ */
+#include <linux/debugfs.h>
+#include <linux/delay.h>
+#include <linux/dma-mapping.h>
+#include <linux/moduleparam.h>
+#include <linux/pm_runtime.h>
+#include <linux/crc32.h>
+#include <linux/slab.h>
+
+#include "histb_vdec_v5.h"
+#include "histb_vdec_v5_probe_data.h"
+
+#define V5R6_PROBE_REF_LISTS		16
+#define V5R6_PROBE_QMATRIX_WORD		0x10101010	/* the spec default of 16 */
+/* The frame the stimulus describes comes along with it. */
+#define V5R6_PROBE_WIDTH		HISTB_VDEC_V5_PROBE_WIDTH
+#define V5R6_PROBE_HEIGHT		HISTB_VDEC_V5_PROBE_HEIGHT
+#define V5R6_PROBE_MBS			HISTB_VDEC_V5_PROBE_MBS
+
+/*
+ * What the core is told about the frame: the band pitch the vendor's own
+ * arrangement derives from the width, and where chroma starts. Both stay
+ * settable because this probe is what measures them.
+ */
+static unsigned int pitch = V5R6_BAND_PITCH(V5R6_PROBE_WIDTH);
+module_param(pitch, uint, 0644);
+MODULE_PARM_DESC(pitch, "luma band pitch in bytes, ALIGN256(ALIGN16(width))");
+
+/*
+ * The two config words, overridable so that one boot can put several engine
+ * shapes next to each other. The defaults are the words this generation's
+ * H.264 channel uses for a new picture.
+ */
+static unsigned int cfg0 = ((V5R6_PROBE_MBS - 1) & V5R6_CFG0_MBAMT) |
+			   V5R6_CFG0_COEFIDX_DETECT | V5R6_CFG0_LD_QMATRIX;
+module_param(cfg0, uint, 0644);
+MODULE_PARM_DESC(cfg0, "V5R6_CFG0 as the protocol builds it");
+
+static unsigned int cfg1 = (3 << 16) | V5R6_CFG1_MV_OUT | V5R6_CFG1_FST_SLC_GRP;
+module_param(cfg1, uint, 0644);
+MODULE_PARM_DESC(cfg1, "V5R6_CFG1 as the protocol builds it");
+
+/*
+ * Where the slice data starts, as a bit index in the stream buffer. Zero keeps
+ * the measured position, which is the point the probe is making: whether the
+ * engine's output moves at all when the segment moves.
+ */
+static unsigned int seg_bit;
+module_param(seg_bit, uint, 0644);
+MODULE_PARM_DESC(seg_bit, "0 uses the measured slice data bit, else overrides it");
+
+/* 0 keeps the measured bit count; anything else declares that many bits. */
+static unsigned int seg_len;
+module_param(seg_len, uint, 0644);
+MODULE_PARM_DESC(seg_len, "0 uses the measured slice length, else overrides it");
+
+/*
+ * The absolute slice qp handed to the engine in slice word 6. The default is
+ * the value the stimulus itself codes, read out of its parameter sets;
+ * overriding it moves only what the engine is told, which is the arm.
+ */
+static unsigned int slice_qp = HISTB_VDEC_V5_PROBE_SLICE_QP;
+module_param(slice_qp, uint, 0644);
+MODULE_PARM_DESC(slice_qp, "SliceQPy for the probe's single slice");
+
+/*
+ * The unit of the addresses: on the older engine the registers and the message
+ * words share one rule, so here both are set apart. 4 is 16-byte granules, 0 is
+ * byte addresses.
+ */
+static unsigned int reg_shift = V5R6_ADDR_SHIFT;
+module_param(reg_shift, uint, 0644);
+MODULE_PARM_DESC(reg_shift, "right shift for the four address registers");
+
+static unsigned int msg_shift = V5R6_ADDR_SHIFT;
+module_param(msg_shift, uint, 0644);
+MODULE_PARM_DESC(msg_shift, "right shift for the address words of the messages");
+
+/*
+ * What the segment descriptor's first word holds. The older generation gives it
+ * relative to the stream register; the arm here can instead give it as the
+ * absolute granule address of the slice data, with the stream register back at
+ * the head of the buffer, which is what the two build for a picture that is
+ * decoded in more than one fragment.
+ */
+static bool abs_d0;
+module_param(abs_d0, bool, 0644);
+MODULE_PARM_DESC(abs_d0, "1 = D0 is the absolute granule address of the slice");
+
+/*
+ * A literal value for the segment descriptor's first word, which is how the
+ * engine's own unit and base for that word get measured instead of assumed.
+ * The reserved value leaves the descriptor as the model above builds it.
+ */
+static unsigned int d0_override = U32_MAX;
+module_param(d0_override, uint, 0644);
+MODULE_PARM_DESC(d0_override, "literal D0, or 0xffffffff to keep the computed one");
+
+/* The stage watchdog value for all eight stages; 0 leaves them at reset. */
+static unsigned int to_val = V5R6_TIMEOUT_DEFAULT;
+module_param(to_val, uint, 0644);
+MODULE_PARM_DESC(to_val, "value for the eight stage watchdog registers");
+
+static unsigned int uv_offset = V5R6_BAND_PITCH(V5R6_PROBE_WIDTH) *
+			      ALIGN(V5R6_PROBE_HEIGHT, 32);
+module_param(uv_offset, uint, 0644);
+MODULE_PARM_DESC(uv_offset, "chroma start from the luma base");
+
+struct histb_vdec_v5_probe {
+	struct histb_vdec_v5	*dec;
+	void			*stream_va;
+	dma_addr_t		stream_dma;
+	size_t			stream_size;
+	unsigned int		stream_len;
+	unsigned int		gran_off;	/* stream offset of the slice granule */
+	void			*recon_va;
+	dma_addr_t		recon_dma;
+	size_t			recon_size;
+	u32			pic[V5R6_SLOT_WORDS];
+	u32			slice[V5R6_SLOT_WORDS];
+};
+
+/*
+ * Segment descriptor of the slice: the granule start as an index of 16-byte
+ * granules inside the stream buffer, the bit offset inside that granule, and
+ * the valid bit count with the rbsp trailing bits taken off. Same arithmetic
+ * the older generation was measured with: one bit of padding left inside an
+ * interior segment makes the core report surplus bits.
+ */
+static void histb_vdec_v5_probe_segment(struct histb_vdec_v5_probe *probe, u32 *w,
+				      unsigned int data_bit,
+				      unsigned int last_byte)
+{
+	const u8 *buf = probe->stream_va;
+	unsigned int end_bit = last_byte * 8;
+	unsigned int byte = last_byte;
+	unsigned int trail = 0;
+
+	/*
+	 * rbsp_trailing_bits is the stop bit followed by zeros up to the byte
+	 * boundary, so the padding and the stop bit together are the position of
+	 * the last set bit counted from the low end. The declared length has to
+	 * be exact: on this engine even one surplus bit brings the error flag
+	 * back, and the surplus is then decoded as syntax.
+	 */
+	while (byte-- > 0) {
+		u8 value = buf[byte];
+
+		if (!value) {
+			trail += 8;
+			continue;
+		}
+		trail += ffs(value);
+		break;
+	}
+	if (trail < end_bit - data_bit)
+		end_bit -= trail;
+
+	if (abs_d0)
+		w[0] = ((probe->stream_dma + ((data_bit / 8) & ~15U)) >> 4) >>
+		       msg_shift;
+	else
+		w[0] = (((data_bit / 8) & ~15U) - probe->gran_off) >> msg_shift;
+	if (d0_override != U32_MAX)
+		w[0] = d0_override;
+	w[1] = data_bit & 127U;
+	w[2] = seg_len ?: end_bit - data_bit;
+}
+
+static void histb_vdec_v5_probe_pack(struct histb_vdec_v5_probe *probe,
+				   unsigned int slice_byte)
+{
+	struct histb_vdec_v5 *dec = probe->dec;
+	unsigned int data_bit;
+	u32 cqp;
+	u32 *pic = probe->pic;
+	u32 *slice = probe->slice;
+	dma_addr_t recon = probe->recon_dma;
+	unsigned int i;
+
+	memset(pic, 0, sizeof(probe->pic));
+	memset(slice, 0, sizeof(probe->slice));
+
+	/* 4:2:0, frame coding, the stimulus's own entropy mode and transform. */
+	pic[0] = FIELD_PREP(GENMASK(8, 0), V5R6_PROBE_WIDTH / 16 - 1) |
+		 FIELD_PREP(GENMASK(24, 16), V5R6_PROBE_HEIGHT / 16 - 1) |
+		 FIELD_PREP(BIT(25), 1) |
+		 FIELD_PREP(BIT(27), HISTB_VDEC_V5_PROBE_CABAC) |
+		 FIELD_PREP(BIT(28), HISTB_VDEC_V5_PROBE_TRANSFORM_8X8) |
+		 (HISTB_VDEC_V5_PROBE_REF_IDC ? BIT(31) : 0);
+	pic[1] = histb_vdec_v5_addr_at(recon, msg_shift);
+
+	/*
+	 * Each table gets the offset the vendor's own pool gives it, so a write into
+	 * one cannot land inside another. The frame's motion-history slot is the
+	 * only one picked here, from the pool's tail, because the pool keys it per
+	 * surface rather than per engine.
+	 */
+	pic[5] = histb_vdec_v5_addr_at(dec->pool.dma + V5R6_TBL_SED_TOP,
+				     msg_shift);
+	pic[6] = histb_vdec_v5_addr_at(dec->pool.dma + V5R6_TBL_PMV_TOP,
+				     msg_shift);
+	pic[7] = histb_vdec_v5_addr_at(dec->pool.dma + V5R6_TBL_PMV_FRAME,
+				     msg_shift);
+	pic[8] = histb_vdec_v5_addr_at(dec->pool.dma + V5R6_TBL_RCNT_TOP,
+				     msg_shift);
+
+	/* The first slice message of the chain. */
+	pic[9] = histb_vdec_v5_addr_at(histb_vdec_v5_slot_dma(dec,
+					    V5R6_SLOT_SLICE), msg_shift);
+
+	/* An IDR frame has no references; point every slot at this picture. */
+	for (i = 0; i < V5R6_PROBE_REF_LISTS; i++)
+		pic[10 + i] = histb_vdec_v5_addr_at(recon, msg_shift);
+
+	pic[26] = histb_vdec_v5_addr_at(dec->pool.dma + V5R6_POOL_CABAC_MN_H264,
+				     msg_shift);
+	pic[59] = histb_vdec_v5_addr_at(dec->pool.dma + V5R6_TBL_DBLK_TOP,
+				     msg_shift);
+
+	/* Six 4x4 lists and two 8x8 lists, four coefficients per word. */
+	for (i = 0; i < 56; i++)
+		pic[64 + i] = V5R6_PROBE_QMATRIX_WORD;
+
+	/*
+	 * The engine never reads a slice header, so the segment starts behind
+	 * its header bits, and the stream base is programmed to the granule that
+	 * holds that bit rather than to the head of the access unit.
+	 */
+	data_bit = seg_bit ? seg_bit :
+			   slice_byte * 8 + 8 +
+			   HISTB_VDEC_V5_PROBE_SLICE_HEADER_BITS;
+	probe->gran_off = (data_bit / 8) & ~15U;
+	/* The unit of D0 follows the message words, its base the registers. */
+	histb_vdec_v5_probe_segment(probe, slice, data_bit, probe->stream_len);
+	/* An I slice: type code 0 and no reference lists, so only the macroblock
+	 * level flag of the stimulus is left to state.
+	 */
+	slice[7] = HISTB_VDEC_V5_PROBE_DIRECT_8X8 ? BIT(14) : 0;
+	/*
+	 * Word 6 carries the absolute slice qp and word 10 the chroma qp offsets.
+	 * A negative offset is stored as the five-bit two's complement of itself,
+	 * and with no second offset in the picture parameter set the first stands
+	 * for both.
+	 */
+	slice[6] = FIELD_PREP(GENMASK(31, 26), slice_qp);
+	cqp = HISTB_VDEC_V5_PROBE_CHROMA_QP & GENMASK(4, 0);
+	slice[10] = FIELD_PREP(GENMASK(9, 5), cqp) | FIELD_PREP(GENMASK(4, 0), cqp);
+	/* The slice's own deblocking idc with, unless idc 1 forbids them, the two
+	 * overrides the stimulus carries.
+	 */
+	slice[11] = FIELD_PREP(GENMASK(1, 0), HISTB_VDEC_V5_PROBE_DEBLOCK_IDC);
+	if (HISTB_VDEC_V5_PROBE_DEBLOCK_IDC != 1) {
+		slice[11] |= FIELD_PREP(GENMASK(11, 8),
+				      HISTB_VDEC_V5_PROBE_BETA & 0xf) |
+				   FIELD_PREP(GENMASK(19, 16),
+				      HISTB_VDEC_V5_PROBE_ALPHA & 0xf);
+	}
+	/* The last slice of the frame declares the whole macroblock row run. */
+	slice[44] = V5R6_PROBE_MBS - 1;
+	/* A single slice, so the chain ends here. */
+	slice[63] = 0;
+}
+
+/*
+ * Where the frame landed. The first offset and the occurrence count of each
+ * label give the band pitch, the chroma start and the interleaving without
+ * pulling the whole buffer off the board.
+ */
+static void histb_vdec_v5_probe_report(struct histb_vdec_v5_probe *probe)
+{
+	struct histb_vdec_v5 *dec = probe->dec;
+	const u8 *buf = probe->recon_va;
+	size_t size = probe->recon_size;
+	unsigned int first, count, i, j, untouched = 0;
+	char line[160];
+	int n;
+
+	for (i = 0; i < ARRAY_SIZE(histb_vdec_v5_probe_labels); i += 5) {
+		n = 0;
+		for (j = 0; j < 5 && i + j < ARRAY_SIZE(histb_vdec_v5_probe_labels); j++) {
+			unsigned int v = histb_vdec_v5_probe_labels[i + j];
+
+			first = size;
+			count = 0;
+			for (size_t off = 0; off < size; off++) {
+				if (buf[off] != v)
+					continue;
+				if (first == size)
+					first = off;
+				count++;
+			}
+			n += scnprintf(line + n, sizeof(line) - n, " %u:%u@%u",
+					 v, count, first == size ? 0xffffffffU : first);
+		}
+		dev_info(dec->dev, "labels:%s\n", line);
+	}
+
+	for (i = 0; i < size; i++)
+		untouched += buf[i] == 0xa4;
+	dev_info(dec->dev, "buffer %zu B, %u untouched\n", size, untouched);
+}
+
+static ssize_t histb_vdec_v5_probe_read_frame(struct file *f, char __user *u,
+					    size_t n, loff_t *off)
+{
+	struct histb_vdec_v5_probe *probe = f->private_data;
+	size_t left = probe->recon_size > *off ? probe->recon_size - *off : 0;
+
+	if (!left)
+		return 0;
+	if (n > left)
+		n = left;
+	if (copy_to_user(u, probe->recon_va + *off, n))
+		return -EFAULT;
+	*off += n;
+
+	return n;
+}
+
+static const struct file_operations histb_vdec_v5_probe_frame_fops = {
+	.owner = THIS_MODULE,
+	.open = simple_open,
+	.read = histb_vdec_v5_probe_read_frame,
+};
+
+static ssize_t histb_vdec_v5_probe_show_status(struct file *f, char __user *u,
+					     size_t n, loff_t *off)
+{
+	struct histb_vdec_v5_probe *probe = f->private_data;
+	struct histb_vdec_v5 *dec = probe->dec;
+	char buf[512];
+	u32 *report = histb_vdec_v5_slot(dec, V5R6_SLOT_UP);
+	u32 d0 = report[0];
+	const u32 *sl = probe->slice;
+	const u32 *pc = probe->pic;
+
+	return simple_read_from_buffer(u, n, off, buf,
+		snprintf(buf, sizeof(buf),
