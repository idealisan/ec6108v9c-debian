--- /dev/null
+++ b/arch/arm/mach-hisi/cv200-pmudump.c
@@ -0,0 +1,417 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Bench instrument for the Hi3716CV200 CPU performance monitor.
+ *
+ * perf_event_open(2) says the armv7 PMU exists (7 counters announced) and the
+ * pmu node now has its interrupt wired, yet the cycle and instruction counters
+ * both read 0 across a busy loop and the arm-pmu interrupt count never moves.
+ * That combination is not visible from EL0 at all, so this dumps the CP15 side
+ * of it from EL1: whether the global enable and the per-counter enable and
+ * interrupt-enable bits are actually set in the hardware, whether PMCCNTR ticks
+ * in kernel context, and what the implementation-defined control registers (A9
+ * auxiliary control, secure debug enable, coprocessor access) say.
+ *
+ * The encodings are the ones drivers/perf/arm_v7_pmu.c uses: PMCR c9,c12,0,
+ * PMCNTENSET c9,c12,1, PMOVSR c9,c12,3, PMSELR c9,c12,5, PMCCNTR c9,c13,0,
+ * PMXEVTYPER c9,c13,1, PMINTENSET c9,c14,1.
+ *
+ * Not a driver: debugfs only, no binding, deleted before any submission.
+ * Reading /sys/kernel/debug/cv200_pmu dumps every online CPU; writing "1"
+ * enables the manual arm on subsequent reads, writing "0" turns it off, and
+ * writing any other hexadecimal value ORs it into the auxiliary control
+ * register of every CPU.
+ */
+#include <linux/debugfs.h>
+#include <linux/init.h>
+#include <linux/io.h>
+#include <linux/seq_file.h>
+#include <linux/smp.h>
+#include <linux/types.h>
+
+/*
+ * The distributor's view of the INTID the pmu node names, per CPU. INTID 16..31
+ * (the private range) is banked per core in this GIC, so the words have to be
+ * read from the core they describe -- which is what pmu_take_sample is: it runs
+ * as an IPI-served function on every online CPU. This is what separates "the
+ * PMI is asserted and never taken" from "nobody enabled INTID 22 here".
+ * ICC_IAR is deliberately not read: reading it acknowledges an interrupt.
+ */
+#define GICD_ISENABLER0		0x100
+#define GICD_ICENABLER0		0x180
+#define GICD_ISPENDR0		0x200
+#define GICD_ISACTIVER0		0x300
+#define GICD_INTID22		BIT(22)
+#define ICC_PMR			0x04
+#define ICC_BPR			0x08
+
+static void __iomem *gicd;
+static void __iomem *gicc;
+
+struct pmu_sample {
+	unsigned int	cpu;
+	unsigned int	pmcr;
+	unsigned int	ens;	/* PMCNTENSET  */
+	unsigned int	intens;	/* PMINTENSET  */
+	unsigned int	ovf;	/* PMOVSR      */
+	unsigned int	cc0;	/* PMCCNTR before the loop */
+	unsigned int	cc1;	/* PMCCNTR after  the loop */
+	unsigned int	evt;	/* PMXEVTYPER after selecting counter 0 */
+	unsigned int	actlr;	/* c1,c0,1: A9 auxiliary control */
+	unsigned int	sder;	/* c1,c1,1: secure debug enable  */
+	unsigned int	cpacr;	/* c1,c0,2: coprocessor access   */
+	unsigned int	man_pmcr;	/* PMCR right after the manual arm */
+	unsigned int	man_ens;	/* PMCNTENSET after the manual arm  */
+	unsigned int	man_cc0;	/* PMCCNTR before the manual loop   */
+	unsigned int	man_cc1;	/* PMCCNTR after  the manual loop   */
+	unsigned int	gd_en;		/* GICD_ISENABLER0   */
+	unsigned int	gd_pend;	/* GICD_ISPENDR0     */
+	unsigned int	gd_act;		/* GICD_ISACTIVER0   */
+	unsigned int	ic_pmr;		/* ICC_PMR           */
+	unsigned int	ic_bpr;		/* ICC_BPR           */
+	unsigned int	en22;		/* INTID 22 written then read back */
+};
+
+static DEFINE_PER_CPU(struct pmu_sample, pmu_sample);
+
+/* set by writing 1 to the file: run the manual arm on each read */
+static bool manual;
+
+/* set by writing 2: enable INTID 22 and read the bit back on every CPU;
+ * writing 3 clears it again.
+ */
+static bool int22;
+
+static unsigned int rd_pmcr(void)
+{
+	unsigned int v;
+
+	asm volatile("mrc p15, 0, %0, c9, c12, 0" : "=r"(v));
+
+	return v;
+}
+
+static unsigned int rd_ens(void)
+{
+	unsigned int v;
+
+	asm volatile("mrc p15, 0, %0, c9, c12, 1" : "=r"(v));
+
+	return v;
+}
+
+static unsigned int rd_ovf(void)
+{
+	unsigned int v;
+
+	asm volatile("mrc p15, 0, %0, c9, c12, 3" : "=r"(v));
+
+	return v;
+}
+
+static unsigned int rd_cc(void)
+{
+	unsigned int v;
+
+	asm volatile("mrc p15, 0, %0, c9, c13, 0" : "=r"(v));
+
+	return v;
+}
+
+static unsigned int rd_evt0(void)
+{
+	unsigned int zero = 0, v;
+
+	asm volatile("mcr p15, 0, %0, c9, c12, 5" : : "r"(zero));
+	asm volatile("isb");
+	asm volatile("mrc p15, 0, %0, c9, c13, 1" : "=r"(v));
+
+	return v;
+}
+
+static unsigned int rd_intens(void)
+{
+	unsigned int v;
+
+	asm volatile("mrc p15, 0, %0, c9, c14, 1" : "=r"(v));
+
+	return v;
+}
+
+static unsigned int rd_actlr(void)
+{
+	unsigned int v;
+
+	asm volatile("mrc p15, 0, %0, c1, c0, 1" : "=r"(v));
+
+	return v;
+}
+
+static unsigned int rd_sder(void)
+{
+	unsigned int v;
+
+	asm volatile("mrc p15, 0, %0, c1, c1, 1" : "=r"(v));
+
+	return v;
+}
+
+static unsigned int rd_cpacr(void)
+{
+	unsigned int v;
+
+	asm volatile("mrc p15, 0, %0, c1, c0, 2" : "=r"(v));
+
+	return v;
+}
+
+static void wr_pmcr(unsigned int v)
+{
+	asm volatile("mcr p15, 0, %0, c9, c12, 0" : : "r"(v));
+	asm volatile("isb");
+}
+
+static void wr_cc(unsigned int v)
+{
+	asm volatile("mcr p15, 0, %0, c9, c13, 0" : : "r"(v));
+	asm volatile("isb");
+}
+
+static void wr_ens(unsigned int v)
+{
+	asm volatile("mcr p15, 0, %0, c9, c12, 1" : : "r"(v));
+	asm volatile("isb");
+}
+
+/* PMCNTENSET is write-1-to-enable; writing 0 there does nothing, so clearing
+ * needs the separate PMCNTENCLR (c9,c12,2). */
+static void wr_clr(unsigned int v)
+{
+	asm volatile("mcr p15, 0, %0, c9, c12, 2" : : "r"(v));
+	asm volatile("isb");
+}
+
+/*
+ * Manual arm: take the PMU out of reset by hand -- global enable with the
+ * by-64 prescaler off, PMCCNTR zeroed, the cycle counter's own enable bit set
+ * -- then measure it across a loop. This is the one measurement that separates
+ * "the PMU cannot count on this part" from "the perf driver's enable does not
+ * reach the hardware", and it is deliberately not the driver's code path.
+ */
+static void pmu_measure_manual(struct pmu_sample *s)
+{
+	unsigned int i;
+	unsigned int pmcr;
+
+	wr_cc(0);
+	pmcr = rd_pmcr() & ~(BIT(3) | BIT(5));		/* clear D and DP */
+	wr_pmcr(pmcr | BIT(0));				/* E=1 */
+	s->man_pmcr = rd_pmcr();
+
+	wr_ens(BIT(31));				/* PMCNTENSET.CC */
+	s->man_ens = rd_ens();
+	s->man_cc0 = rd_cc();
+
+	preempt_disable();
+	for (i = 0; i < 2000000; i++)
+		asm volatile("" ::: "memory");
+	s->man_cc1 = rd_cc();
+	preempt_enable();
+
+	/* leave the PMU as the driver expects to find it: everything off */
+	wr_clr(BIT(31));
+	wr_pmcr(rd_pmcr() & ~BIT(0));
+}
+
+static void pmu_take_sample(void *info)
+{
+	struct pmu_sample *s = this_cpu_ptr(&pmu_sample);
+	unsigned int i;
+
+	s->cpu = smp_processor_id();
+	s->pmcr = rd_pmcr();
+	s->ens = rd_ens();
+	s->intens = rd_intens();
+	s->ovf = rd_ovf();
+	s->evt = rd_evt0();
+	s->cc0 = rd_cc();
+
+	/*
+	 * Preemption off, not interrupts: this runs as an IPI-served function
+	 * (on_each_cpu with wait=1), and flipping the interrupt state there is
+	 * what made tick/irq_work BUG -- twice, at 115 s and at 21 s, both
+	 * blamed on the board before they were traced here. 2M iterations is a
+	 * few milliseconds on an A9, so the loop stays on this CPU anyway.
+	 */
+	preempt_disable();
+	for (i = 0; i < 2000000; i++)
+		asm volatile("" ::: "memory");
+	s->cc1 = rd_cc();
+	preempt_enable();
+
+	s->actlr = rd_actlr();
+	s->sder = rd_sder();
+	s->cpacr = rd_cpacr();
+
+	if (gicd) {
+		s->gd_en = readl_relaxed(gicd + GICD_ISENABLER0);
+		s->gd_pend = readl_relaxed(gicd + GICD_ISPENDR0);
+		s->gd_act = readl_relaxed(gicd + GICD_ISACTIVER0);
+		/*
+		 * The one question the read-only dumps cannot answer is whether
+		 * the enable bit itself is writable: "reads 0" is also the shape
+		 * of a RAZ/WI bit, and an unimplemented PPI input looks the same
+		 * from here as a driver that never enabled it. Writing and reading
+		 * back separates them.
+		 */
+		if (int22) {
+			writel_relaxed(GICD_INTID22, gicd + GICD_ISENABLER0);
+			s->en22 = readl_relaxed(gicd + GICD_ISENABLER0) & GICD_INTID22;
+		}
+	}
+	if (gicc) {
+		s->ic_pmr = readl_relaxed(gicc + ICC_PMR);
+		s->ic_bpr = readl_relaxed(gicc + ICC_BPR);
+	}
+
+	if (manual)
+		pmu_measure_manual(s);
+}
+
+static int pmu_show(struct seq_file *f, void *p)
+{
+	int cpu;
+
+	on_each_cpu(pmu_take_sample, NULL, 1);
+
+	for_each_online_cpu(cpu) {
+		struct pmu_sample *s = per_cpu_ptr(&pmu_sample, cpu);
+
+		seq_printf(f, "cpu%-2u PMCR=%08x (E=%u P=%u C=%u D=%u X=%u DP=%u N=%u) "
+			   "PMOVSR=%08x\n",
+			   s->cpu, s->pmcr, (s->pmcr >> 0) & 1,
+			   (s->pmcr >> 1) & 1, (s->pmcr >> 2) & 1,
+			   (s->pmcr >> 3) & 1, (s->pmcr >> 4) & 1,
+			   (s->pmcr >> 5) & 1,
+			   (s->pmcr >> 11) & 0x1f, s->ovf);
+		seq_printf(f, "cpu%-2u PMCCNTR=%08x -> %08x  delta=%u\n",
+			   s->cpu, s->cc0, s->cc1,
+			   (unsigned int)(s->cc1 - s->cc0));
+		seq_printf(f, "cpu%-2u PMCNTENSET=%08x PMINTENSET=%08x PMXEVTYPER0=%08x\n",
+			   s->cpu, s->ens, s->intens, s->evt);
+		seq_printf(f, "cpu%-2u ACTLR=%08x SDER=%08x CPACR=%08x\n",
+			   s->cpu, s->actlr, s->sder, s->cpacr);
+		seq_printf(f, "cpu%-2u GICD en=%08x pend=%08x act=%08x  INTID22 en=%u pend=%u "
+			   "act=%u set-then-read=%u  ICC pmr=%08x bpr=%08x\n",
+			   s->cpu, s->gd_en, s->gd_pend, s->gd_act,
+			   !!(s->gd_en & GICD_INTID22),
+			   !!(s->gd_pend & GICD_INTID22),
+			   !!(s->gd_act & GICD_INTID22),
+			   !!(s->en22 & GICD_INTID22),
+			   s->ic_pmr, s->ic_bpr);
+		if (manual)
+			seq_printf(f, "cpu%-2u manual: PMCR=%08x (E=%u D=%u) PMCNTENSET=%08x "
+				   "PMCCNTR=%08x -> %08x delta=%u\n",
+				   s->cpu, s->man_pmcr, (s->man_pmcr >> 0) & 1,
+				   (s->man_pmcr >> 3) & 1, s->man_ens,
+				   s->man_cc0, s->man_cc1,
+				   (unsigned int)(s->man_cc1 - s->man_cc0));
+	}
+
+	return 0;
+}
+
+static int pmu_open(struct inode *inode, struct file *file)
+{
+	return single_open(file, pmu_show, NULL);
+}
+
+/*
+ * OR a mask into the A9 auxiliary control register on every online CPU.
+ * Deliberately only ORs: the bits this round is about are enable bits, and a
+ * mask that clears one could take the machine down.
+ */
+static void pmu_set_actlr(void *info)
+{
+	unsigned int val = rd_actlr() | *(unsigned int *)info;
+
+	asm volatile("mcr p15, 0, %0, c1, c0, 1" : : "r"(val));
+	asm volatile("isb");
+}
+
+static void pmu_set_int22(void *info)
+{
+	bool on = *(bool *)info;
+
+	if (!gicd)
+		return;
+	writel_relaxed(GICD_INTID22,
+		       gicd + (on ? GICD_ISENABLER0 : GICD_ICENABLER0));
+}
+
+static ssize_t pmu_write(struct file *file, const char __user *buf,
+			 size_t count, loff_t *off)
+{
+	char kbuf[16];
+	unsigned int mask;
+	int ret;
+
+	if (count >= sizeof(kbuf))
+		return -EINVAL;
+	if (copy_from_user(kbuf, buf, count))
+		return -EFAULT;
+
+	kbuf[count] = '\0';
+	ret = kstrtouint(strim(kbuf), 16, &mask);
+	if (ret)
+		return ret;
+
+	/* 1 turns the manual arm on, 0 turns it off; 2 enables INTID 22 on every
+	 * CPU and reads the bit back in each dump, 3 clears it again; anything
+	 * else is an ACTLR mask to OR in on every CPU.
+	 */
+	if (mask <= 1) {
+		manual = mask;
+
+		return count;
+	}
+	if (mask == 2 || mask == 3) {
+		bool on = mask == 2;
+
+		int22 = on;
+		on_each_cpu(pmu_set_int22, &on, 1);
+
+		return count;
+	}
+
+	on_each_cpu(pmu_set_actlr, &mask, 1);
+
+	return count;
+}
+
+static const struct file_operations pmu_fops = {
+	.owner		= THIS_MODULE,
+	.open		= pmu_open,
+	.read		= seq_read,
+	.llseek		= seq_lseek,
+	.release	= single_release,
+	.write		= pmu_write,
+};
+
+static int __init cv200_pmudump_init(void)
+{
+	/*
+	 * Second mapping of the two GIC banks (the gic driver owns the first).
+	 * Read-only here, and the addresses are this board's DT ones.
+	 */
+	gicd = ioremap(0xf8a01000, 0x1000);
+	gicc = ioremap(0xf8a00100, 0x100);
+	if (!gicd || !gicc)
+		pr_warn("bench: cv200 PMU dump has no GIC view, INTID 22 cannot be read\n");
+
+	debugfs_create_file("cv200_pmu", 0600, NULL, NULL, &pmu_fops);
+
+	pr_info("bench: cv200 PMU dump at /sys/kernel/debug/cv200_pmu\n");
+
+	return 0;
+}
+late_initcall(cv200_pmudump_init);
--- /dev/null
+++ b/arch/arm64/boot/dts/hisilicon/hi3798mv200h-skyworth-stb-psci.dts
@@ -0,0 +1,91 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * PSCI-chain variant of the Skyworth Hi3798MV200H board description.
+ *
+ * This build is started by upstream TF-A BL31 (plat/hisilicon/hi3798mv200h,
+ * RESET_TO_BL31, entered at EL2 by the ARM32 stage1), not by the spin-table
+ * trampoline and not by the vendor fastboot's `bootm`.  It differs from the
+ * shipping board file in the firmware-interface bits only:
+ *
+ *   - the dtsi's psci node (arm,psci-1.0, method smc) stays and the cpus keep
+ *     enable-method = "psci": SMP comes through PSCI CPU_ON and reboot through
+ *     PSCI SYSTEM_RESET.  &wdg0 is left in the shape the board file gives it --
+ *     BL31's system_reset counts on the wdg0 clock gate being open, and the
+ *     sp805 driver's own behaviour on this part is a thing to measure, not to
+ *     work around.
+ *   - BL31 is resident for the whole kernel run (every PSCI call lands in it),
+ *     and its .data/.bss/stacks live in ordinary RAM the kernel would hand out
+ *     as page frames, so that window gets a no-map reservation: 0x02001000 for
+ *     0x14000 (image base == reset vector, plus the witness block the chain
+ *     reads back after a reset).
+ *   - bootargs cannot come from the fastboot env on this path, so /chosen
+ *     carries them.  panic=15 stays until PSCI SYSTEM_RESET is proven on this
+ *     chain; the bringup-era knobs (idle=poll, nohz=off, cpuidle.off) are gone
+ *     because the tick is now delivered and because they mask cpufreq/cpuidle,
+ *     which this board file is supposed to describe honestly.
+ *   - the console clock is the shipping one (&sysctrl HI3798MV200_UART0_CLK),
+ *     not the fixed 75 MHz arm used while the tick was still missing: if the
+ *     console is illegible with the real clock, that is a finding, not
+ *     something to paper over here.
+ *
+ * Bench toggles (e.g. disabling the watchdog for a long interactive round) are
+ * applied to the compiled dtb with fdtput at staging time, so one source serves
+ * both profiles.
+ */
+
+#include "hi3798mv200h-skyworth-stb.dts"
+
+/ {
+	chosen {
+		stdout-path = "serial0:115200n8";
+		bootargs = "keep_bootcon loglevel=4 earlycon=pl011,0xf8b00000 console=ttyAMA0,115200 nokaslr panic=15 clk_ignore_unused video=HDMI-A-1:1280x720@60e";
+	};
+
+	reserved-memory {
+		/* TF-A BL31, resident at EL3: PSCI entry, context, stacks. */
+		bl31: bl31@2001000 {
+			reg = <0x0 0x02001000 0x0 0x00014000>;
+			no-map;
+		};
+
+		/*
+		 * A low, reusable pool for the display surfaces: the OEM keeps its
+		 * graphics fetch address at 0x00d25d00 while this board's framebuffer
+		 * otherwise lands in the default CMA at the top of the 1 GiB.
+		 * "reusable" is what makes this a CMA area -- without it the region is
+		 * set up as a dma pool and binding it to the device fails with -EINVAL,
+		 * which takes the whole display probe down.
+		 */
+		display_pool: display-pool@1000000 {
+			compatible = "shared-dma-pool";
+			reusable;
+			reg = <0x0 0x01000000 0x0 0x01000000>;
+		};
+	};
+};
+
+/*
+ * Display line on this board: the VDP v4 engine and the HDMI transmitter
+ * downstream of it, both board-tested for scan-out but not for the hot-plug
+ * interrupt, so this stays a board-file decision rather than a default.
+ */
+&vdp {
+	status = "okay";
+};
+
+&hdmi {
+	status = "okay";
+};
+
+/*
+ * The playback link has to move to the transmitter in the same build that
+ * enables it: sound-dai on the dummy SPDIF codec never runs the transmitter's
+ * audio setup, so the samples reach AIAO but the HDMI stream stays unconfigured.
+ */
+&sound {
+	playback {
+		codec {
+			sound-dai = <&hdmi>;
+		};
+	};
+};
--- /dev/null
+++ b/arch/arm64/boot/dts/hisilicon/hi3798mv200h-skyworth-stb-tramp-nowdt.dts
@@ -0,0 +1,27 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * DTS for the risky-experiment boot of the Skyworth Hi3798MV200H.
+ *
+ * Same as the trampoline variant except that the kernel never claims the SP805,
+ * so nothing in the kernel can stop the boot-alive timer the stage1 stub armed.
+ *
+ * Why: on 2026-10-21 a NULL dereference inside lima's probe panicked
+ * at 1.002 s, machine_restart printed "Reboot failed -- System halted" and the
+ * box is still sitting there, reachable only by pulling power.  Which of the
+ * two rescue paths was missing in that window is not settled yet (sp805_wdt's
+ * initcall level and the state the stub left the counter in are both still open
+ * questions), so this file removes the kernel from the picture entirely: with
+ * status = "disabled" sp805_wdt never probes, never sets WDOG_HW_RUNNING, and
+ * only the stub's timer can reset the box.
+ *
+ * This file is [LOCAL]: it deliberately has no working software watchdog, so it
+ * is only for boots whose code may fault, never for a verification round.
+ */
+
+/dts-v1/;
+
+#include "hi3798mv200h-skyworth-stb-tramp.dts"
+
+&wdg0 {
+	status = "disabled";
+};
--- /dev/null
+++ b/arch/arm64/boot/dts/hisilicon/hi3798mv200h-skyworth-stb-tramp.dts
@@ -0,0 +1,141 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Trampoline variant of the Skyworth Hi3798MV200H board description.
+ *
+ * This build is started by the ARM32 -> AArch64 stub, not by the vendor
+ * fastboot's bootm, so four things differ from the normal board file:
+ *
+ *   - there is no PSCI firmware under the stub, so every SMC the kernel would
+ *     issue (probing PSCI, bringing up CPUs 1..3) traps instead of working.
+ *     The psci node is deleted and the cpus use spin-table instead: the stub
+ *     releases cores 1..3 out of reset with RVBAR pointing at its own poll loop,
+ *     and each cpu-release-addr below is the slot smp_spin_table_cpu_prepare()
+ *     writes __pa_symbol(secondary_holding_pen) into
+ *     (arch/arm64/kernel/smp_spin_table.c:92).  Those four numbers must match
+ *     REL_BASE/REL_STRIDE in the stub's tramp.inc, and verify-tramp.py decompiles
+ *     this dtb to check exactly that.
+ *   - the slots, stub, console lock and per-core stacks live in ordinary RAM the
+ *     kernel would hand out as page frames while three cores are still fetching
+ *     from it, so they get a no-map reserved-memory region.  It is a child of the
+ *     dtsi's existing reserved-memory node because /memreserve/ cannot be used
+ *     here: dtc requires it between /dts-v1/ and the root node, and this file
+ *     #includes a .dts that already contains both.
+ *   - bootargs cannot come from the fastboot env on this path, so they live in
+ *     /chosen.  The initrd properties used to live here too, pointing at the
+ *     archive the loader tftp'd to 0x0c000000; the rootfs is now embedded in the
+ *     Image (CONFIG_INITRAMFS_SOURCE), so there is nothing for those two numbers
+ *     to describe and a stale pair of them made the kernel unpack garbage.
+ *   - no clk_ignore_unused: it was a bringup crutch for a provider that failed to
+ *     probe (2026-10-20 board run: hi3798mv200-crg returned -22 because
+ *     hisi_pll_prepare rejected bpll), which left the PL011 consumer deferred
+ *     while clk_disable_unused() gated the very clock earlycon writes to.  Read
+ *     from the board instead of assumed: in clk_summary every clock in use has
+ *     enable_count >= 1 (clk_uart0 2/2, clk_wdg0 1/1, clk_apb 3/3, clk_ahb 2/2,
+ *     clk_femacif 1/1), and the mux clk_cpu that feeds the running CPU has no
+ *     .is_enabled, so clk_core_is_enabled() falls back to its enable_count and
+ *     treats it as off.  What does get gated are the six with no consumer at all:
+ *     I2C0/1/2, SCI0, SPI0, USB2_OTG_UTMI.
+ */
+
+#include "hi3798mv200h-skyworth-stb.dts"
+
+/ {
+	chosen {
+		/* panic=15: with the SP805's restart handler as the only way back to
+		 * the vendor fastboot, a panic must reach machine_restart on its own.
+		 */
+		/*
+		 * video=HDMI-A-1:1280x720@60e is here because this bench has no
+		 * sink on the HDMI output right now (TX_AON_STATE 0xf8ce4028 reads
+		 * 0, while the vendor fastboot with the capture card wired reads 3),
+		 * and drm_helper_probe_single_connector_modes() jumps to exit for a
+		 * disconnected connector -- before drm_helper_probe_add_cmdline_mode()
+		 * is ever reached.  Three shapes were measured on the board:
+		 *   - "video=1280x720@60" did nothing at all: the option is looked up
+		 *     per connector with video_get_options(connector->name), so a
+		 *     nameless option matches no connector (measured: modes=[],
+		 *     "Cannot find any crtc or sizes" twice).
+		 *   - the connector name is therefore required, and 'e'
+		 *     (DRM_FORCE_ON, drm_modes.c:2036) is what makes
+		 *     drm_probe_helper.c:589 report the connector connected without
+		 *     trusting ->detect.
+		 * 720p60 is exactly the 74.25 MHz the HPLL is already programmed to
+		 * (clk_vo_hd read back on the board).  Bringup-only.
+		 */
+		bootargs = "console=ttyAMA0,115200 loglevel=4 earlycon panic=15 initcall_debug video=HDMI-A-1:1280x720@60e";
+	};
+
+	reserved-memory {
+		tramp_stub: tramp-stub@200c000 {
+			reg = <0x0 0x0200c000 0x0 0x5000>;
+			no-map;
+		};
+		/*
+		 * A low, reusable pool for the display surfaces (see ledger 161): the
+		 * displaying OEM keeps its graphics fetch address at 0x00d25d00 while
+		 * this board took its framebuffer out of the default CMA at 0x3dd00000,
+		 * at the top of the 1 GiB.  "reusable" is what makes this a CMA area --
+		 * without it the region was set up as a dma pool and binding it to the
+		 * device failed with -EINVAL, which took the whole display probe down.
+		 */
+		display_pool: display-pool@1000000 {
+			compatible = "shared-dma-pool";
+			reusable;
+			reg = <0x0 0x01000000 0x0 0x01000000>;
+		};
+		};
+
+
+	cpus {
+		cpu@0 {
+			enable-method = "spin-table";
+			cpu-release-addr = <0x0 0x0200c000>;
+		};
+		cpu@1 {
+			enable-method = "spin-table";
+			cpu-release-addr = <0x0 0x0200c040>;
+		};
+		cpu@2 {
+			enable-method = "spin-table";
+			cpu-release-addr = <0x0 0x0200c080>;
+		};
+		cpu@3 {
+			enable-method = "spin-table";
+			cpu-release-addr = <0x0 0x0200c0c0>;
+		};
+	};
+
+	/delete-node/ psci;
+};
+
+/*
+ * Board test of the display line (2026-10-22): bring up the VDP channel and
+ * the transmitter downstream of it. Not for submission while the transmitter
+ * still has no hot plug interrupt.
+ */
+&vdp {
+	status = "okay";
+};
+
+&hdmi {
+	status = "okay";
+};
+
+/*
+ * The playback link has to move to the transmitter in the same build that
+ * enables it: the board file's &hdmi node is status = "disabled", and ASoC
+ * resolves the codec phandle to a device, so pointing the submitted board file
+ * at &hdmi would leave the card deferred forever.  Keep the reroute in the
+ * bring-up variant, next to the two enables it depends on.
+ */
+&sound {
+	playback {
+		codec {
+			sound-dai = <&hdmi>;
+		};
+	};
+};
+
+&vdp {
+	memory-region = <&display_pool>;
+};
--- /dev/null
+++ b/drivers/gpu/drm/histb/histb-vodump.c
@@ -0,0 +1,421 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+/*
+ * Read-only snapshot of the hi3798mv100 display pipeline as the vendor fastboot
+ * left it while scanning out its boot logo.
+ *
+ * The point of this file is that its snapshot path never writes a device
+ * register: it captures a configuration that is known to put a picture on the
+ * HDMI output, so drivers/gpu/drm/histb can be diffed against it. scr writes a
+ * pattern into the scan-out buffer, which is plain DRAM, and poke/peek exist
+ * for register A/B experiments once the snapshot has been taken -- they are the
+ * only paths that touch device state.
+ *
+ * Run it again at any time with: echo 1 >
+ *   /sys/module/histb_vodump/parameters/dump echo <pattern> >
+ *   /sys/module/histb_vodump/parameters/scr
+ */
+
+#include <linux/bitfield.h>
+#include <linux/init.h>
+#include <linux/io.h>
+#include <linux/kernel.h>
+#include <linux/highmem.h>
+#include <linux/mm.h>
+#include <linux/module.h>
+#include <linux/moduleparam.h>
+#include <linux/sizes.h>
+#include <linux/vmalloc.h>
+
+#include "histb-vdp2-regs.h"
+
+#define VO_BASE		0xf8cc0000
+#define VO_SIZE		0x10000
+#define HDMI_BASE	0xf8ce0000
+#define CRG_BASE	0xf8a22000
+#define CRG_SIZE	0x200
+#define AIAO_BASE	0xf8cd0000
+#define AIAO_SIZE	0x10000
+
+/* Every register the VDP driver touches, plus the state counters. */
+static const u16 vo_offs[] = {
+	VO_CTRL, VO_MUX, VO_INTSTA, G0_CTRL, G0_ADDR, G0_STRIDE, G0_IRESO,
+	G0_CBMPARA, G0_DFPOS, G0_DLPOS, G0_UPD, GP0_CTRL, GP0_IRESO, GP0_ORESO,
+	GP0_UPD, CBM_ATTR, CBM_MIX1, CBM_MIX2, DHD0_CTRL, DHD0_VSYNC,
+	DHD0_HSYNC1, DHD0_HSYNC2, DHD0_VPLUS, DHD0_PWR, DHD0_SYNC_INV,
+	DHD0_DATA_SEL, DHD0_VTTHD, DHD0_STATE, DHD0_DEBUG, DHD0_DEBUG_STATE,
+	HDATE_STATE, GP0_GALPHA, GP0_DFPOS, GP0_DLPOS, GP0_BK, GP0_ALPHA,
+	CBM_BKG1, HDATE_EN, HDATE_POLA_CTRL, HDATE_VIDEO_FORMAT,
+	HDATE_OUT_CTRL, WBC_DHD0_CTRL, WBC_DHD0_YADDR, WBC_DHD0_CADDR,
+	WBC_DHD0_STRIDE, WBC_DHD0_ORESO, WBC_DHD0_UPD,
+};
+
+static const u16 sd_offs[] = {
+	VO_DAC_MUX, VO_MUX_TESTSYNC, VO_MUX_TESTDATA, CBM_BKG2,
+	SD_CTRL, SD_VSYNC, SD_HSYNC1, SD_HSYNC2, SD_VPLUS, SD_PWR,
+	SD_VTTHD3, SD_VTTHD, SD_SYNC_INV, SD_DATA_SEL,
+};
+
+static void __iomem *vo_base, *hdmi_base, *crg_base, *aiao_base;
+
+static void vodump_list(const char *tag, const u16 *offs, int n)
+{
+	static char buf[700];	/* too big for the init-call stack */
+	int i, len = 0;
+
+	for (i = 0; i < n; i++)
+		len += scnprintf(buf + len, sizeof(buf) - len, "%s%04x:%08x",
+				 i ? " " : "", offs[i],
+				 readl(vo_base + offs[i]));
+
+	pr_info("vodump %s %s\n", tag, buf);
+}
+
+static void vodump_scan(const char *tag, void __iomem *base, u32 size)
+{
+	static char buf[96];	/* too big for the init-call stack */
+	u32 off;
+	int len = 0;
+
+	buf[0] = '\0';
+	for (off = 0; off < size; off += 4) {
+		u32 val = readl(base + off);
+
+		if (!val)
+			continue;
+		len += scnprintf(buf + len, sizeof(buf) - len, " %04x:%08x",
+				 off, val);
+		if (len > 64) {
+			pr_info("vodump %s%s\n", tag, buf);
+			buf[0] = '\0';
+			len = 0;
+		}
+	}
+	if (len)
+		pr_info("vodump %s%s\n", tag, buf);
+}
+
+/*
+ * The HDMI TPI file is flattened: bank0 (I2C 0x72) at +0, bank1 (0x7a) at
+ * +0x400, the on-chip PHY at +0x1800. The range in between is not implemented,
+ * so it is stepped over rather than read.
+ */
+static void vodump_hdmi(void)
+{
+	vodump_scan("tx-bank0", hdmi_base, 0x400);
+	vodump_scan("tx-bank1", hdmi_base + 0x400, 0x400);
+	vodump_scan("tx-phy", hdmi_base + 0x1800, 0x400);
+}
+
+static struct {
+	void *kva;
+	u32 phys;
+	u32 stride;	/* bytes per line in memory */
+	u32 width;	/* pixels per line the fetch engine walks */
+	u32 height;
+	u32 rows;	/* lines actually mapped */
+	u32 base;	/* register block this layer was found at */
+} fb;
+
+/*
+ * G0 at 0x6000 is only one of the graphics layers: the boot logo turns out to
+ * be scanned out of the block at 0x6800 while 0x6000 sits disabled, so the
+ * buffer has to be found by looking for whichever block is enabled.
+ */
+static const u32 gfx_bases[] = { 0x6000, 0x6800 };
+
+static u32 fb_addr;
+static u32 fb_stride;
+static u32 fb_width;
+static u32 fb_height;
+
+module_param(fb_addr, uint, 0644);
+MODULE_PARM_DESC(fb_addr, "override: physical address to scribble on (0 = auto-detect the "
+		 "enabled layer)");
+module_param(fb_stride, uint, 0644);
+MODULE_PARM_DESC(fb_stride, "override: bytes per line");
+module_param(fb_width, uint, 0644);
+MODULE_PARM_DESC(fb_width, "override: pixels per line");
+module_param(fb_height, uint, 0644);
+MODULE_PARM_DESC(fb_height, "override: lines");
+
+/*
+ * The scan-out buffer lives in the boot CMA area, which is ordinary (and on
+ * this 1 GiB board, high) memory -- memremap() rejects RAM, so build a vmapped
+ * alias of the page range instead.
+ */
+static void *vodump_fb_vmap(u32 len)
+{
+	unsigned long pfn = PHYS_PFN(fb.phys);
+	u32 first = fb.phys & ~PAGE_MASK;
+	u32 npages = DIV_ROUND_UP(first + len, PAGE_SIZE);
+	struct page **pages;
+	void *kva;
+	u32 i;
+
+	pages = kvmalloc_array(npages, sizeof(*pages), GFP_KERNEL);
+	if (!pages)
+		return NULL;
+
+	for (i = 0; i < npages; i++) {
+		if (!pfn_valid(pfn + i))
+			break;
+		pages[i] = pfn_to_page(pfn + i);
+	}
+	if (i != npages) {
+		pr_info("vodump fb: pfn %08lx not managed\n", pfn + i);
+		kvfree(pages);
+		return NULL;
+	}
+
+	kva = vmap(pages, npages, VM_MAP, PAGE_KERNEL);
+	kvfree(pages);
+
+	return kva ? kva + first : NULL;
+}
+
+static void vodump_fb_read(void)
+{
+	u32 i, addr = 0, stride16 = 0, ireso = 0, vfpos = 0, vlpos = 0;
+
+	fb.base = 0;
+	for (i = 0; i < ARRAY_SIZE(gfx_bases); i++) {
+		u32 c = readl(vo_base + gfx_bases[i] + 0x00);
+
+		if (!(c & BIT(31)) || !readl(vo_base + gfx_bases[i] + 0x10))
+			continue;
+		if (!fb_addr && !fb.base) {
+			fb.base = gfx_bases[i];
+			addr = readl(vo_base + gfx_bases[i] + 0x10);
+			stride16 = readl(vo_base + gfx_bases[i] + 0x1c) & G0_STRIDE_MASK;
+			ireso = readl(vo_base + gfx_bases[i] + 0x20);
+			vfpos = readl(vo_base + gfx_bases[i] + 0x88);
+			vlpos = readl(vo_base + gfx_bases[i] + 0x8c);
+		}
+		pr_info("vodump layer %04x ctrl:%08x addr:%08x stride16:%x ireso:%08x "
+			"pos:%08x/%08x\n",
+			gfx_bases[i], c, readl(vo_base + gfx_bases[i] + 0x10),
+			readl(vo_base + gfx_bases[i] + 0x1c), ireso, vfpos, vlpos);
+	}
+
+	if (fb_addr) {
+		fb.base = 0;
+		addr = fb_addr;
+		stride16 = fb_stride / 16;
+		ireso = 0;
+		fb.width = fb_width;
+		fb.height = fb_height;
+		fb.rows = fb_height;
+	} else {
+		fb.width = FIELD_GET(G0_IRESO_IW, ireso) + 1;
+		fb.height = FIELD_GET(G0_IRESO_IH, ireso) + 1;
+		fb.rows = FIELD_GET(G0_DLPOS_Y, vlpos) -
+			  FIELD_GET(G0_DLPOS_Y, vfpos) + 1;
+	}
+
+	fb.phys = addr;
+	fb.stride = stride16 * 16;
+	if (fb_stride)
+		fb.stride = fb_stride;
+
+	pr_info("vodump fb from:%04x phys:%08x stride:%u wxh:%ux%u rows:%u ireso:%08x\n",
+		fb.base, fb.phys, fb.stride, fb.width, fb.height, fb.rows, ireso);
+
+	if (!fb.phys || !fb.stride || !fb.width ||
+	    (u64)fb.stride * fb.rows > SZ_16M) {
+		pr_info("vodump fb: nothing to map\n");
+		return;
+	}
+
+	fb.kva = vodump_fb_vmap(fb.stride * fb.rows);
+	if (!fb.kva) {
+		pr_info("vodump fb: vmap %08x+%u failed\n", fb.phys,
+			fb.stride * fb.rows);
+		return;
+	}
+
+	pr_info("vodump fb y0x0: %*phC\n", 32, fb.kva);
+	pr_info("vodump fb y1x0: %*phC\n", 32, fb.kva + fb.stride);
+	pr_info("vodump fb mid: %*phC\n", 16,
+		fb.kva + (fb.rows / 2) * fb.stride + (fb.width / 2) * 4);
+}
+
+static void vodump_fb_write(u32 pattern)
+{
+	u32 x, y, val;
+
+	if (!fb.kva) {
+		pr_info("vodump scr: no buffer mapped\n");
+		return;
+	}
+
+	for (y = 0; y < fb.rows; y++) {
+		for (x = 0; x < fb.width; x++) {
+			switch (pattern) {
+			case 6:	/* 64px checkerboard, white on black */
+				val = ((x >> 6) + (y >> 6)) & 1 ?
+					0x00ffffff : 0x00000000;
+				break;
+			case 7:	/* quadrants: white, black, red, blue */
+				if (y < fb.rows / 2)
+					val = x < fb.width / 2 ? 0x00ffffff :
+								0x00000000;
+				else
+					val = x < fb.width / 2 ? 0x00ff0000 :
+								0x000000ff;
+				break;
+			default:
+				val = pattern;
+				break;
+			}
+			*(u32 *)(fb.kva + y * fb.stride + x * 4) = val;
+		}
+	}
+	flush_kernel_vmap_range(fb.kva, fb.stride * fb.rows);
+	pr_info("vodump scr: wrote %08x over %ux%u stride %u\n", pattern,
+		fb.width, fb.rows, fb.stride);
+}
+
+static void vodump_full(void)
+{
+	vodump_list("vo", vo_offs, ARRAY_SIZE(vo_offs));
+	vodump_list("sd", sd_offs, ARRAY_SIZE(sd_offs));
+	vodump_scan("vdp", vo_base, VO_SIZE);
+	vodump_scan("crg", crg_base, CRG_SIZE);
+	vodump_hdmi();
+	vodump_fb_read();
+}
+
+static int param_set_dump(const char *val, const struct kernel_param *kp)
+{
+	unsigned int n;
+	int ret = kstrtouint(val, 0, &n);
+
+	if (ret)
+		return ret;
+	vodump_full();
+	return 0;
+}
+
+static int param_set_scr(const char *val, const struct kernel_param *kp)
+{
+	unsigned int n;
+	int ret = kstrtouint(val, 0, &n);
+
+	if (ret)
+		return ret;
+	vodump_fb_write(n);
+	return 0;
+}
+
+static unsigned int poke_sel;
+
+static int param_set_poke(const char *val, const struct kernel_param *kp)
+{
+	void __iomem *base = vo_base;
+	unsigned int size = VO_SIZE;
+	unsigned int off, n;
+
+	if (sscanf(val, "%x %x", &off, &n) != 2)
+		return -EINVAL;
+	if (poke_sel == 1) {
+		base = crg_base;
+		size = CRG_SIZE;
+	} else if (poke_sel == 2) {
+		base = hdmi_base;
+		size = SZ_8K;
+	} else if (poke_sel == 3) {
+		base = aiao_base;
+		size = AIAO_SIZE;
+	}
+	if (!base || off > size - 4)
+		return -ERANGE;
+	writel(n, base + off);
+	pr_info("vodump poke: sel=%u [%04x] = %08x -> %08x\n", poke_sel, off, n,
+		readl_relaxed(base + off));
+	return 0;
+}
+
+static unsigned int peek_off;
+
+static int param_set_peek(const char *val, const struct kernel_param *kp)
+{
+	void __iomem *base = vo_base;
+	unsigned int size = VO_SIZE;
+	unsigned int off;
+
+	if (kstrtouint(val, 0, &off))
+		return -EINVAL;
+	if (poke_sel == 1) {
+		base = crg_base;
+		size = CRG_SIZE;
+	} else if (poke_sel == 2) {
+		base = hdmi_base;
+		size = SZ_8K;
+	} else if (poke_sel == 3) {
+		base = aiao_base;
+		size = AIAO_SIZE;
+	}
+	if (!base || off > size - 4)
+		return -ERANGE;
+	peek_off = off;
+	pr_info("vodump peek: sel=%u [%04x] = %08x\n", poke_sel, off,
+		readl_relaxed(base + off));
+	return 0;
+}
+
+static unsigned int dump_now = 1;
+static unsigned int scr_pattern;
+static unsigned int poke_val;
+
+module_param_call(dump, param_set_dump, param_get_uint, &dump_now, 0644);
+MODULE_PARM_DESC(dump, "1 snapshots at boot; echo 1 re-runs the snapshot");
+module_param_call(scr, param_set_scr, param_get_uint, &scr_pattern, 0644);
+MODULE_PARM_DESC(scr, "write a u32 pixel pattern into the scan-out buffer (6=checker, "
+		 "7=quadrants)");
+module_param_call(poke, param_set_poke, param_get_uint, &poke_val, 0644);
+MODULE_PARM_DESC(poke, "write a register: echo '<offset> <value>' > poke (region from poke_sel)");
+module_param(poke_sel, uint, 0644);
+module_param_call(peek, param_set_peek, param_get_uint, &peek_off, 0644);
+MODULE_PARM_DESC(peek, "read back one register: echo <offset> > peek (region from poke_sel)");
+MODULE_PARM_DESC(poke_sel, "poke region: 0=VDP, 1=CRG, 2=HDMI TX, 3=AIAO");
+
+/*
+ * The named lists twice: once as soon as the mapping exists, once at the end of
+ * init. If the two disagree, something other than the display drivers is
+ * disturbing the pipeline.
+ */
+static bool vodump_mapped;
+
+static int __init histb_vodump_map(void)
+{
+	vo_base = ioremap(VO_BASE, VO_SIZE);
+	hdmi_base = ioremap(HDMI_BASE, SZ_8K);
+	crg_base = ioremap(CRG_BASE, CRG_SIZE);
+	aiao_base = ioremap(AIAO_BASE, AIAO_SIZE);
+	if (!vo_base || !hdmi_base || !crg_base || !aiao_base) {
+		pr_err("vodump: ioremap failed\n");
+		return -ENOMEM;
+	}
+	vodump_mapped = true;
+
+	if (dump_now)
+		vodump_list("early-vo", vo_offs, ARRAY_SIZE(vo_offs));
+
+	return 0;
+}
+
+static int __init histb_vodump_init(void)
+{
+	if (!vodump_mapped)
+		return 0;
+
+	if (dump_now)
+		vodump_full();
+
+	return 0;
+}
+early_initcall(histb_vodump_map);
+late_initcall(histb_vodump_init);
+
+MODULE_DESCRIPTION("Read-only hi3798mv100 display snapshot");
+MODULE_LICENSE("GPL");
--- /dev/null
+++ b/drivers/media/platform/hisilicon/histb-vdec/histb_vdec_v2_debug.c
@@ -0,0 +1,206 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+/*
+ * debugfs window for the VDH bring-up measurements: the VDM and SCD register
+ * windows, the CRG words behind the "clocks" phandle, and the message-pool
+ * slots a job assembles.
+ *
+ * This platform maps /dev/mem only for System RAM, so a driver-side window is
+ * the only way to sample these registers, and the vendor-vs-driver A/B tests
+ * (SCD global registers, clock/reset bits, doorbell) need to poke them too.
+ * Reading the VDM window requires the block clocked, so every dump holds a
+ * runtime PM reference.
+ */
+
+#include <linux/debugfs.h>
+#include <linux/mfd/syscon.h>
+#include <linux/pm_runtime.h>
+#include <linux/regmap.h>
+#include <linux/seq_file.h>
+#include <linux/uaccess.h>
+
+#include "histb_vdec_v2.h"
+
+#define HISTB_REG_WINDOW	0x1000
+
+static int histb_vdec_regs_show(struct seq_file *s, void *unused)
+{
+	struct histb_vdec_dev *dev = s->private;
+	unsigned int off;
+	u32 val;
+	int ret;
+
+	ret = pm_runtime_resume_and_get(dev->dev);
+	if (ret)
+		return ret;
+
+	if (dev->crg) {
+		regmap_read(dev->crg, VDH_CRG30, &val);
+		seq_printf(s, "crg30=%08x", val);
+		regmap_read(dev->crg, VDH_CRG93, &val);
+		seq_printf(s, " crg93=%08x\n", val);
+	}
+	seq_printf(s, "scd avs_flag=%08x emar_id=%08x ck_gt=%08x\n",
+		   readl(dev->scd + SCD_AVS_FLAG),
+		   readl(dev->scd + SCD_EMAR_ID),
+		   readl(dev->scd + SCD_VDH_CK_GT));
+	seq_printf(s, "irq_state=%08x\n", dev->irq_state);
+	for (off = 0; off <= VDM_AXI_TEST_STA; off += 0x10) {
+		seq_printf(s, "vdm %03x=%08x %03x=%08x %03x=%08x %03x=%08x\n",
+			   off, vdm_read(dev, off), off + 4,
+			   vdm_read(dev, off + 4), off + 8,
+			   vdm_read(dev, off + 8), off + 12,
+			   vdm_read(dev, off + 12));
+	}
+	for (off = VDM_SED_STA; off <= VDM_SED_LAST; off += 0x10) {
+		seq_printf(s, "vdm %03x=%08x %03x=%08x %03x=%08x %03x=%08x\n",
+			   off, vdm_read(dev, off), off + 4,
+			   vdm_read(dev, off + 4), off + 8,
+			   vdm_read(dev, off + 8), off + 12,
+			   vdm_read(dev, off + 12));
+	}
+
+	pm_runtime_put_autosuspend(dev->dev);
+	return 0;
+}
+
+/* "vdm|scd|crg <offset> <value>" */
+static ssize_t histb_vdec_regs_write(struct file *file,
+				     const char __user *userbuf,
+				     size_t count, loff_t *ppos)
+{
+	struct seq_file *s = file->private_data;
+	struct histb_vdec_dev *dev = s->private;
+	char buf[40], name[8];
+	unsigned int reg, val;
+	int ret;
+
+	/*
+	 * Debug write format: "<window> <offset> <value>", read into a fixed
+	 * buffer, so an over-long line is rejected rather than truncated - a
+	 * truncated line would write the value parsed from a prefix of what was
+	 * typed. The offset is bounded by the register window that is mapped
+	 * for this block: the write goes through that mapping directly, so an
+	 * offset past its end would store into whatever lies beyond the block
+	 * rather than faulting.
+	 */
+	if (count >= sizeof(buf))
+		return -EINVAL;
+	if (copy_from_user(buf, userbuf, count))
+		return -EFAULT;
+	buf[count] = '\0';
+
+	if (sscanf(buf, "%7s %x %x", name, &reg, &val) != 3 ||
+	    reg >= HISTB_REG_WINDOW)
+		return -EINVAL;
+
+	ret = pm_runtime_resume_and_get(dev->dev);
+	if (ret)
+		return ret;
+
+	if (sysfs_streq(name, "vdm"))
+		writel(val, dev->vdm + reg);
+	else if (sysfs_streq(name, "scd"))
+		writel(val, dev->scd + reg);
+	else if (sysfs_streq(name, "crg"))
+		ret = dev->crg ? regmap_write(dev->crg, reg, val) : -ENODEV;
+	else
+		ret = -EINVAL;
+
+	pm_runtime_put_autosuspend(dev->dev);
+	return ret ? ret : count;
+}
+
+static int histb_vdec_regs_open(struct inode *inode, struct file *file)
+{
+	return single_open(file, histb_vdec_regs_show, inode->i_private);
+}
+
+static const struct file_operations histb_vdec_regs_fops = {
+	.owner = THIS_MODULE,
+	.open = histb_vdec_regs_open,
+	.read = seq_read,
+	.write = histb_vdec_regs_write,
+	.llseek = seq_lseek,
+	.release = single_release,
+};
+
+static int histb_vdec_pool_show(struct seq_file *s, void *unused)
+{
+	struct histb_vdec_dev *dev = s->private;
+	unsigned int first = 0;
+	unsigned int bad;
+	unsigned int i;
+
+	mutex_lock(&dev->hw_lock);
+	seq_printf(s, "pool dma=%pad size=%zu pic=%u slice=%u up=%u table=%u\n",
+		   &dev->pool.dma, dev->pool.size, dev->pool.pic_off,
+		   dev->pool.slice_off, dev->pool.up_off, dev->pool.table_off);
+	seq_hex_dump(s, "pic  ", DUMP_PREFIX_OFFSET, 16, 4,
+		     histb_vdec_pic_slot(&dev->pool), HISTB_VDEC_SLOT_BYTES,
+		     false);
+	seq_hex_dump(s, "slc0 ", DUMP_PREFIX_OFFSET, 16, 4,
+		     histb_vdec_slice_slot(&dev->pool, 0),
+		     HISTB_VDEC_SLOT_BYTES, false);
+	seq_hex_dump(s, "up   ", DUMP_PREFIX_OFFSET, 16, 4,
+		     histb_vdec_up_msgs(&dev->pool),
+		     8 * HISTB_VDEC_UP_MSG_WORDS, false);
+
+	/*
+	 * Table-area integrity and scratch usage: the VDM is only supposed to
+	 * read the CABAC table and to write the scratch blocks, so a clobbered
+	 * table word or an untouched scratch block says a descriptor address
+	 * does not point where the driver thinks it does.
+	 */
+	bad = histb_vdec_hw_check_tables(dev, &first);
+	seq_printf(s, "mn264 bad=%u first=%u\n", bad, first);
+	for (i = 0; i < HISTB_VDEC_NUM_SCRATCH; i++) {
+		unsigned int nz, off;
+
+		nz = histb_vdec_hw_scratch_usage(dev, i, &off);
+		seq_printf(s, "scr%u dma=%#llx nz=%u first=%u\n", i,
+			   (unsigned long long)(histb_vdec_tables_dma(&dev->pool) +
+						HISTB_TABLE_OFF_SCRATCH(i)),
+			   nz, off);
+	}
+	mutex_unlock(&dev->hw_lock);
+	return 0;
+}
+
+static int histb_vdec_pool_open(struct inode *inode, struct file *file)
+{
+	return single_open(file, histb_vdec_pool_show, inode->i_private);
+}
+
+static const struct file_operations histb_vdec_pool_fops = {
+	.owner = THIS_MODULE,
+	.open = histb_vdec_pool_open,
+	.read = seq_read,
+	.llseek = seq_lseek,
+	.release = single_release,
+};
+
+static void histb_vdec_debugfs_put(void *dir)
+{
+	debugfs_remove_recursive(dir);
+}
+
+void histb_vdec_debugfs_init(struct histb_vdec_dev *dev)
+{
+	struct device_node *np;
+	struct regmap *crg;
+	struct dentry *dir;
+
+	/* The CRG node is claimed by the clock driver, so the regmap lookup has
+	 * to go through the syscon registration of the same node.
+	 */
+	np = of_parse_phandle(dev->dev->of_node, "clocks", 0);
+	crg = np ? syscon_node_to_regmap(np) : ERR_PTR(-ENODEV);
+	of_node_put(np);
+	dev->crg = IS_ERR(crg) ? NULL : crg;
+
+	dir = debugfs_create_dir(dev_name(dev->dev), NULL);
+	dev->dbgfs = dir;
+	debugfs_create_file("regs", 0600, dir, dev, &histb_vdec_regs_fops);
+	debugfs_create_file("pool", 0400, dir, dev, &histb_vdec_pool_fops);
+	devm_add_action_or_reset(dev->dev, histb_vdec_debugfs_put, dir);
+}
