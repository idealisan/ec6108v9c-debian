+
+static void histb_vdec_v5_probe_census_show(struct histb_vdec_v5 *dec,
+					  const char *tag)
+{
+	char line[120];
+	int n = 0;
+	size_t i;
+
+	for (i = 0; i < ARRAY_SIZE(histb_vdec_v5_probe_census); i++) {
+		n += scnprintf(line + n, sizeof(line) - n, " %s %08x",
+			       histb_vdec_v5_probe_census[i].name,
+			       histb_vdec_v5_read(dec,
+						histb_vdec_v5_probe_census[i].off));
+		if (n > (int)sizeof(line) - 24) {
+			pr_info("histb-vdec5: census %s:%s\n", tag, line);
+			n = 0;
+		}
+	}
+	if (n)
+		pr_info("histb-vdec5: census %s:%s\n", tag, line);
+}
+
+static ssize_t histb_vdec_v5_probe_write_run(struct file *f,
+					   const char __user *u, size_t n,
+					   loff_t *off)
+{
+	struct histb_vdec_v5_probe *probe = f->private_data;
+	struct histb_vdec_v5 *dec = probe->dec;
+	const u8 *buf = probe->stream_va;
+	unsigned int i, slice_byte = 0;
+	bool powered = false;
+	u32 pic_dma, slice_dma;
+	struct histb_vdec_v5_job job = {
+		.cfg0 = cfg0,
+		.cfg1 = cfg1,
+		.to_val = to_val,
+		.reg_shift = reg_shift,
+		.pitch = pitch,
+		.stream = probe->stream_dma,
+		.recon = probe->recon_dma,
+		.uv_offset = uv_offset,
+		.pic = probe->pic,
+		.slice = probe->slice,
+	};
+	int ret;
+
+	histb_vdec_v5_pool_seed(dec);
+	memcpy(probe->stream_va, histb_vdec_v5_probe_stream, probe->stream_len);
+	memset(probe->stream_va + probe->stream_len, 0,
+	       probe->stream_size - probe->stream_len);
+	memset(probe->recon_va, 0xa4, probe->recon_size);
+
+	for (i = 0; i + 3 < probe->stream_size; i++)
+		if (!buf[i] && !buf[i + 1] && buf[i + 2] == 1 &&
+		    (buf[i + 3] & 0x1f) == 5) {
+			slice_byte = i + 3;
+			break;
+		}
+	if (!slice_byte)
+		return -EINVAL;
+
+	pic_dma = histb_vdec_v5_addr_at(histb_vdec_v5_slot_dma(dec, V5R6_SLOT_PIC),
+				      reg_shift);
+	slice_dma = histb_vdec_v5_addr_at(histb_vdec_v5_slot_dma(dec,
+							     V5R6_SLOT_SLICE),
+					reg_shift);
+
+	histb_vdec_v5_probe_pack(probe, slice_byte);
+	job.stream = abs_d0 ? probe->stream_dma :
+			      probe->stream_dma + probe->gran_off;
+	memcpy(histb_vdec_v5_slot(dec, V5R6_SLOT_PIC), probe->pic,
+	       sizeof(probe->pic));
+	memcpy(histb_vdec_v5_slot(dec, V5R6_SLOT_SLICE), probe->slice,
+	       sizeof(probe->slice));
+
+	/* The block is only reachable while its clocks are up. */
+	ret = pm_runtime_resume_and_get(dec->dev);
+	if (ret)
+		return ret;
+	powered = true;
+
+	dev_info(dec->dev, "pool %#llx recon %#llx stream %#llx pic %#x slice %#x\n",
+		 (u64)dec->pool.dma, (u64)job.recon, (u64)job.stream,
+		 pic_dma, slice_dma);
+
+	u32 pool_before[V5R6_POOL_BYTES / (V5R6_PROBE_CHUNK * 1024) + 1];
+	u32 recon_before[4];
+
+	histb_vdec_v5_probe_stamp(dec->pool.va, V5R6_POOL_BYTES, pool_before);
+	histb_vdec_v5_probe_stamp(probe->recon_va, probe->recon_size,
+				recon_before);
+
+	dev_info(dec->dev, "seg %u@%u+%u bps pic0 %08x pic1 %08x\n",
+		 probe->slice[2], probe->slice[0], probe->slice[1],
+		 probe->pic[0], probe->pic[1]);
+
+	histb_vdec_v5_probe_census_show(dec, "pre");
+	ret = histb_vdec_v5_launch(dec, &job);
+
+	dev_info(dec->dev, "probe launch %s (pitch %u uv %u cfg0 %08x cfg1 %08x)\n",
+		 ret ? "failed" : "done", pitch, uv_offset, cfg0, cfg1);
+	histb_vdec_v5_probe_census_show(dec, "post");
+	histb_vdec_v5_probe_diff(probe, pool_before, recon_before);
+
+	/*
+	 * Twice more, because a launch that finishes later than the poll
+	 * window would otherwise read as a launch that produced nothing.
+	 */
+	msleep(200);
+	pr_info("histb-vdec5: -- 200 ms --\n");
+	histb_vdec_v5_probe_diff(probe, pool_before, recon_before);
+	msleep(800);
+	pr_info("histb-vdec5: -- 1 s --\n");
+	histb_vdec_v5_probe_diff(probe, pool_before, recon_before);
+	histb_vdec_v5_probe_census_show(dec, "late");
+	histb_vdec_v5_probe_report(probe);
+
+	if (powered)
+		pm_runtime_put(dec->dev);
+
+	return ret ?: n;
+}
+
+static const struct file_operations histb_vdec_v5_probe_run_fops = {
+	.owner = THIS_MODULE,
+	.open = simple_open,
+	.write = histb_vdec_v5_probe_write_run,
+	.llseek = noop_llseek,
+};
+
+int histb_vdec_v5_probe_init(struct histb_vdec_v5 *dec)
+{
+	struct histb_vdec_v5_probe *probe;
+	size_t recon_size = (size_t)pitch * ALIGN(V5R6_PROBE_HEIGHT, 32) * 3 / 2 +
+				    SZ_64K;
+	int ret = -ENOMEM;
+
+	probe = devm_kzalloc_obj(dec->dev, *probe);
+	if (!probe)
+		return -ENOMEM;
+
+	probe->dec = dec;
+	dec->probe = probe;
+	probe->stream_size = ALIGN(HISTB_VDEC_V5_PROBE_STREAM_SIZE + SZ_4K, SZ_4K);
+	probe->stream_len = HISTB_VDEC_V5_PROBE_STREAM_SIZE;
+	probe->recon_size = ALIGN(recon_size, SZ_64K);
+
+	probe->stream_va = dma_alloc_coherent(dec->dev, probe->stream_size,
+					      &probe->stream_dma, GFP_KERNEL);
+	if (!probe->stream_va)
+		return -ENOMEM;
+
+	probe->recon_va = dma_alloc_coherent(dec->dev, probe->recon_size,
+					     &probe->recon_dma, GFP_KERNEL);
+	if (!probe->recon_va)
+		goto free_stream;
+
+	dec->dbgfs = debugfs_create_dir(dev_name(dec->dev), NULL);
+	if (IS_ERR(dec->dbgfs)) {
+		ret = PTR_ERR(dec->dbgfs);
+		goto free_recon;
+	}
+
+	debugfs_create_file("run", 0200, dec->dbgfs, probe,
+			    &histb_vdec_v5_probe_run_fops);
+	debugfs_create_file("frame", 0400, dec->dbgfs, probe,
+			    &histb_vdec_v5_probe_frame_fops);
+	debugfs_create_file("status", 0400, dec->dbgfs, probe,
+			    &histb_vdec_v5_probe_status_fops);
+
+	return 0;
+
+free_recon:
+	dma_free_coherent(dec->dev, probe->recon_size, probe->recon_va,
+			  probe->recon_dma);
+free_stream:
+	dma_free_coherent(dec->dev, probe->stream_size, probe->stream_va,
+			  probe->stream_dma);
+
+	return ret;
+}
+
+void histb_vdec_v5_probe_exit(struct histb_vdec_v5 *dec)
+{
+	struct histb_vdec_v5_probe *probe = dec->probe;
+
+	debugfs_remove_recursive(dec->dbgfs);
+	dec->dbgfs = NULL;
+	if (probe == NULL)
+		return;
+	if (probe->recon_va != NULL)
+		dma_free_coherent(dec->dev, probe->recon_size,
+				  probe->recon_va, probe->recon_dma);
+	if (probe->stream_va != NULL)
+		dma_free_coherent(dec->dev, probe->stream_size,
+				  probe->stream_va, probe->stream_dma);
+	dec->probe = NULL;
+}
