From 6af992f30d51cb5231c635672de7e934f8666811 Mon Sep 17 00:00:00 2001
From: David Yang <mmyangfl@gmail.com>
Date: Wed, 4 Nov 2026 00:17:21 +0800
Subject: [PATCH] dts: mv200h bench board variants

The DTB targets for the psci and tramp board variants and this box's
factory MAC carry the verified values.

Signed-off-by: David Yang <mmyangfl@gmail.com>
---
 arch/arm64/boot/dts/hisilicon/Makefile        |  3 +++
 .../hisilicon/hi3798mv200h-skyworth-stb.dts   | 22 ++++++++++++++++---
 2 files changed, 22 insertions(+), 3 deletions(-)

--- a/arch/arm64/boot/dts/hisilicon/Makefile
+++ b/arch/arm64/boot/dts/hisilicon/Makefile
@@ -4,6 +4,9 @@ dtb-$(CONFIG_ARCH_HISI) += hi3670-hikey9
 dtb-$(CONFIG_ARCH_HISI) += hi3798cv200-poplar.dtb
 dtb-$(CONFIG_ARCH_HISI) += hi3798mv200-hc2910-2aghd05.dtb
 dtb-$(CONFIG_ARCH_HISI) += hi3798mv200h-skyworth-stb.dtb
+dtb-$(CONFIG_ARCH_HISI) += hi3798mv200h-skyworth-stb-psci.dtb
+dtb-$(CONFIG_ARCH_HISI) += hi3798mv200h-skyworth-stb-tramp.dtb
+dtb-$(CONFIG_ARCH_HISI) += hi3798mv200h-skyworth-stb-tramp-nowdt.dtb
 dtb-$(CONFIG_ARCH_HISI) += hi6220-hikey.dtb
 dtb-$(CONFIG_ARCH_HISI) += hip05-d02.dtb
 dtb-$(CONFIG_ARCH_HISI) += hip06-d03.dtb
--- a/arch/arm64/boot/dts/hisilicon/hi3798mv200h-skyworth-stb.dts
+++ b/arch/arm64/boot/dts/hisilicon/hi3798mv200h-skyworth-stb.dts
@@ -175,6 +175,22 @@
 
 &femac {
 	status = "okay";
+
+	/*
+	 * This box's factory MAC, read out of the dumps in mv200h-img/: the
+	 * Skyworth "properties" partition holds it as the ASCII value of a "mac"
+	 * record and the "private" partition holds the same six bytes raw at
+	 * partition offset 0x600004.  Without it hisi_femac falls back to
+	 * eth_hw_addr_random(), so every boot presents a different Ethernet
+	 * identity and the DHCP lease churns.
+	 *
+	 * It is a literal rather than an nvmem cell because this tree has no way
+	 * to expose an eMMC partition to nvmem: CONFIG_OF_PARTITION
+	 * (block/partitions/of.c) reads the gendisk device's of_node, and nothing
+	 * in drivers/mmc/ ever sets it.  A per-unit value does not belong in a
+	 * shared board file, so this stays out of any submission.
+	 */
+	local-mac-address = [14 11 5d aa a4 6c];
 };
 
 /* The vendor DT and the board's MDIO scan both put the PHY at address 2. */
@@ -322,9 +338,9 @@
 };
 
 /*
- * The V5R6 video decoder. The driver claims the block, resets it through its
- * own wrapper and asks for its completion line, so this node has to carry the
- * clock gate and the interrupt for the block to run at all.
+ * The V5R6 video decoder. The bring-up driver only claims the block, resets it
+ * through its own wrapper and asks for its completion line, so enabling this
+ * node is the measurement of the clock-enable and interrupt contract.
  */
 &vdec {
 	status = "okay";
