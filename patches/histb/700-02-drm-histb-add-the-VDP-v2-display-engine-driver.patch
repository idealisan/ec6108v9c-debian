+/* ------------------------------------------------------------------ */
+/* Plane (G0 graphics layer)                                           */
+/* ------------------------------------------------------------------ */
+
+/*
+ * ARGB8888 is accepted as storage for a 32bpp surface but its alpha byte is
+ * ignored (see the format switch in histb_vdp2_g0_set()), which is what the
+ * plane's "pixel blend mode" = None declares.
+ */
+static const u32 histb_vdp2_formats[] = {
+	DRM_FORMAT_XRGB8888,
+	DRM_FORMAT_ARGB8888,
+	DRM_FORMAT_ABGR8888,
+	DRM_FORMAT_RGBA8888,
+	DRM_FORMAT_RGB565,
+	DRM_FORMAT_XRGB4444,
+	DRM_FORMAT_ARGB4444,
+	DRM_FORMAT_XRGB1555,
+	/* one byte per channel; the fetch stride is in 16-byte units, so the
+	 * width has to be a multiple of 16 pixels for the pitch to divide.
+	 */
+	DRM_FORMAT_BGR888,
+};
+
+/* `value - 1`, clamped so that a zero porch/sync width never underflows */
+static u32 histb_vdp2_m1(u32 v)
+{
+	return max(v, 1u) - 1;
+}
