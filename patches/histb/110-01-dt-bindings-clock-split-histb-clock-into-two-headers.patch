 .../clock/hisilicon,hi3798cv200-crg.h         | 62 ++++++++++++++++
 .../clock/hisilicon,hi3798cv200-sysctrl.h     | 17 +++++
 include/dt-bindings/clock/histb-clock.h       | 70 +++----------------
 3 files changed, 88 insertions(+), 61 deletions(-)
 create mode 100644 include/dt-bindings/clock/hisilicon,hi3798cv200-crg.h
 create mode 100644 include/dt-bindings/clock/hisilicon,hi3798cv200-sysctrl.h

