From 60a71908cebd38bf19df084e1426159cb6e30be6 Mon Sep 17 00:00:00 2001
From: David Yang <mmyangfl@gmail.com>
Date: Tue, 3 Nov 2026 14:41:30 +0800
Subject: [PATCH 2/10] dt-bindings: media: describe the MV200H codecs with the
 cv200 schema

The Hi3798MV200H decoder and encoder are the same two blocks a
generation on, with the same register interface and one extra
compatible, so the existing schema carries them instead of a second file
per block.

Signed-off-by: David Yang <mmyangfl@gmail.com>
---
 .../media/hisilicon,hi3716cv200-vdec.yaml     | 175 ++++++++++++++++++
 1 file changed, 175 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/media/hisilicon,hi3716cv200-vdec.yaml

--- /dev/null
+++ b/Documentation/devicetree/bindings/media/hisilicon,hi3716cv200-vdec.yaml
@@ -0,0 +1,175 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/media/hisilicon,hi3716cv200-vdec.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: HiSilicon HiSTB video decoder (VDH)
+
+maintainers:
+  - David Yang <mmyangfl@gmail.com>
+
+description: |-
+  The stateless video decoder of the HiSilicon HiSTB set-top-box SoCs: userspace
+  submits fully parsed syntax through request controls and the block writes a
+  decoded frame.
+
+  Two generations are covered, numbered by the hardware generation the driver
+  backend serves (not by the vendor's vdec_vX.Y layer). The v2 block of
+  hi3716cv200 and hi3798mv100 is
+  a VDM register window plus the SCD block that holds the three decoder-global
+  registers, with one interrupt line for the doorbell and one clock gate that
+  also drops the subsystem reset. Hi3716CV200 has the same block, at the same
+  addresses and with the same register offsets, and runs the older generation
+  of the core (HiVDHV200R004 against HiVDHV300R001), whose only difference that
+  reaches this binding is that it has no HEVC path. The V5R6 block of
+  hi3798mv200 is one 64 KiB window holding the decode core, the stream
+  distributor and the bitplane unpacker, and resets and clocks itself through
+  its own wrapper rather than through the clock and reset generator.
+
+properties:
+  compatible:
+    enum:
+      - hisilicon,hi3716cv200-vdec
+      - hisilicon,hi3798mv100-vdec
+      - hisilicon,hi3798mv200-vdec
+
+  reg:
+    minItems: 1
+    maxItems: 2
+
+  reg-names:
+    minItems: 1
+    maxItems: 2
+    items:
+      enum:
+        - vdm
+        - scd
+
+  interrupts:
+    maxItems: 1
+
+  interrupt-names:
+    items:
+      - const: vdm
+
+  clocks:
+    maxItems: 1
+
+  clock-names:
+    const: vdec
+
+  resets:
+    minItems: 1
+    maxItems: 2
+    description: |
+      The V300 generation takes two reset requests in the clock and reset
+      generator, both of which the vendor firmware releases before the register
+      window answers reads - the subsystem-wide one and the VDM's own one. The
+      V5R6 generation takes none of them: its core's own wrapper carries the
+      reset request and acknowledge.
+
+  reset-names:
+    minItems: 1
+    maxItems: 2
+    items:
+      enum:
+        - global
+        - vdm
+
+  memory-region:
+    maxItems: 1
+    description: |
+      Phandle to a reserved memory region to allocate decoder buffers from. The
+      V300 generation's both queues are dma-contig and its message pool is
+      programmed as a single physical base address, so these buffers have to be
+      physically contiguous. Without this property they are taken from the
+      default CMA area.
+
+required:
+  - compatible
+  - reg
+  - interrupts
+
+additionalProperties: false
+
+allOf:
+  - if:
+      properties:
+        compatible:
+          contains:
+            enum:
+              - hisilicon,hi3716cv200-vdec
+              - hisilicon,hi3798mv100-vdec
+    then:
+      properties:
+        reg:
+          maxItems: 2
+          minItems: 2
+        reg-names:
+          items:
+            - const: vdm
+            - const: scd
+        clocks:
+          maxItems: 1
+        resets:
+          minItems: 2
+          maxItems: 2
+        reset-names:
+          items:
+            - const: global
+            - const: vdm
+        interrupt-names: false
+      required:
+        - reg-names
+        - clocks
+        - clock-names
+        - resets
+        - reset-names
+  - if:
+      properties:
+        compatible:
+          contains:
+            const: hisilicon,hi3798mv200-vdec
+    then:
+      properties:
+        reg:
+          maxItems: 1
+          minItems: 1
+        reg-names: false
+        clocks: false
+        clock-names: false
+        resets: false
+        reset-names: false
+        memory-region: false
+      required:
+        - interrupt-names
+
+examples:
+  - |
+    #include <dt-bindings/interrupt-controller/arm-gic.h>
+    #include <dt-bindings/interrupt-controller/irq.h>
+    #include <dt-bindings/clock/hisilicon,hi3798mv100-crg.h>
+
+    video-codec@8c30000 {
+        compatible = "hisilicon,hi3798mv100-vdec";
+        reg = <0x8c30000 0x1100>, <0x8c3c000 0x1000>;
+        reg-names = "vdm", "scd";
+        interrupts = <GIC_SPI 95 IRQ_TYPE_LEVEL_HIGH>;
+        clocks = <&crg HI3798MV100_VDH_CLK>;
+        clock-names = "vdec";
+        resets = <&crg 0x78 4>, <&crg 0x78 6>;
+        reset-names = "global", "vdm";
+    };
+
+  - |
+    #include <dt-bindings/interrupt-controller/arm-gic.h>
+    #include <dt-bindings/interrupt-controller/irq.h>
+
+    video-decoder@8c30000 {
+        compatible = "hisilicon,hi3798mv200-vdec";
+        reg = <0x8c30000 0x10000>;
+        interrupts = <GIC_SPI 95 IRQ_TYPE_LEVEL_HIGH>;
+        interrupt-names = "vdm";
+    };
+...
