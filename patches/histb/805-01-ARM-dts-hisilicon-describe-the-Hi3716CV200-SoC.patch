+
+		jpgd: jpeg-decoder@f8c40000 {
+			compatible = "hisilicon,hi3716cv200-jpgd";
+			reg = <0xf8c40000 0x6c0>;
+			interrupts = <GIC_SPI 97 IRQ_TYPE_LEVEL_HIGH>;
+			clocks = <&crg HI3716CV200_JPGD_CLK>;
+			clock-names = "jpgd";
+			resets = <&crg 0x7c 4>;
+			reset-names = "jpgd";
+			status = "disabled";
+		};
+
+		jpge: jpeg-encoder@f8c90000 {
+			compatible = "hisilicon,hi3716cv200-jpge";
+			reg = <0xf8c90000 0x10c0>;
+			interrupts = <GIC_SPI 102 IRQ_TYPE_LEVEL_HIGH>;
+			clocks = <&crg HI3716CV200_JPGE_CLK>;
+			clock-names = "jpge";
+			resets = <&crg 0x90 4>;
+			reset-names = "jpge";
+			status = "disabled";
+		};
+
+		/*
+		 * The video decoder. Same block generation as the Hi3798MV100's as
+		 * far as this kernel programs it: the vendor's firmware for this part
+		 * puts the VDM at 0xf8c30000 and the SCD at 0xf8c3c000 and gives the
+		 * doorbell interrupt as SPI 95 (the vendor firmware's build config,
+		 * byte-identical to the Hi3798MV100's). The VDM window is sized to
+		 * reach the syntax-error record at 0x1014. HEVC is not in this
+		 * part's codec list, unlike the Hi3798MV100's.
+		 */
+		vdec: video-codec@f8c30000 {
+			compatible = "hisilicon,hi3716cv200-vdec";
+			reg = <0xf8c30000 0x1100>, <0xf8c3c000 0x1000>;
+			reg-names = "vdm", "scd";
+			interrupts = <GIC_SPI 95 IRQ_TYPE_LEVEL_HIGH>;
+			clocks = <&crg HI3716CV200_VDH_CLK>;
+			clock-names = "vdec";
+			resets = <&crg 0x78 4>, <&crg 0x78 6>;
+			reset-names = "global", "vdm";
+			status = "disabled";
+		};
+
+		/*
+		 * The video encoder, present on silicon: read back at fastboot, the
+		 * window answers and 0xf8c800fc gives 0x56325238, the revision string
+		 * "V2R8" -- the r008 register file the vendor's own build selects for
+		 * this part (the vendor encoder driver's build, which also gives the
+		 * base here and SPI 101). No board config in the SDK enables it, so
+		 * nothing has ever decoded through it.
+		 */
+		venc: video-encoder@f8c80000 {
+			compatible = "hisilicon,hi3716cv200-venc";
+			reg = <0xf8c80000 0x10000>;
+			interrupts = <GIC_SPI 101 IRQ_TYPE_LEVEL_HIGH>;
+			clocks = <&crg HI3716CV200_VENC_CLK>;
+			clock-names = "venc";
+			resets = <&crg 0x8c 4>;
+			reset-names = "venc";
+			status = "disabled";
+		};
+
+		aiao: audio@f8cd0000 {
+			compatible = "hisilicon,hi3716cv200-aiao-i2s";
+			reg = <0xf8cd0000 0x10000>;
+			interrupts = <GIC_SPI 84 IRQ_TYPE_LEVEL_HIGH>;
+			clocks = <&crg HI3716CV200_AIAO_CLK>;
+			resets = <&crg 0x118 4>;
+			#sound-dai-cells = <1>;
+		};
+
+		/*
+		 * The vendor HDMI glue polls HPD
+		 */
+		/*
+		 * The output channel (vdp_v1_0 "DHD0"). Its register file is the VDP
+		 * block: the channel's own window starts at base + 0xc000 and the
+		 * whole block, graphics layers included, fits in one 64 KiB page
+		 * (HDATE_VERSION sits at +0xf000 and reads a date code on the board).
+		 * The interrupt is the vendor's own number for this block, INTID 122,
+		 * taken from the running vendor system's /proc/interrupts rather than
+		 * from the vendor machine header, which disagrees with the board in
+		 * three places.
+		 *
+		 * pix is the HD channel clock (CRG10/CRG11's word pair as the vendor's
+		 * mode table pairs it with a pixel rate), vo is the rest of CRG54's
+		 * display gates; the driver enables both before it pulses vou_srst_req,
+		 * because a reset request only reaches the block while it is clocked.
+		 */
+		vdp: display@f8cc0000 {
+			compatible = "hisilicon,hi3716cv200-vdp";
+			reg = <0xf8cc0000 0x10000>;
+			interrupts = <GIC_SPI 90 IRQ_TYPE_LEVEL_HIGH>;
+			clocks = <&crg HI3716CV200_CLK_VO_HD>,
+				 <&crg HI3716CV200_VO_CLK>;
+			clock-names = "pix", "vo";
+			resets = <&crg 0xd8 30>;
+			status = "okay";
+
+			ports {
+				#address-cells = <1>;
+				#size-cells = <0>;
+
+				port@0 {
+					reg = <0>;
+					vdp_out_hdmi: endpoint {
+						remote-endpoint = <&hdmi_in_vdp>;
+					};
+				};
+			};
+		};
+
+		hdmi: hdmi@f8ce0000 {
+			compatible = "hisilicon,hi3716cv200-hdmi";
+			reg = <0xf8ce0000 0x10000>;
+			interrupts = <GIC_SPI 88 IRQ_TYPE_LEVEL_HIGH>;
+			clocks = <&crg HI3716CV200_HDMITX_CTRL_CLK>,
+				 <&crg HI3716CV200_HDMITX_PHY_CLK>;
+			clock-names = "ctrl", "phy";
+			resets = <&crg 0x10c 9>, <&crg 0x10c 8>, <&crg 0x110 4>;
+			reset-names = "base", "bus", "phy";
+			#sound-dai-cells = <0>;
+
+			ports {
+				#address-cells = <1>;
+				#size-cells = <0>;
+
+				port@0 {
+					reg = <0>;
+					hdmi_in_vdp: endpoint {
+						remote-endpoint = <&vdp_out_hdmi>;
+					};
+				};
+			};
+		};
+	};
+};
+
+/ {
+	aliases {
+		serial0 = &uart0;
+	};
+
+	chosen {
+		stdout-path = "serial0:115200n8";
+	};
+
+	/*
+	 * The internal DAC. It has no register that picks where its serial data
+	 * comes from: the vendor port map connects it to AIAO transmit port 2,
+	 * which is why the link below names that port rather than any of the
+	 * others.
+	 */
+	adac: audio-codec@f8a20110 {
+		compatible = "hisilicon,hi3716cv200-adac";
+		reg = <0xf8a20110 0x8>;
+		clocks = <&crg HI3716CV200_ADAC_CLK>;
+		resets = <&crg 0x114 4>;
+		#sound-dai-cells = <0>;
+	};
+
+	/*
+	 */
+	sound {
+		compatible = "hisilicon,hi3716cv200-aiao-card";
+		model = "hi3716cv200-aiao";
+
+		playback {
+			cpu {
+				sound-dai = <&aiao 0>;
+			};
+
+			codec {
+				sound-dai = <&hdmi>;
+			};
+		};
+
+		capture {
+			cpu {
+				sound-dai = <&aiao 1>;
+			};
+		};
+
+		dac-playback {
+			cpu {
+				sound-dai = <&aiao 2>;
+			};
+
+			codec {
+				sound-dai = <&adac>;
+			};
+		};
+
+		/*
+		 */
+		dac-capture {
+			cpu {
+				sound-dai = <&aiao 3>;
+			};
+		};
+	};
+};
