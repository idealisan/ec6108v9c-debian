From de21cbcbd598c51bee87097838ddfe19033ce81b Mon Sep 17 00:00:00 2001
From: David Yang <mmyangfl@gmail.com>
Date: Tue, 27 Oct 2026 20:06:07 +0800
Subject: [PATCH 1/2] dt-bindings: hisilicon: document the cv200 and mv200
 blocks

The cv200 and mv200 display and GPU blocks were undocumented. Document
their compatibles in the Mali and HDMI transmitter schemas.

Signed-off-by: David Yang <mmyangfl@gmail.com>
---
 .../hisilicon/hisilicon,hi3798mv200-hdmi.yaml | 113 ++++++++++++++++++
 .../bindings/gpu/arm,mali-utgard.yaml         |   2 +
 2 files changed, 115 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/display/hisilicon/hisilicon,hi3798mv200-hdmi.yaml

--- /dev/null
+++ b/Documentation/devicetree/bindings/display/hisilicon/hisilicon,hi3798mv200-hdmi.yaml
@@ -0,0 +1,113 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/display/hisilicon/hisilicon,hi3798mv200-hdmi.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: HiSilicon Hi3798MV200 HDMI transmitter
+
+maintainers:
+  - David Yang <mmyangfl@gmail.com>
+
+description: |
+  The on-chip HDMI transmitter takes the pixel stream of one VDP display
+  channel and serialises it onto a TMDS link. It is made of two register
+  windows, the digital blocks (encoder, video path, packetiser, DDC master)
+  and the analog PHY, and it needs two divider fields and the resets of the
+  SoC clock generator, which is why it also refers to that block.
+
+properties:
+  compatible:
+    const: hisilicon,hi3798mv200-hdmi
+
+  reg:
+    minItems: 2
+    maxItems: 2
+
+  reg-names:
+    items:
+      - const: tx
+      - const: phy
+
+  clocks:
+    items:
+      - description:
+          HD channel pixel clock. The channel and this transmitter run off the
+          same clock, so neither can disagree about the pixel clock.
+      - description: Gate of the TMDS clock the PHY is driven from.
+
+  clock-names:
+    items:
+      - const: pix
+      - const: tmds
+
+  resets:
+    maxItems: 4
+    description:
+      The resets of the transmitter's blocks in the clock generator, being the
+      controller bus, the controller, the spread spectrum block and the TMDS
+      clock path. The PHY's own request bit is not listed here, because the
+      driver pulses it as part of a divider change.
+
+  "#sound-dai-cells":
+    const: 0
+
+  hisilicon,crg:
+    $ref: /schemas/types.yaml#/definitions/phandle
+    description:
+      Phandle of the clock generator, which the driver reaches as a syscon
+      because the two divider fields it owns there are picked from the mode and
+      cannot be expressed as a clock rate.
+
+  ports:
+    $ref: /schemas/graph.yaml#/properties/ports
+
+    properties:
+      port@0:
+        $ref: /schemas/graph.yaml#/properties/port
+        description:
+          Pixel input of the transmitter, connected to the output of the VDP
+          display channel it feeds.
+
+    required:
+      - port@0
+
+required:
+  - compatible
+  - reg
+  - reg-names
+  - clocks
+  - clock-names
+  - resets
+  - hisilicon,crg
+  - ports
+
+additionalProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/clock/hisilicon,hi3798mv200-crg.h>
+
+    hdmi: hdmi@8ce0000 {
+        compatible = "hisilicon,hi3798mv200-hdmi";
+        reg = <0x8ce0000 0x20000>, <0x8d30000 0x1000>;
+        reg-names = "tx", "phy";
+        clocks = <&crg HI3798MV200_VO_HD>, <&crg HI3798MV200_HDMITX_PHY_TMDS_CLK>;
+        clock-names = "pix", "tmds";
+        resets = <&crg 0x10c 6>, <&crg 0x10c 7>, <&crg 0x10c 9>,
+                 <&crg 0x110 5>;
+        hisilicon,crg = <&crg>;
+
+        ports {
+            #address-cells = <1>;
+            #size-cells = <0>;
+
+            port@0 {
+                reg = <0>;
+
+                hdmi_in_vdp: endpoint {
+                    remote-endpoint = <&vdp_out_hdmi>;
+                };
+            };
+        };
+    };
--- a/Documentation/devicetree/bindings/gpu/arm,mali-utgard.yaml
+++ b/Documentation/devicetree/bindings/gpu/arm,mali-utgard.yaml
@@ -27,6 +27,7 @@ properties:
               - allwinner,sun8i-h3-mali
               - allwinner,sun8i-r40-mali
               - allwinner,sun50i-a64-mali
+              - hisilicon,hi3716cv200-mali
               - rockchip,rk3036-mali
               - rockchip,rk3066-mali
               - rockchip,rk3128-mali
@@ -45,6 +46,7 @@ properties:
               - amlogic,meson-gxbb-mali
               - amlogic,meson-gxl-mali
               - hisilicon,hi3798mv100-mali
+              - hisilicon,hi3798mv200-mali
               - hisilicon,hi6220-mali
               - mediatek,mt7623-mali
               - rockchip,rk3328-mali
