 6 files changed, 3317 insertions(+)
 create mode 100644 drivers/media/platform/hisilicon/histb-vpss-regs.h
 create mode 100644 drivers/media/platform/hisilicon/histb-vpss-v4-regs.h
 create mode 100644 drivers/media/platform/hisilicon/histb-vpss-zme-coef.h
 create mode 100644 drivers/media/platform/hisilicon/histb-vpss.c

--- a/drivers/media/platform/hisilicon/Kconfig
+++ b/drivers/media/platform/hisilicon/Kconfig
@@ -39,3 +39,20 @@ config VIDEO_HISTB_JPGE
 
 	  To compile this driver as a module, choose M here: the module will be
 	  called histb-jpge.
+
+config VIDEO_HISTB_VPSS
+	tristate "HiSilicon HiSTB video processing subsystem driver"
+	depends on ARCH_HISI || COMPILE_TEST
+	depends on V4L_MEM2MEM_DRIVERS
+	depends on VIDEO_DEV
+	select VIDEOBUF2_DMA_CONTIG
+	select V4L2_MEM2MEM_DEV
+	help
+	  Support for the VPSS video processing block on HiSilicon Hi3798MV100
