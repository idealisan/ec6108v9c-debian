+	.vidioc_streamon = v4l2_m2m_ioctl_streamon,
+	.vidioc_streamoff = v4l2_m2m_ioctl_streamoff,
+	.vidioc_g_selection = histb_vpss_g_selection,
+	.vidioc_s_selection = histb_vpss_s_selection,
