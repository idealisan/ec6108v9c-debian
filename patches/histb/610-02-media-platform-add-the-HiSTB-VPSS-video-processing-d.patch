+/* SPDX-License-Identifier: GPL-2.0-only OR MIT */
+/*
+ * Register offsets and fields of the Hi3798MV100 VPSS register file.
+ *
+ * The block does not take field writes: a job is a register image in memory
+ * whose physical address is handed to the block through PNEXT and released by
+ * START, so every offset below is used on that image (and on the MMIO window,
+ * which the image mirrors).
+ */
+#ifndef __HISTB_VPSS_REGS_H
+#define __HISTB_VPSS_REGS_H
+
+#define VPSS_CTRL		0x000
+#define VPSS_CTRL_VHD_EN	BIT(1)
+#define VPSS_CTRL_UV_INVERT	BIT(5)
+#define VPSS_CTRL_IMG_PRO_MODE	GENMASK(7, 6)
+#define VPSS_CTRL_DEI_EN	BIT(9)
+#define VPSS_CTRL_PROT		GENMASK(13, 12)
+#define VPSS_CTRL_ROTATE_ANGLE	BIT(21)
+#define VPSS_CTRL_ROTATE_EN	BIT(22)
+#define VPSS_CTRL_PRE_VFIR_MODE	GENMASK(24, 23)
+#define VPSS_CTRL_PRE_VFIR_EN	BIT(25)
+#define VPSS_CTRL_VHD_LBA_EN	BIT(15)
+#define VPSS_CTRL_BFIELD_FIRST	BIT(29)
+#define VPSS_CTRL_BFIELD_MODE	BIT(30)
+#define VPSS_CTRL_BFIELD	BIT(31)
+
+#define VPSS_CTRL2		0x004
+#define VPSS_CTRL2_VHD_FORMAT	GENMASK(7, 4)
+#define VPSS_CTRL2_IN_FORMAT	GENMASK(20, 16)
+
+#define VPSS_IMGSIZE		0x008
+#define VPSS_IMGSIZE_WIDTH	GENMASK(11, 0)
+#define VPSS_IMGSIZE_HEIGHT	GENMASK(27, 16)
+
+#define VPSS_CUR_CTRL		0x00c
+#define VPSS_CUR_CTRL_HOR_OFFSET	GENMASK(17, 5)
+#define VPSS_CUR_CTRL_VER_OFFSET	GENMASK(30, 18)
+
+#define VPSS_CURYADDR		0x018
+#define VPSS_CURCADDR		0x01c
+#define VPSS_CURCRADDR		0x020
+
+#define VPSS_CURSTRIDE		0x024
+#define VPSS_CURSTRIDE_Y	GENMASK(15, 0)
+#define VPSS_CURSTRIDE_C	GENMASK(31, 16)
+
+/* The three field nodes DEI reads beside the current one. */
+#define VPSS_REF_CTRL		0x028
+#define VPSS_REFYADDR		0x034
+#define VPSS_REFCADDR		0x038
+#define VPSS_REFCRADDR		0x03c
+#define VPSS_REFSTRIDE		0x040
+#define VPSS_NXT1_CTRL		0x044
+#define VPSS_NXT1YADDR		0x050
+#define VPSS_NXT1CADDR		0x054
+#define VPSS_NXT1CRADDR		0x058
+#define VPSS_NXT1STRIDE		0x05c
+#define VPSS_NXT2_CTRL		0x060
+#define VPSS_NXT2YADDR		0x06c
+#define VPSS_NXT2CADDR		0x070
+#define VPSS_NXT2CRADDR		0x074
+#define VPSS_NXT2STRIDE		0x078
+#define VPSS_FIELDSTRIDE_Y	GENMASK(15, 0)
+#define VPSS_FIELDSTRIDE_C	GENMASK(31, 16)
+
+/* Motion history: the block reads one plane and writes the next. */
+#define VPSS_STRADDR		0x098
+#define VPSS_STWADDR		0x09c
+#define VPSS_STSTRIDE		0x0a0
+#define VPSS_STSTRIDE_VAL	GENMASK(19, 0)
+#define VPSS_DEI_ADDR		0x240
+
+#define VPSS_VHDCTRL		0x0a4
+#define VPSS_VHDCTRL_MIRROR	BIT(4)
+#define VPSS_VHDCTRL_FLIP	BIT(5)
+#define VPSS_VHDCTRL_UV_INVERT	BIT(8)
+
+#define VPSS_VHDSIZE		0x0a8
+#define VPSS_VHDSIZE_WIDTH	GENMASK(12, 0)
+#define VPSS_VHDSIZE_HEIGHT	GENMASK(28, 16)
+
+#define VPSS_VHDYADDR		0x0b4
+#define VPSS_VHDCADDR		0x0b8
+
+#define VPSS_VHDSTRIDE		0x0bc
+#define VPSS_VHDSTRIDE_Y	GENMASK(15, 0)
+#define VPSS_VHDSTRIDE_C	GENMASK(31, 16)
+
+#define VPSS_INCROP_POS		0x114
+#define VPSS_INCROP_SIZE	0x118
+#define VPSS_CROP_EN		BIT(31)
+
+#define VPSS_VHDLBA_VFPOS	0x288
+#define VPSS_VHDLBA_BK		0x290
+#define VPSS_VHDCROP_POS	0x124
+#define VPSS_VHDCROP_SIZE	0x128
+#define VPSS_VHDCROP_X		GENMASK(11, 0)
+#define VPSS_VHDCROP_Y		GENMASK(27, 16)
+#define VPSS_VHDCROP_WIDTH	GENMASK(11, 0)
+#define VPSS_VHDCROP_HEIGHT	GENMASK(27, 16)
+
+#define VPSS_VHD_HLOFFSET	0x164
+#define VPSS_VHD_HCOFFSET	0x168
+#define VPSS_VHD_HSP		0x160
+#define VPSS_VHD_VSP		0x16c
+#define VPSS_VHD_VSR		0x170
+#define VPSS_VHD_VOFFSET	0x174
+#define VPSS_VHD_ZMEORESO	0x178
+#define VPSS_VHD_ZMEIRESO	0x17c
+#define VPSS_VHD_ZME_LHADDR	0x210
+#define VPSS_VHD_ZME_LVADDR	0x214
+#define VPSS_VHD_ZME_CHADDR	0x218
+#define VPSS_VHD_ZME_CVADDR	0x21c
+
+/* The sharpen filters read their phase table 256 bytes into the scaler's. */
+#define VPSS_VHD_LTI_CTRL	0x180
+#define VPSS_LTI_CTRL_LHPASS_COEF4	GENMASK(7, 0)
+#define VPSS_LTI_CTRL_LMIXING_RATIO	GENMASK(15, 8)
+#define VPSS_LTI_CTRL_LGAIN_RATIO	GENMASK(27, 16)
+#define VPSS_LTI_CTRL_LTI_EN		BIT(31)
+#define VPSS_VHD_LHPASS_COEF	0x184
+#define VPSS_VHD_LTI_THD	0x188
+#define VPSS_LTI_THD_LOVER_SWING	GENMASK(9, 0)
+#define VPSS_LTI_THD_LUNDER_SWING	GENMASK(19, 10)
+#define VPSS_LTI_THD_LCORING_THD	GENMASK(31, 20)
+#define VPSS_VHD_LHFREQ_THD	0x18c
+#define VPSS_VHD_LGAIN_COEF	0x190
+#define VPSS_VHD_CTI_CTRL	0x194
+#define VPSS_CTI_CTRL_CMIXING_RATIO	GENMASK(15, 8)
+#define VPSS_CTI_CTRL_CGAIN_RATIO	GENMASK(27, 16)
+#define VPSS_CTI_CTRL_CTI_EN		BIT(31)
+#define VPSS_VHD_CHPASS_COEF	0x198
+#define VPSS_VHD_CTI_THD	0x19c
+#define VPSS_CTI_THD_COVER_SWING	GENMASK(9, 0)
+#define VPSS_CTI_THD_CUNDER_SWING	GENMASK(19, 10)
+#define VPSS_CTI_THD_CCORING_THD	GENMASK(31, 20)
+#define VPSS_MSC_H_MSSC		BIT(31)
+#define VPSS_MSC_H_CSSC		BIT(30)
+#define VPSS_MSC_H_LFIR		BIT(26)
+#define VPSS_MSC_H_CFIR		BIT(25)
+#define VPSS_MSC_H_RATIO		GENMASK(23, 0)
+#define VPSS_MSC_V_MSSC		BIT(31)
+#define VPSS_MSC_V_CSSC		BIT(30)
+#define VPSS_MSC_V_LFIR		BIT(24)
+#define VPSS_MSC_V_CFIR		BIT(23)
+#define VPSS_MSC_V_RATIO		GENMASK(15, 0)
+#define VPSS_ZME_IN_FMT		GENMASK(20, 19)	/* 0: 4:2:2, 1: 4:2:0 */
+#define VPSS_ZME_OUT_FMT	GENMASK(22, 21)
+#define VPSS_ZME_ORESO_W	GENMASK(11, 0)
+#define VPSS_ZME_ORESO_H	GENMASK(23, 12)
+#define VPSS_ZME_IRESO_W	GENMASK(11, 0)
+#define VPSS_ZME_IRESO_H	GENMASK(23, 12)
+
+#define VPSS_DIECTRL		0x1000
+#define VPSS_DIECTRL_LMODE	GENMASK(27, 26)
+#define VPSS_DIECTRL_CMODE	GENMASK(25, 24)
+
+#define VPSS_INTMASK		0x1fc
+#define VPSS_PNEXT		0x2fc
+#define VPSS_START		0x300
+#define VPSS_INTSTATE		0x304
+#define VPSS_INTSTATE_EOF	BIT(0)		/* raw_eof */
+#define VPSS_INTSTATE_TIMEOUT	BIT(1)		/* raw_timeout: the block's own limit */
+#define VPSS_INTSTATE_BUS_W	BIT(2)		/* write path rejected by the bus */
+#define VPSS_INTSTATE_DONE	BIT(3)		/* raw_eof_end */
+#define VPSS_INTSTATE_VHD_TUNL	BIT(4)		/* output tunnel overrun */
+#define VPSS_INTSTATE_STR_TUNL	BIT(6)		/* stride tunnel overrun */
+#define VPSS_INTSTATE_DCMP	BIT(7)		/* tile decompress error */
+#define VPSS_INTSTATE_BUS_R	BIT(10)		/* read path rejected by the bus */
+/* The vendor's U_VPSS_INTSTATE: everything but the two end-of-frame bits */
+#define VPSS_INTSTATE_ERRORS	(VPSS_INTSTATE_TIMEOUT | VPSS_INTSTATE_BUS_W | \
+				 VPSS_INTSTATE_VHD_TUNL | VPSS_INTSTATE_STR_TUNL | \
+				 VPSS_INTSTATE_DCMP | VPSS_INTSTATE_BUS_R)
+#define VPSS_INTCLR		0x308
+#define VPSS_MISCELLANEOUS	0x314
+#define VPSS_TIMEOUT		0x31c
+#define VPSS_VERSION		0x330		/* constant id word; 0 while the block
+						 * has no clock or does not decode
+						 */
+
+/* Register images are one contiguous block; the deepest field is at 0x5058. */
+#define VPSS_REG_IMAGE_SIZE	0x6000
+
+/* One phase table set per plane and axis: 256 bytes of scaler taps, then
+ * 256 bytes of sharpen taps.
+ */
+#define VPSS_COEF_BLOCK		512
+#define VPSS_COEF_BYTES		(4 * VPSS_COEF_BLOCK)
+
+/* Pre-scaler modes for turning one field into a frame. */
+#define VPSS_PREZME_DISABLE	0
+#define VPSS_PREZME_2X		1
+#define VPSS_PREZME_VFIELD	4
+
+#endif /* __HISTB_VPSS_REGS_H */
--- /dev/null
+++ b/drivers/media/platform/hisilicon/histb-vpss-v4-regs.h
@@ -0,0 +1,226 @@
+/* SPDX-License-Identifier: GPL-2.0-only OR MIT */
+/*
+ * Offsets and fields of the vpss_v4_0 generation's control-plane block, the one
+ * the Hi3798MV200H carries.
+ *
+ * Three shapes differ from the Hi3798MV100 file this driver was written
+ * against. The constant id word moved from 0x330 to 0x340, and 0x330 there is
+ * the end-of-frame counter. The interrupt mask moved from 0x1fc to 0x324. And
+ * the geometry of a job is no longer a flat set of cells at the head of the
+ * image: the memory accessor takes it through one descriptor per stream
+ * channel, the picture being read at VPSS4_CF_CTRL and the picture this port
+ * writes at VPSS4_OUT0_CTRL. The image is still handed over through the same
+ * PNEXT/START pair.
+ *
+ * The word deltas below are the ones the vendor's own read- and write-channel
+ * accessors use, and the cell addresses are those accessors' anchors in the
+ * vendor's register descriptor table. The reset values that place this part
+ * in the mv310 lineage, rather than in the mv200 header, are the ones below.
+ */
+#ifndef __HISTB_VPSS_V4_REGS_H
+#define __HISTB_VPSS_V4_REGS_H
+#define VPSS4_CTRL		0x000
+#define VPSS4_CTRL_VHD0_EN	BIT(3)		/* the one output port this driver uses */
+#define VPSS4_CTRL3		0x008
+#define VPSS4_CTRL3_ZME_VHD0_EN	BIT(3)
+#define VPSS4_CTRL3_VHD0_CROP_EN BIT(17)
+/* Over-read sizes and the four filter-table pointers of the scaler. The vendor
+ * fills this word from the size the port produces, and the window answers zero
+ * for it even when the job image carries a size, so its readback is not
+ * evidence of what the block
+ * used. A job whose image leaves this cell at zero completes having written
+ * only the first sample of each plane, so the image carries the produced size\.
+ */
+#define VPSS4_ZMEORESO		0x18
+#define VPSS4_ZME_OH		GENMASK(28, 16)
+#define VPSS4_ZME_OW		GENMASK(12, 0)
+#define VPSS4_ZME_LHADDR	0x1c
+#define VPSS4_ZME_LVADDR	0x20
+#define VPSS4_ZME_CHADDR	0x24
+#define VPSS4_ZME_CVADDR	0x28
+/*
+ * Per-stream bypass bits, one for every channel the accessor could fetch or
+ * dump. The window answers 0 here after reset, the vendor's own layer has no
+ * caller that writes either word, and which stream is served is decided by each
+ * channel descriptor's enable bit -- so the job image leaves both at 0.
+ */
+#define VPSS4_RCH_BYPASS	0x010
+#define VPSS4_WCH_BYPASS	0x014
+/*
+ * The parameter regions of the sub-blocks are not inside the words the accessor
+ * fetches with the node itself: each of these cells holds the address of the
+ * same-named region of this very image, the way the vendor fills them for every
+ * node. A pass-through does not fault
+ * because of these cells, but a node with a null parameter pointer is not
+ * a shape the block is used to.
+ */
+#define VPSS4_TNR_ADDR		0x2c
+#define VPSS4_SNR_ADDR		0x34
+#define VPSS4_ZME_ADDR		0x3c
+#define VPSS4_DEI_ADDR		0x40
+#define VPSS4_HDR_ADDR		0x44
+#define VPSS4_TNR_PARA		0x3800		/* VPSS_TNR_CONTRL */
+#define VPSS4_SNR_PARA		0x2100		/* VPSS_DB_CTRL */
+#define VPSS4_ZME_PARA		0x2000		/* VPSS_VHD0_HSP */
+#define VPSS4_DEI_PARA		0x1000		/* VPSS_DIECTRL */
+
+/*
+ * The scaler's own cells, all inside the ZME parameter region. The ratio fields
+ * carry the vendor's precisions: 20 fractional bits horizontally, 12
+ * vertically, so 1:1 is 0x100000 and 0x1000.
+ */
+#define VPSS4_ZME_HSP		(VPSS4_ZME_PARA + 0x00)
+#define VPSS4_ZME_HCOFFSET	(VPSS4_ZME_PARA + 0x08)
+#define VPSS4_ZME_VSP		(VPSS4_ZME_PARA + 0x0c)
+#define VPSS4_ZME_VSR		(VPSS4_ZME_PARA + 0x10)
+#define VPSS4_ZME_H_RATIO	GENMASK(23, 0)
+#define VPSS4_ZME_HFIR_ORDER	BIT(24)
+#define VPSS4_ZME_H_CHFIR	BIT(25)
+#define VPSS4_ZME_H_LFIR	BIT(26)
+#define VPSS4_ZME_H_CHMID	BIT(28)
+#define VPSS4_ZME_H_LMID	BIT(29)
+#define VPSS4_ZME_H_CHMSC	BIT(30)
+#define VPSS4_ZME_H_LMSC	BIT(31)
+#define VPSS4_ZME_V_OUT_FMT	GENMASK(22, 21)	/* 1 = 4:2:0 semi, 0 = 4:2:2 */
+#define VPSS4_ZME_V_CHFIR	BIT(23)
+#define VPSS4_ZME_V_LFIR	BIT(24)
+#define VPSS4_ZME_V_CHMID	BIT(28)
+#define VPSS4_ZME_V_LMID	BIT(29)
+#define VPSS4_ZME_V_CHMSC	BIT(30)
+#define VPSS4_ZME_V_LMSC	BIT(31)
+#define VPSS4_ZME_V_RATIO	GENMASK(15, 0)
+#define VPSS4_ZME_HR_PREC	20
+#define VPSS4_ZME_VR_PREC	12
+/* The memory accessor's own request shaping, and the statistics sink. */
+#define VPSS4_CHN_CFG_CTRL	0x5000
+#define VPSS4_CHN_IMG_PRO_MODE	GENMASK(3, 2)
+/* The read channel of the picture being input. */
+#define VPSS4_CF_CTRL		0x5080
+#define VPSS4_CF_FORMAT		GENMASK(3, 0)
+#define VPSS4_CF_TYPE		GENMASK(7, 4)
+#define VPSS4_CF_ORDER		GENMASK(11, 8)
+#define VPSS4_CF_BITW		GENMASK(15, 12)
+#define VPSS4_CF_DCMP_MODE	GENMASK(19, 16)
+#define VPSS4_CF_UV_INVERT	BIT(20)
+#define VPSS4_CF_MIRROR		BIT(21)
+#define VPSS4_CF_FLIP		BIT(22)
+/*
+ * Which read the channel performs. The vendor's default for a whole frame is
+ * progressive, whose value is 1: 0 is the interlaced read, whose field and
+ * head tables this driver has no reason to fill.
+ */
+#define VPSS4_CF_LM_RMODE	GENMASK(25, 23)
+#define VPSS4_LM_PROGRESSIVE	1
+#define VPSS4_LM_INTERLACE	0
+#define VPSS4_CF_EN		BIT(31)
+/*
+ * b_bypass, h_bypass and d_bypass of the accessor's read descriptor. The
+ * vendor drives all three from a single bMmuBypass flag of its own, which is
+ * what a picture in plain coherent memory needs here.
+ */
+#define VPSS4_CF_TILE_BYPASS	(BIT(26) | BIT(27) | BIT(28))
+#define VPSS4_CF_SIZE		0x5088
+#define VPSS4_CF_SIZE_WIDTH	GENMASK(11, 0)
+#define VPSS4_CF_SIZE_HEIGHT	GENMASK(27, 16)
+#define VPSS4_CF_OFFSET		0x508c
+#define VPSS4_CF_OFFSET_HOR	GENMASK(11, 0)
+#define VPSS4_CF_OFFSET_VER	GENMASK(27, 16)
+#define VPSS4_CF_YADDR_H	0x5090
+#define VPSS4_CF_YADDR_L	0x5094
+#define VPSS4_CF_CADDR_H	0x5098
+#define VPSS4_CF_CADDR_L	0x509c
+#define VPSS4_CF_STRIDE		0x50c8
+#define VPSS4_CF_STRIDE_Y	GENMASK(15, 0)
+#define VPSS4_CF_STRIDE_C	GENMASK(31, 16)
+/* The write channel of port zero. */
+#define VPSS4_OUT0_CTRL		0x5800
+#define VPSS4_OUT0_FORMAT	GENMASK(3, 0)
+#define VPSS4_OUT0_TYPE		GENMASK(7, 4)
+#define VPSS4_OUT0_BITW		GENMASK(11, 8)
+#define VPSS4_OUT0_UV_INVERT	BIT(16)
+#define VPSS4_OUT0_MIRROR	BIT(17)
+#define VPSS4_OUT0_FLIP		BIT(18)
+#define VPSS4_OUT0_DITHER_EN	BIT(19)
+#define VPSS4_OUT0_LM_RMODE	GENMASK(25, 23)
+/* The vendor's frame layer sets both bypass bits of a channel from one
+ * flag, so a channel that talks to plain addresses carries the pair;
+ * leaving one out is not a "no change" value.
+ */
+#define VPSS4_OUT0_H_BYPASS	BIT(28)
+#define VPSS4_OUT0_D_BYPASS	BIT(29)
+#define VPSS4_OUT0_EN		BIT(31)
+#define VPSS4_OUT0_OFFSET	0x5804
+#define VPSS4_OUT0_YADDR_H	0x5808
+#define VPSS4_OUT0_YADDR_L	0x580c
+#define VPSS4_OUT0_CADDR_H	0x5810
+#define VPSS4_OUT0_CADDR_L	0x5814
+#define VPSS4_OUT0_STRIDE	0x5818
+#define VPSS4_OUT0_STRIDE_Y	GENMASK(15, 0)
+#define VPSS4_OUT0_STRIDE_C	GENMASK(31, 16)
+#define VPSS4_OUT0_SIZE		0x5830
+#define VPSS4_OUT0_SIZE_WIDTH	GENMASK(15, 0)
+#define VPSS4_OUT0_SIZE_HEIGHT	GENMASK(31, 16)
+/* Formats, as the accessor's own code lists them. */
+#define VPSS4_FMT_YUV420SP	0
+#define VPSS4_FMT_YUV422SP	1
+#define VPSS4_FMT_YUV420P	2
+#define VPSS4_FMT_YUV422P	3
+#define VPSS4_FMT_UYVY		7
+#define VPSS4_TYPE_LINEAR	0
+#define VPSS4_BITW_8		0
+#define VPSS4_NODEID		0x2f8
+#define VPSS4_PNEXT		0x2fc
+#define VPSS4_START_RUN		BIT(0)
+#define VPSS4_INTSTATE_EOF	BIT(0)		/* one node finished */
