From ae1e9308a2b5a59603eb737f83909917dfcc504d Mon Sep 17 00:00:00 2001
From: David Yang <mmyangfl@gmail.com>
Date: Tue, 27 Oct 2026 17:43:53 +0800
Subject: [PATCH 1/4] dt-bindings: media: document the Hi3716CV200 IR block

The Hi3716CV200 IR receiver has no entry in the binding. Its register
map and its gate (SYS_CTRL + 0x48, bit 4 enable, bit 5 reset) match the
hix5hd2 data. Add the compatible to the schema.

Signed-off-by: David Yang <mmyangfl@gmail.com>
---
 .../devicetree/bindings/media/hisilicon,hix5hd2-ir.yaml          | 1 +
 1 file changed, 1 insertion(+)

--- a/Documentation/devicetree/bindings/media/hisilicon,hix5hd2-ir.yaml
+++ b/Documentation/devicetree/bindings/media/hisilicon,hix5hd2-ir.yaml
@@ -18,6 +18,7 @@ properties:
       - enum:
           - hisilicon,hix5hd2-ir
           - hisilicon,hi3796cv300-ir
+          - hisilicon,hi3716cv200-ir
 
   reg:
     maxItems: 1
