From d1f968f4c593530f881254b7a8ef8096e39a5e10 Mon Sep 17 00:00:00 2001
From: David Yang <mmyangfl@gmail.com>
Date: Tue, 27 Oct 2026 06:41:30 +0800
Subject: [PATCH 3/3] net: mdio: hisi-femac: take the MDIO clock optionally

hi3798mv200 feeds the PHY-side clock from the MAC node and leaves the
cell out of its mdio subnode, so a mandatory devm_clk_get() fails there
with -ENOENT and the mdio bus never registers.

Keep the clock where a board declares it and take it optionally
elsewhere.

Signed-off-by: David Yang <mmyangfl@gmail.com>
---
 drivers/net/mdio/mdio-hisi-femac.c | 19 ++++++++-----------
 1 file changed, 8 insertions(+), 11 deletions(-)

--- a/drivers/net/mdio/mdio-hisi-femac.c
+++ b/drivers/net/mdio/mdio-hisi-femac.c
@@ -21,8 +21,8 @@
 #define BIT_WR_DATA_OFFSET	16
 
 struct hisi_femac_mdio_data {
-	struct clk *clk;
 	void __iomem *membase;
+	struct clk *clk;
 };
 
 static int hisi_femac_mdio_wait_ready(struct hisi_femac_mdio_data *data)
@@ -93,26 +93,25 @@ static int hisi_femac_mdio_probe(struct
 		goto err_out_free_mdiobus;
 	}
 
-	data->clk = devm_clk_get(&pdev->dev, NULL);
+	/*
+	 * hi3798mv100 keeps the PHY-side clock on this node; hi3798mv200 has it in
+	 * the MAC node instead and writes no cell here, so it is optional. The bus
+	 * stops answering its FINISH poll without it on the mv100 silicon.
+	 */
+	data->clk = devm_clk_get_optional_enabled(&pdev->dev, NULL);
 	if (IS_ERR(data->clk)) {
 		ret = PTR_ERR(data->clk);
 		goto err_out_free_mdiobus;
 	}
 
-	ret = clk_prepare_enable(data->clk);
-	if (ret)
-		goto err_out_free_mdiobus;
-
 	ret = of_mdiobus_register(bus, np);
 	if (ret)
-		goto err_out_disable_clk;
+		goto err_out_free_mdiobus;
 
 	platform_set_drvdata(pdev, bus);
 
 	return 0;
 
-err_out_disable_clk:
-	clk_disable_unprepare(data->clk);
 err_out_free_mdiobus:
 	mdiobus_free(bus);
 	return ret;
@@ -121,10 +120,8 @@ err_out_free_mdiobus:
 static void hisi_femac_mdio_remove(struct platform_device *pdev)
 {
 	struct mii_bus *bus = platform_get_drvdata(pdev);
-	struct hisi_femac_mdio_data *data = bus->priv;
 
 	mdiobus_unregister(bus);
-	clk_disable_unprepare(data->clk);
 	mdiobus_free(bus);
 }
 
