From 11b5db4ed1caadeef17605e3b5693c9735db9ee2 Mon Sep 17 00:00:00 2001
From: David Yang <mmyangfl@gmail.com>
Date: Tue, 3 Nov 2026 14:38:01 +0800
Subject: [PATCH 1/3] dt-bindings: media: add the HiSTB VEDU encoder schema

The VEDU encoder family of the HiSTB set-top-box SoCs has no mainline
driver. Add the codec schema that describes its encoder nodes: the
hi3716cv200, hi3798mv100 and hi3798mv200 compatibles, with a register
window, one interrupt, clocks, resets and the memory-region the buffer
pools are allocated from.

Signed-off-by: David Yang <mmyangfl@gmail.com>
---
 .../media/hisilicon,hi3716cv200-venc.yaml     | 152 ++++++++++++++++++
 1 file changed, 152 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/media/hisilicon,hi3716cv200-venc.yaml

--- /dev/null
+++ b/Documentation/devicetree/bindings/media/hisilicon,hi3716cv200-venc.yaml
@@ -0,0 +1,152 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/media/hisilicon,hi3716cv200-venc.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: HiSilicon HiSTB H.264 video encoder (VEDU)
+
+maintainers:
+  - David Yang <mmyangfl@gmail.com>
+
+description: |-
+  The video encoder family of the HiSilicon HiSTB set-top-box SoCs.  Unlike the
+  stateless decoders of the family it is a coding engine: it takes raw pictures
+  and produces network abstraction layer data, so it keeps reconstruction
+  buffers of its own and a ring buffer for the coded stream.
+
+  Two generations are covered, numbered by the hardware generation the
+  driver backend serves (not by the vendor's venc_vX.Y layer, which counts
+  these parts the other way round).  The v2 VEDU of hi3716cv200 and
+  hi3798mv100 -- the part the vendor calls V2R8, built through its
+  venc_v1.0 layer -- is programmed by register writes and a 64-byte packet
+  ring and codes IDR pictures; on the Hi3798MV100 build the vendor names
+  its register file s5v100 while the Hi3716CV200 build names r008, and the
+  two decoded views agree on every offset (193 named registers, no offset
+  differing).  The v5 V500 of hi3798mv200h (HiVEDUV500R001, the venc_v2.0
+  layer) is programmed through a 4096-byte, 64-byte aligned
+  command image in DMA memory whose physical address is written to register
+  0x118 before each launch; it owns a memory-management unit and codes P
+  pictures as well.
+
+properties:
+  compatible:
+    enum:
+      - hisilicon,hi3716cv200-venc
+      - hisilicon,hi3798mv100-venc
+      - hisilicon,hi3798mv200-venc
+
+  reg:
+    maxItems: 1
+    description: |-
+      Register window. The vendor driver maps the whole 64 KiB it needs, which
+      covers the quantisation scale list at 0x5e00; on the v2 part the memory
+      management unit sits at 0xf000 of the same window.
+
+  interrupts:
+    maxItems: 1
+
+  clocks:
+    minItems: 1
+    maxItems: 2
+
+  clock-names:
+    minItems: 1
+    maxItems: 2
+    items:
+      enum:
+        - venc
+        - venc-axi
+
+  resets:
+    maxItems: 1
+
+  reset-names:
+    items:
+      - const: venc
+
+  memory-region:
+    maxItems: 1
+    description: |-
+      Phandle to a reserved memory region to allocate buffers from. The v1
+      block is programmed with single physical addresses and has no MMU here,
+      so its picture, reconstruction and stream buffers have to be physically
+      contiguous. Without this property they are taken from the default CMA
+      area.
+
+required:
+  - compatible
+  - reg
+  - interrupts
+
+additionalProperties: false
+
+allOf:
+  - if:
+      properties:
+        compatible:
+          contains:
+            enum:
+              - hisilicon,hi3716cv200-venc
+              - hisilicon,hi3798mv100-venc
+    then:
+      properties:
+        clocks:
+          minItems: 1
+          maxItems: 1
+        clock-names:
+          items:
+            - const: venc
+        reset-names:
+          items:
+            - const: venc
+  - if:
+      properties:
+        compatible:
+          contains:
+            const: hisilicon,hi3798mv200-venc
+    then:
+      required:
+        - clocks
+      properties:
+        clocks:
+          minItems: 1
+          maxItems: 2
+        clock-names:
+          minItems: 1
+          maxItems: 2
+          items:
+            enum:
+              - venc
+              - venc-axi
+
+examples:
+  - |
+    #include <dt-bindings/interrupt-controller/arm-gic.h>
+    #include <dt-bindings/clock/hisilicon,hi3798mv100-crg.h>
+
+    video-encoder@8c80000 {
+        compatible = "hisilicon,hi3798mv100-venc";
+        reg = <0x8c80000 0x10000>;
+        interrupts = <GIC_SPI 101 IRQ_TYPE_LEVEL_HIGH>;
+        clocks = <&crg HI3798MV100_VENC_CLK>;
+        clock-names = "venc";
+        resets = <&crg 0x8c 4>;
+        reset-names = "venc";
+    };
+
+  - |
+    #include <dt-bindings/clock/hisilicon,hi3798mv200-crg.h>
+    #include <dt-bindings/interrupt-controller/arm-gic.h>
+
+    video-encoder@8c80000 {
+        compatible = "hisilicon,hi3798mv200-venc";
+        reg = <0x8c80000 0x10000>;
+        interrupts = <GIC_SPI 101 IRQ_TYPE_LEVEL_HIGH>;
+        clocks = <&crg HI3798MV200_VENV_CLK>,
+                 <&crg HI3798MV200_VENV_AXI_CLK>;
+        clock-names = "venc", "venc-axi";
+        resets = <&crg 0x8c 4>;
+        reset-names = "venc";
+    };
+...
