+/* ------------------------------------------------------------------ */
+/* File handles and device                                             */
+/* ------------------------------------------------------------------ */
+
+static int histb_jpge_queue_init(void *priv, struct vb2_queue *src_vq,
+				 struct vb2_queue *dst_vq);
+
+static int histb_jpge_open(struct file *file)
+{
+	struct histb_jpge *jpge = video_drvdata(file);
+	struct histb_jpge_ctx *ctx;
+	struct v4l2_ctrl *quality, *restart;
+	int ret;
+
+	ctx = kzalloc_obj(*ctx);
+	if (!ctx)
+		return -ENOMEM;
+
+	ctx->jpge = jpge;
+	/* Both queues have one format each; the geometry is filled in by S_FMT. */
+	ctx->out_q.fourcc = histb_jpge_out_fmts[0];
+	ctx->cap_q.fourcc = V4L2_PIX_FMT_JPEG;
+
+	v4l2_fh_init(&ctx->fh, video_devdata(file));
+	v4l2_ctrl_handler_init(&ctx->ctrl_hdl, 2);
+	/* The block takes the same quality scale as the reference's Qlevel. */
+	quality = v4l2_ctrl_new_std(&ctx->ctrl_hdl, NULL,
+				    V4L2_CID_JPEG_COMPRESSION_QUALITY, 1, 99, 1,
+				    JPGE_QUALITY_DEFAULT);
+	/* Zero keeps the stream free of DRI and RST markers. */
+	restart = v4l2_ctrl_new_std(&ctx->ctrl_hdl, NULL,
+				    V4L2_CID_JPEG_RESTART_INTERVAL, 0, 65535, 1,
+				    0);
+	if (ctx->ctrl_hdl.error) {
+		ret = ctx->ctrl_hdl.error;
+		v4l2_ctrl_handler_free(&ctx->ctrl_hdl);
+		v4l2_fh_exit(&ctx->fh);
+		kfree(ctx);
+		return ret;
+	}
+	ctx->quality = quality;
+	ctx->restart = restart;
+	ctx->fh.ctrl_handler = &ctx->ctrl_hdl;
+
+	ctx->fh.m2m_ctx = v4l2_m2m_ctx_init(jpge->m2m_dev, ctx,
+					    histb_jpge_queue_init);
+	if (IS_ERR(ctx->fh.m2m_ctx)) {
+		ret = PTR_ERR(ctx->fh.m2m_ctx);
+		v4l2_ctrl_handler_free(&ctx->ctrl_hdl);
+		v4l2_fh_exit(&ctx->fh);
+		kfree(ctx);
+		return ret;
+	}
+
+	v4l2_fh_add(&ctx->fh, file);
+
+	return 0;
+}
+
+static int histb_jpge_release(struct file *file)
+{
+	struct histb_jpge *jpge = video_drvdata(file);
+	struct v4l2_fh *fh = file->private_data;
+	struct histb_jpge_ctx *ctx = container_of(fh, struct histb_jpge_ctx, fh);
+
+	mutex_lock(&jpge->vdev_lock);
+	v4l2_fh_del(fh, file);
+	v4l2_m2m_ctx_release(ctx->fh.m2m_ctx);
+	v4l2_fh_exit(fh);
+	v4l2_ctrl_handler_free(&ctx->ctrl_hdl);
+	if (ctx->stream)
+		dma_free_coherent(jpge->memdev, ctx->stream_alloc, ctx->stream,
+				  ctx->stream_dma);
+	mutex_unlock(&jpge->vdev_lock);
+	kfree(ctx);
+
+	return 0;
+}
+
+static const struct v4l2_file_operations histb_jpge_fops = {
+	.owner = THIS_MODULE,
+	.open = histb_jpge_open,
+	.release = histb_jpge_release,
+	.poll = v4l2_m2m_fop_poll,
+	.unlocked_ioctl = video_ioctl2,
+	.mmap = v4l2_m2m_fop_mmap,
+};
+
+static int histb_jpge_queue_init(void *priv, struct vb2_queue *src_vq,
+				 struct vb2_queue *dst_vq)
+{
+	struct histb_jpge_ctx *ctx = priv;
+	unsigned int i;
+	struct vb2_queue *vq[2];
+	int ret;
+
+	/* Both queues hold a full picture per buffer, so nothing is shared. */
+	vq[0] = src_vq;
+	vq[1] = dst_vq;
+	for (i = 0; i < ARRAY_SIZE(vq); i++) {
+		vq[i]->io_modes = VB2_MMAP | VB2_DMABUF;
+		vq[i]->drv_priv = ctx;
+		vq[i]->ops = &histb_jpge_vb2_ops;
+		vq[i]->mem_ops = &vb2_vmalloc_memops;
+		vq[i]->buf_struct_size = sizeof(struct v4l2_m2m_buffer);
+		vq[i]->min_queued_buffers = 1;
+		vq[i]->timestamp_flags = V4L2_BUF_FLAG_TIMESTAMP_COPY;
+		vq[i]->lock = &ctx->jpge->vdev_lock;
+		vq[i]->dev = ctx->jpge->memdev;
+		/*
+		 * Both planes are copied in the kernel, so a vmalloc queue is
+		 * enough. It also keeps a dmabuf import usable: dma-contig hands
+		 * the run path a NULL vaddr when the exporter keeps no mapping.
+		 */
+	}
+	src_vq->type = V4L2_BUF_TYPE_VIDEO_OUTPUT;
+	dst_vq->type = V4L2_BUF_TYPE_VIDEO_CAPTURE;
+
+	ret = vb2_queue_init(src_vq);
+	if (ret)
+		return ret;
+
+	return vb2_queue_init(dst_vq);
+}
+
+/* ------------------------------------------------------------------ */
+/* Platform device                                                     */
+/* ------------------------------------------------------------------ */
+
+static const struct of_device_id histb_jpge_of_match[] = {
+	{ .compatible = "hisilicon,hi3798mv100-jpge" },
+	{ .compatible = "hisilicon,hi3716cv200-jpge" },
+	{ /* sentinel */ }
+};
+MODULE_DEVICE_TABLE(of, histb_jpge_of_match);
+
+static void histb_jpge_v4l2_release(struct v4l2_device *v4l2_dev)
+{
+	struct histb_jpge *jpge = container_of(v4l2_dev, struct histb_jpge, v4l2_dev);
+
+	v4l2_device_unregister(v4l2_dev);
+	if (jpge->m2m_dev)
+		v4l2_m2m_release(jpge->m2m_dev);
+	put_device(jpge->memdev);
+	kfree(jpge);
+}
+
+static void histb_jpge_v4l2_put(void *data)
+{
+	struct histb_jpge *jpge = data;
+
+	v4l2_device_put(&jpge->v4l2_dev);
+}
+
+static int histb_jpge_probe(struct platform_device *pdev)
+{
+	struct platform_device *mem;
+	struct histb_jpge *jpge;
+	struct video_device *vdev;
+	int ret, irq;
+
+	jpge = kzalloc_obj(*jpge);
+	if (!jpge)
+		return -ENOMEM;
+
+	ret = v4l2_device_register(&pdev->dev, &jpge->v4l2_dev);
+	if (ret) {
+		kfree(jpge);
+		return ret;
+	}
+	jpge->v4l2_dev.release = histb_jpge_v4l2_release;
+	/* Keep the binding reference until all other devres have unwound. */
+	ret = devm_add_action_or_reset(&pdev->dev, histb_jpge_v4l2_put, jpge);
+	if (ret)
+		return ret;
+
+	jpge->dev = &pdev->dev;
+	platform_set_drvdata(pdev, jpge);
+	mutex_init(&jpge->hw_lock);
+	mutex_init(&jpge->vdev_lock);
+	init_waitqueue_head(&jpge->done);
+
+	jpge->regs = devm_platform_ioremap_resource(pdev, 0);
+	if (IS_ERR(jpge->regs))
+		return PTR_ERR(jpge->regs);
+
+	jpge->clk = devm_clk_get(&pdev->dev, "jpge");
+	if (IS_ERR(jpge->clk))
+		return dev_err_probe(&pdev->dev, PTR_ERR(jpge->clk),
+				     "no clock\n");
+
+	ret = clk_prepare_enable(jpge->clk);
+	if (ret)
+		return dev_err_probe(&pdev->dev, ret, "cannot enable clock\n");
+
+	jpge->rst = devm_reset_control_get_exclusive(&pdev->dev, "jpge");
+	if (IS_ERR(jpge->rst)) {
+		ret = PTR_ERR(jpge->rst);
+		goto err_clk;
+	}
+
+	irq = platform_get_irq(pdev, 0);
+	if (irq < 0) {
+		ret = irq;
+		goto err_clk;
+	}
+
+	/* Exported buffers retain the allocator across unbind and rebind. */
+	mem = platform_device_alloc("histb-jpge-dma", PLATFORM_DEVID_NONE);
+	if (!mem) {
+		ret = -ENOMEM;
+		goto err_clk;
+	}
+	jpge->memdev = &mem->dev;
+	platform_device_set_of_node(mem, pdev->dev.of_node);
+	mem->dev.coherent_dma_mask = DMA_BIT_MASK(32);
+	ret = of_dma_configure(&mem->dev, mem->dev.of_node, true);
+	if (ret) {
+		dev_err_probe(&pdev->dev, ret, "failed to configure DMA\n");
+		goto err_clk;
+	}
+
+	/* A DT without "memory-region" keeps using the default CMA area. */
+	ret = devm_of_reserved_mem_device_init(&mem->dev);
+	if (ret && ret != -ENODEV) {
+		dev_err(&pdev->dev, "failed to bind reserved memory\n");
+		goto err_clk;
+	}
+
+	ret = dma_set_mask_and_coherent(&pdev->dev, DMA_BIT_MASK(32));
+	if (ret) {
+		dev_err(&pdev->dev, "failed to set DMA mask\n");
+		goto err_clk;
+	}
+
+	jpge->m2m_dev = v4l2_m2m_init(&histb_jpge_m2m_ops);
+	if (IS_ERR(jpge->m2m_dev)) {
+		ret = PTR_ERR(jpge->m2m_dev);
+		jpge->m2m_dev = NULL;
+		v4l2_err(&jpge->v4l2_dev, "failed to init mem2mem device\n");
+		goto err_clk;
+	}
+
+	vdev = video_device_alloc();
+	if (!vdev) {
+		ret = -ENOMEM;
+		goto err_clk;
+	}
+	jpge->vdev = vdev;
+	vdev->v4l2_dev = &jpge->v4l2_dev;
+	vdev->fops = &histb_jpge_fops;
+	vdev->ioctl_ops = &histb_jpge_ioctl_ops;
+	vdev->lock = &jpge->vdev_lock;
+	vdev->release = video_device_release;
+	vdev->vfl_dir = VFL_DIR_M2M;
+	vdev->device_caps = V4L2_CAP_VIDEO_M2M | V4L2_CAP_STREAMING;
+	strscpy(vdev->name, HISTB_JPGE_NAME, sizeof(vdev->name));
+	video_set_drvdata(vdev, jpge);
+
+	ret = histb_jpge_reset(jpge);
+	if (ret)
+		goto err_vdev;
+	histb_jpge_dump_window(jpge, "idle");
+
+	ret = devm_request_irq(&pdev->dev, irq, histb_jpge_irq, 0,
+			       HISTB_JPGE_NAME, jpge);
+	if (ret) {
+		dev_err(&pdev->dev, "failed to request irq\n");
+		goto err_assert;
+	}
+	jpge->irq = irq;
+
+	ret = video_register_device(vdev, VFL_TYPE_VIDEO, -1);
+	if (ret) {
+		v4l2_err(&jpge->v4l2_dev, "failed to register video device\n");
+		goto err_irq;
+	}
+
+	dev_info(&pdev->dev, "JPEG encoder, version %#x\n",
+		 readl(jpge->regs + JPGE_VERSION));
+
+	/* The block is only clocked while a job is in flight. */
+	clk_disable_unprepare(jpge->clk);
+	pm_runtime_set_suspended(&pdev->dev);
+	pm_runtime_set_autosuspend_delay(&pdev->dev, 100);
+	pm_runtime_use_autosuspend(&pdev->dev);
+	pm_runtime_enable(&pdev->dev);
+
+	return 0;
+
+err_irq:
+	disable_irq(jpge->irq);
+err_assert:
+	reset_control_assert(jpge->rst);
+err_vdev:
+	video_device_release(vdev);
+err_clk:
+	clk_disable_unprepare(jpge->clk);
+	return ret;
+}
+
+static void histb_jpge_remove(struct platform_device *pdev)
+{
+	struct histb_jpge *jpge = platform_get_drvdata(pdev);
+
+	/*
+	 * v4l2_m2m_release() is only a kfree() in this tree, so it cannot be what
+	 * waits for a job: a client parked in device_run would keep using the
+	 * m2m device after remove returned. Pause the queue and let the running
+	 * job finish while its interrupt is still live, then mask the line
+	 * before the clock and reset go away -- a late report against an
+	 * unclocked block is an abort inside the handler, not a lost wakeup.
+	 */
+	mutex_lock(&jpge->vdev_lock);
+	WRITE_ONCE(jpge->removing, true);
+	v4l2_m2m_suspend(jpge->m2m_dev);
+	disable_irq(jpge->irq);
+	video_unregister_device(jpge->vdev);
+	mutex_unlock(&jpge->vdev_lock);
+	reset_control_assert(jpge->rst);
+	pm_runtime_dont_use_autosuspend(&pdev->dev);
+	pm_runtime_disable(&pdev->dev);
+	if (!pm_runtime_status_suspended(&pdev->dev))
+		pm_runtime_suspend(&pdev->dev);
+}
+
+static int histb_jpge_runtime_suspend(struct device *dev)
+{
+	struct histb_jpge *jpge = dev_get_drvdata(dev);
+
+	clk_disable_unprepare(jpge->clk);
+	return 0;
+}
+
+static int histb_jpge_runtime_resume(struct device *dev)
+{
+	struct histb_jpge *jpge = dev_get_drvdata(dev);
+
+	return clk_prepare_enable(jpge->clk);
+}
+
+static const struct dev_pm_ops histb_jpge_pm_ops = {
+	RUNTIME_PM_OPS(histb_jpge_runtime_suspend,
+		       histb_jpge_runtime_resume, NULL)
+	SET_SYSTEM_SLEEP_PM_OPS(pm_runtime_force_suspend,
+				pm_runtime_force_resume)
+};
+
+static struct platform_driver histb_jpge_driver = {
+	.probe = histb_jpge_probe,
+	.remove = histb_jpge_remove,
+	.driver = {
+		.name = HISTB_JPGE_NAME,
+		.of_match_table = histb_jpge_of_match,
+		.pm = pm_ptr(&histb_jpge_pm_ops),
+	},
+};
+module_platform_driver(histb_jpge_driver);
+
+MODULE_DESCRIPTION("HiSilicon Hi3798MV100 JPEG encoder driver");
+MODULE_LICENSE("GPL");
