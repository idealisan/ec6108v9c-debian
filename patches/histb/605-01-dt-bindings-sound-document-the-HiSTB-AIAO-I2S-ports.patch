From 1b96127b9445b5f0cb2edc195b46071afdf23aeb Mon Sep 17 00:00:00 2001
From: David Yang <mmyangfl@gmail.com>
Date: Mon, 5 Oct 2026 07:23:49 +0800
Subject: [PATCH 1/7] dt-bindings: sound: document the HiSTB AIAO I2S ports

The AIAO block of HiSilicon STB SoCs has independent receive and
transmit ports; each transmit port is an I2S master with its own clock
generator and its own ring-buffer engine, so the DMA properties a
typical I2S controller would need are absent.

Document the ports, with a port index selecting the direction: the
transmit port wired to the HDMI transmitter and the receive port that
taps that port's serial stream back in, since the pads of the receive
port are not wired on this board.

The binding covers the family from the start: the hi3716cv200 and
hi3798mv200 compatibles, the optional mclk that only hi3798mv200 names
(each port divides it down itself), the port counts the parts report in
their capability word, and one example per part.

Signed-off-by: David Yang <mmyangfl@gmail.com>
---
 .../sound/hisilicon,hi3798mv100-aiao-i2s.yaml | 124 ++++++++++++++++++
 1 file changed, 124 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/sound/hisilicon,hi3798mv100-aiao-i2s.yaml

--- /dev/null
+++ b/Documentation/devicetree/bindings/sound/hisilicon,hi3798mv100-aiao-i2s.yaml
@@ -0,0 +1,124 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/sound/hisilicon,hi3798mv100-aiao-i2s.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: HiSilicon Hi3798MV100 AIAO I2S ports
+
+maintainers:
+  - David Yang <mmyangfl@gmail.com>
+
+description: |
+  The Audio In And Out block of HiSilicon STB SoCs. Its ports generate their own
+  bit and frame clocks (so the port is the I2S master) and move their ring buffer
+  straight in or out of memory with an internal engine, which is why there is no
+  dmas property here.
+
+  The block carries the same register bands on every SoC of the family: the
+  receive ports sit at +0x1000 and the transmit ports at +0x2000, each port
+  taking 0x100 bytes, and the clock gate and soft reset sit in the same two bits
+  of the peripheral CRG. Only the Hi3798MV100 and the Hi3716CV200 have been
+  run. The number of ports differs: hi3798mv100 carries eight of each, while
+  hi3798mv200 reports three transmit and one receive port in its HW_CAPABILITY
+  word.
+
+  On hi3798mv100 the HDMI-capable port is wired inside the SoC to the HDMI
+  transmitter, so the codec side needs no phandle beyond the transmitter's own
+  #sound-dai-cells. The receive port has no pins to sample on this board: the
+  I2S pad mux is left in GPIO mode, so the receive port takes the serial stream
+  of the transmit port instead, and captures at the rate that port plays at.
+
+properties:
+  compatible:
+    enum:
+      - hisilicon,hi3798mv100-aiao-i2s
+      - hisilicon,hi3716cv200-aiao-i2s
+      - hisilicon,hi3798mv200-aiao-i2s
+
+  reg:
+    maxItems: 1
+
+  interrupts:
+    maxItems: 1
+    description: |
+      Level interrupt reporting the port's buffer conditions (watermarks,
+      trans_finish per TX_TRANS_SIZE bytes, overrun/underrun). Optional because
+      the driver times its period boundaries itself: the trans_finish interrupt
+      does not fire for a period-sized TX_TRANS_SIZE on the silicon this was
+      tested on.
+
+  clocks:
+    minItems: 1
+    items:
+      - description: The block clock gate (PERI_CRG70 bit 0).
+      - description: |
+          The master clock the ports divide down to mclk (PERI_CRG70 bit 21
+          picks between two PLL outputs on hi3798mv200). Only hi3798mv200 names
+          this one: the driver reads its rate, because the divider is a 27-bit
+          fraction of the input and lives in the port.
+
+  clock-names:
+    minItems: 1
+    items:
+      - const: aiao
+      - const: mclk
+
+  resets:
+    maxItems: 1
+    description: The block soft reset (PERI_CRG70 bit 4).
+
+  '#sound-dai-cells':
+    const: 1
+    description:
+      The index of the port inside the block, counted in the order the driver
+      registers its DAIs. Port 0 is the I2S transmit port wired to the HDMI
+      transmitter, port 1 the receive port that taps it.
+
+required:
+  - compatible
+  - reg
+  - clocks
+  - resets
+  - '#sound-dai-cells'
+
+additionalProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/clock/hisilicon,hi3798mv100-crg.h>
+    #include <dt-bindings/interrupt-controller/arm-gic.h>
+
+    audio@8cd0000 {
+        compatible = "hisilicon,hi3798mv100-aiao-i2s";
+        reg = <0x8cd0000 0x10000>;
+        interrupts = <GIC_SPI 84 IRQ_TYPE_LEVEL_HIGH>;
+        clocks = <&crg HI3798MV100_AIAO_CLK>;
+        resets = <&crg 0x118 4>;
+        #sound-dai-cells = <1>;
+    };
+  - |
+    #include <dt-bindings/clock/hisilicon,hi3716cv200-crg.h>
+    #include <dt-bindings/interrupt-controller/arm-gic.h>
+
+    audio@8cd0000 {
+        compatible = "hisilicon,hi3716cv200-aiao-i2s";
+        reg = <0xf8cd0000 0x10000>;
+        interrupts = <GIC_SPI 84 IRQ_TYPE_LEVEL_HIGH>;
+        clocks = <&crg HI3716CV200_AIAO_CLK>;
+        resets = <&crg 0x118 4>;
+        #sound-dai-cells = <1>;
+    };
+  - |
+    #include <dt-bindings/clock/hisilicon,hi3798mv200-crg.h>
+    #include <dt-bindings/interrupt-controller/arm-gic.h>
+
+    audio@8cd0000 {
+        compatible = "hisilicon,hi3798mv200-aiao-i2s";
+        reg = <0x8cd0000 0x10000>;
+        interrupts = <GIC_SPI 84 IRQ_TYPE_LEVEL_HIGH>;
+        clocks = <&crg HI3798MV200_AIAO_CLK>, <&crg HI3798MV200_AIAO_MCLK_CLK>;
+        clock-names = "aiao", "mclk";
+        resets = <&crg 0x118 4>;
+        #sound-dai-cells = <1>;
+    };
