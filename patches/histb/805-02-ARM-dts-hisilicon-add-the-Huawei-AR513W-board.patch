From d33df4f06609d9f3eafecccf6f8e92fce33d4a9b Mon Sep 17 00:00:00 2001
From: David Yang <mmyangfl@gmail.com>
Date: Wed, 21 Oct 2026 14:36:43 +0800
Subject: [PATCH 2/3] ARM: dts: hisilicon: add the Huawei AR513W board

The SoC file above needs a board that switches things on.

The AR513W-V3M8 (bigfish) is a Hi3716CV200 board: console on uart0, 1
GiB NAND, the JPEG pair and the video codecs enabled taking their
buffers from the default CMA area, and the RGMII MAC that reaches the
router SoC through the switch fabric declared as a fixed link. Describe
the board and gate its DTB on ARCH_HI3716CV200.

Signed-off-by: David Yang <mmyangfl@gmail.com>
---
 arch/arm/boot/dts/hisilicon/Makefile          |  2 +
 .../boot/dts/hisilicon/hi3716cv200-ar513w.dts | 47 +++++++++++++++++++
 2 files changed, 49 insertions(+)
 create mode 100644 arch/arm/boot/dts/hisilicon/hi3716cv200-ar513w.dts

--- a/arch/arm/boot/dts/hisilicon/Makefile
+++ b/arch/arm/boot/dts/hisilicon/Makefile
@@ -11,3 +11,5 @@ dtb-$(CONFIG_ARCH_HIX5HD2) += \
 	hisi-x5hd2-dkb.dtb
 dtb-$(CONFIG_ARCH_SD5203) += \
 	sd5203.dtb
+dtb-$(CONFIG_ARCH_HI3716CV200) += \
+	hi3716cv200-ar513w.dtb
--- /dev/null
+++ b/arch/arm/boot/dts/hisilicon/hi3716cv200-ar513w.dts
@@ -0,0 +1,47 @@
+// SPDX-License-Identifier: GPL-2.0-or-later OR MIT
+/*
+ * Huawei AR513W-V3M8: Hi3716CV200 (bigfish) with 1 GiB NAND,
+ * console on uart0. The NAND partition table belongs to the
+ * platform that owns it and is not described here.
+ */
+
+/dts-v1/;
+
+#include "hi3716cv200.dtsi"
+
+/ {
+	model = "Huawei AR513W-V3M8 (Hi3716CV200)";
+	compatible = "hisilicon,ar513w", "hisilicon,hi3716cv200";
+};
+
+
+/* The JPEG codec pair: transfers ran on this board. */
+&jpgd { status = "okay"; };
+&jpge { status = "okay"; };
+
+/*
+ * The video codecs. No `memory-region`: both queues are dma-contig
+ * and the driver binds the region that property names if there is
+ * one, but this kernel already reserves a 128 MiB default CMA area
+ * (CONFIG_CMA_SIZE_MBYTES), which is where the JPEG pair allocated
+ * on this board. A dedicated pool is only worth pricing in once a
+ * session needs more than that area can give.
+ */
+&vdec { status = "okay"; };
+&venc { status = "okay"; };
+
+/*
+ * gmac1 (RGMII) feeds the on-chip switch fabric, whose port 1 peer
+ * is the router SoC's own MAC: no PHY hangs off this bus (measured,
+ * MDIO address 1 reads back empty), so the link is declared fixed
+ * at 1000/full.
+ */
+&gmac1 {
+	status = "okay";
+
+	fixed-link {
+		speed = <1000>;
+		full-duplex;
+		pause;
+	};
+};
