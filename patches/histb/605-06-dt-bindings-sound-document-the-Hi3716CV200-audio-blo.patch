From bec07541dcb50654ec463d1dfb9c6ff8a96bee51 Mon Sep 17 00:00:00 2001
From: David Yang <mmyangfl@gmail.com>
Date: Fri, 23 Oct 2026 06:24:11 +0800
Subject: [PATCH 6/7] dt-bindings: sound: document the Hi3716CV200 audio blocks

The Hi3716CV200 carries the same AIAO register bands as the Hi3798MV100
and adds the TianLai internal audio DAC, two registers next to the CRG
with no source select of their own.

The DAC gets a schema of its own naming the CRG gate and reset cells;
the card binding gains the strings this chip uses and grows the DAC
links, with a capture link that taps the same transmit port the DAC
listens to so that port's output can be measured without an analog
probe.

Signed-off-by: David Yang <mmyangfl@gmail.com>
---
 .../sound/hisilicon,hi3716cv200-adac.yaml     | 61 +++++++++++++++++++
 .../hisilicon,hi3798mv100-aiao-card.yaml      | 49 +++++++++++++++
 2 files changed, 110 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/sound/hisilicon,hi3716cv200-adac.yaml

--- /dev/null
+++ b/Documentation/devicetree/bindings/sound/hisilicon,hi3716cv200-adac.yaml
@@ -0,0 +1,61 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/sound/hisilicon,hi3716cv200-adac.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: HiSilicon Hi3716CV200 internal audio DAC
+
+maintainers:
+  - David Yang <mmyangfl@gmail.com>
+
+description: |
+  The analog output stage of the Hi3716CV200, reached through two 32-bit
+  registers next to the CRG. It is a consumer of the AIAO transmit port's
+  serial stream rather than a source of its own, so it carries no DMA or
+  interrupt of its own and is wired to that port by the sound card node.
+
+  The driver's only state is the power and mute bit the vendor's own audio HAL
+  toggles at stream start and stop, which is why it claims the gate clock and
+  the reset line: a write to the block does not land while either is off.
+
+properties:
+  compatible:
+    const: hisilicon,hi3716cv200-adac
+
+  reg:
+    maxItems: 1
+
+  clocks:
+    maxItems: 1
+    description: Gate of the DAC (PERI_CRG69 bit 0).
+
+  resets:
+    maxItems: 1
+    description:
+      DAC soft reset (PERI_CRG69 bit 4). The cell pair is a register offset
+      and a bit number, which is what reset-cells = <2> asks of the CRG.
+
+  '#sound-dai-cells':
+    const: 0
+
+required:
+  - compatible
+  - reg
+  - clocks
+  - resets
+  - '#sound-dai-cells'
+
+additionalProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/clock/hisilicon,hi3716cv200-crg.h>
+
+    audio-codec@f8a20110 {
+        compatible = "hisilicon,hi3716cv200-adac";
+        reg = <0xf8a20110 0x8>;
+        clocks = <&crg HI3716CV200_ADAC_CLK>;
+        resets = <&crg 0x114 4>;
+        #sound-dai-cells = <0>;
+    };
--- a/Documentation/devicetree/bindings/sound/hisilicon,hi3798mv100-aiao-card.yaml
+++ b/Documentation/devicetree/bindings/sound/hisilicon,hi3798mv100-aiao-card.yaml
@@ -80,6 +80,55 @@ properties:
       - cpu
     additionalProperties: false
 
+  dac-playback:
+    type: object
+    description:
+      DAI link carrying the audio to the internal DAC (hi3716cv200). Shaped
+      like playback.
+    properties:
+      cpu:
+        type: object
+        properties:
+          sound-dai:
+            $ref: /schemas/types.yaml#/definitions/phandle-array
+            maxItems: 1
+        required:
+          - sound-dai
+        additionalProperties: false
+      codec:
+        type: object
+        properties:
+          sound-dai:
+            $ref: /schemas/types.yaml#/definitions/phandle-array
+            maxItems: 1
+        required:
+          - sound-dai
+        additionalProperties: false
+    required:
+      - cpu
+      - codec
+    additionalProperties: false
+
+  dac-capture:
+    type: object
+    description:
+      Tap of the line the DAC listens to, so the transmit side of that link can
+      be measured with no analog probe on the board (hi3716cv200). Shaped like
+      capture.
+    properties:
+      cpu:
+        type: object
+        properties:
+          sound-dai:
+            $ref: /schemas/types.yaml#/definitions/phandle-array
+            maxItems: 1
+        required:
+          - sound-dai
+        additionalProperties: false
+    required:
+      - cpu
+    additionalProperties: false
+
 required:
   - compatible
   - model
