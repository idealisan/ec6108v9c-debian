+/*
+ * struct histb_venc - one VEDU instance
+ * @hw_lock: the block keeps one global descriptor rather than per-channel
+ *	     state, so a job owns it from its first write to its completion;
+ *	     that also leaves @int_state and @int_done to one writer
+ */
+struct histb_venc {
+	struct device		*dev;
+	struct device		*memdev;
+	void __iomem		*regs;
+	struct clk		*clk;
+	struct reset_control	*rst;
+	struct v4l2_device	v4l2_dev;
+	struct video_device	*vdev;
+	struct v4l2_m2m_dev	*m2m_dev;
+	int			irq;	/* kept so remove can mask it */
+	bool			removing;	/* device_run() refuses work */
+	struct mutex		hw_lock;
+	struct mutex		vdev_lock;
+	wait_queue_head_t	done;
+	u32			int_state;
+	bool			int_done;
+};
+
+/*
+ * struct histb_venc_q - one queue's layout as client and block see it
+ *
+ * For the OUTPUT queue it is the raw picture; for CAPTURE @size is the largest
+ * bitstream the client will accept, which is also the ring the block writes.
+ * @planes counts the buffers one picture occupies and @plane_size says how many
+ * bytes each of them holds, so a plane never has to be re-derived.
+ */
+struct histb_venc_q {
+	u32	fourcc;
+	unsigned int width;
+	unsigned int height;
+	unsigned int bytesperline;
+	unsigned int size;
+	u8	planes;
+	unsigned int plane_size[2];
+};
+
+/* The M forms are the same storage as their twins, split in two. */
+static bool histb_venc_is_m_fmt(u32 fourcc)
+{
+	return fourcc == V4L2_PIX_FMT_NV12M || fourcc == V4L2_PIX_FMT_NV21M;
+}
+
+/* A packed pair is one plane of two bytes per pixel and is 4:2:2. */
+static bool histb_venc_is_packed(u32 fourcc)
+{
+	return fourcc == V4L2_PIX_FMT_YUYV || fourcc == V4L2_PIX_FMT_UYVY;
+}
+
+/* Semi-planar 4:2:2 keeps a full-height chroma plane beside the luma. */
+static bool histb_venc_is_semi422(u32 fourcc)
+{
+	return fourcc == V4L2_PIX_FMT_NV16 || fourcc == V4L2_PIX_FMT_NV61;
+}
+
+/* Write a negotiated layout into the plane description a client asked for. */
+static void histb_venc_fill_pix(struct v4l2_pix_format_mplane *pix,
+				const struct histb_venc_q *q)
+{
+	unsigned int p;
+
+	pix->pixelformat = q->fourcc;
+	pix->width = q->width;
+	pix->height = q->height;
+	pix->field = V4L2_FIELD_NONE;
+	pix->colorspace = V4L2_COLORSPACE_SMPTE170M;
+	pix->num_planes = q->planes;
+	for (p = 0; p < q->planes; p++) {
+		pix->plane_fmt[p].bytesperline = q->bytesperline;
+		pix->plane_fmt[p].sizeimage = q->plane_size[p];
+	}
+}
+
+/* True when a plane does not hold the number of bytes its layout asks for. */
+static bool histb_venc_payload_bad(struct vb2_buffer *vb,
+				   const struct histb_venc_q *q)
+{
+	unsigned int p;
+
+	for (p = 0; p < q->planes; p++)
+		if (vb2_get_plane_payload(vb, p) < q->plane_size[p] ||
+		    vb2_get_plane_payload(vb, p) > vb->planes[p].length)
+			return true;
+
+	return false;
+}
