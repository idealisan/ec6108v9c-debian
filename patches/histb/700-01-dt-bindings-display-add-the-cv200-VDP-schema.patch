From f9b8d6e1fb4f9b79c63abd357b680a877c127919 Mon Sep 17 00:00:00 2001
From: David Yang <mmyangfl@gmail.com>
Date: Tue, 3 Nov 2026 14:45:27 +0800
Subject: [PATCH 1/5] dt-bindings: display: add the cv200 VDP schema

The cv200 VDP display engine had no binding schema of its own. Add one
matching the shared driver that registers the cv200 channel.

Signed-off-by: David Yang <mmyangfl@gmail.com>
---
 .../hisilicon/hisilicon,hi3716cv200-vdp.yaml  | 198 ++++++++++++++++++
 1 file changed, 198 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/display/hisilicon/hisilicon,hi3716cv200-vdp.yaml

--- /dev/null
+++ b/Documentation/devicetree/bindings/display/hisilicon/hisilicon,hi3716cv200-vdp.yaml
@@ -0,0 +1,198 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/display/hisilicon/hisilicon,hi3716cv200-vdp.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: HiSilicon HiSTB VDP display engines
+
+maintainers:
+  - David Yang <mmyangfl@gmail.com>
+
+description: |
+  The VDP block composites the graphics layers onto a display channel and drives
+  the timing of that channel. The driver exposes DHD0, the HD channel wired to
+  the on-chip HDMI transmitter, whose pixel clock the two blocks share.
+
+  Three parts are covered. The v2 engine of hi3716cv200 and hi3798mv100 routes
+  G0 through GP0 into the mixer and has write-back taps; the v4 engine of
+  hi3798mv200 admits G0 to the mixer directly and has none. hi3716cv200 uses
+  the same v2 register file as hi3798mv100; the one block whose layout differs
+  is the GP0 zoom engine, where cv200 keeps both horizontal offsets in a single
+  register and takes both ratios in 4.12 fixed point.
+
+properties:
+  compatible:
+    enum:
+      - hisilicon,hi3716cv200-vdp
+      - hisilicon,hi3798mv100-vdp
+      - hisilicon,hi3798mv200-vdp
+
+  reg:
+    maxItems: 1
+
+  interrupts:
+    maxItems: 1
+
+  clocks:
+    minItems: 2
+    maxItems: 3
+
+  clock-names:
+    minItems: 2
+    maxItems: 3
+    items:
+      enum:
+        - pix
+        - vo
+        - bus
+        - sdate
+    description: |
+      "pix" is the HD channel clock, which the transmitter is fed from, so the
+      two blocks cannot disagree about the pixel clock.  The v2 engine takes
+      the rest of the display channel's gates (CRG54 bits 6:0 apart from
+      vo_hd_cken) as "vo"; the v4 engine takes the bus gate as "bus" and the
+      gate of the channel's timing encoder as "sdate".  A reset request only
+      reaches the block while it is clocked, so the driver enables these before
+      pulsing the reset below.
+
+  resets:
+    maxItems: 1
+    description: |
+      The v2 engine takes the VOU soft reset (CRG54 bit 30) and pulses it
+      before it configures the block.  The v4 engine takes its own soft reset
+      (CRG211 bit 29), named vdp, which has to be released before any clock
+      feeding the register file is raised, because an access with the HD domain
+      clocked while that request is still held locks the bus instead of
+      returning a value.
+
+  reset-names:
+    items:
+      - const: vdp
+
+  hisilicon,crg:
+    $ref: /schemas/types.yaml#/definitions/phandle
+    description: |
+      Phandle of the clock generator, used by the v4 engine.  The driver
+      reaches one more field there by hand, the VOU reset request in CRG54 bit
+      30, whose register file is only reachable with that bit raised, and which
+      the reset framework cannot describe because the bit means the opposite of
+      what its assert does.
+
+  memory-region:
+    maxItems: 1
+    description:
+      Phandle to a node describing memory to be used for the framebuffer. If not
+      present, the framebuffer may be located anywhere in memory. The channel
+      takes a single base address and has no MMU, so frame buffers also have to
+      be physically contiguous.
+
+  ports:
+    $ref: /schemas/graph.yaml#/properties/ports
+
+    properties:
+      port@0:
+        $ref: /schemas/graph.yaml#/properties/port
+        description:
+          Pixel output of the channel, connected to the input of the HDMI
+          transmitter.
+
+    required:
+      - port@0
+
+required:
+  - compatible
+  - reg
+  - clocks
+  - clock-names
+  - resets
+  - ports
+
+additionalProperties: false
+
+allOf:
+  - if:
+      properties:
+        compatible:
+          contains:
+            const: hisilicon,hi3798mv200-vdp
+    then:
+      properties:
+        clocks:
+          minItems: 3
+          maxItems: 3
+        clock-names:
+          items:
+            - const: pix
+            - const: bus
+            - const: sdate
+        hisilicon,crg: true
+      required:
+        - hisilicon,crg
+        - reset-names
+    else:
+      properties:
+        clocks:
+          minItems: 2
+          maxItems: 2
+        clock-names:
+          items:
+            - const: pix
+            - const: vo
+        hisilicon,crg: false
+
+examples:
+  - |
+    #include <dt-bindings/clock/hisilicon,hi3798mv100-crg.h>
+
+    display@8cc0000 {
+        compatible = "hisilicon,hi3798mv100-vdp";
+        reg = <0x8cc0000 0x10000>;
+        interrupts = <90 4>;
+        clocks = <&crg HI3798MV100_VO_HD_CLK>, <&crg HI3798MV100_VO_CLK>;
+        clock-names = "pix", "vo";
+        resets = <&crg 0xd8 30>;
+
+        ports {
+            #address-cells = <1>;
+            #size-cells = <0>;
+
+            port@0 {
+                reg = <0>;
+
+                vdp_out_hdmi: endpoint {
+                    remote-endpoint = <&hdmi_in_vdp>;
+                };
+            };
+        };
+    };
+
+  - |
+    #include <dt-bindings/clock/hisilicon,hi3798mv200-crg.h>
+    #include <dt-bindings/interrupt-controller/arm-gic.h>
+
+    display@f8cc0000 {
+        compatible = "hisilicon,hi3798mv200-vdp";
+        reg = <0xf8cc0000 0x10000>;
+        interrupts = <GIC_SPI 90 IRQ_TYPE_LEVEL_HIGH>;
+        clocks = <&crg HI3798MV200_VO_HD>, <&crg HI3798MV200_VO_BUS>,
+                 <&crg HI3798MV200_VO_SDATE>;
+        clock-names = "pix", "bus", "sdate";
+        resets = <&crg 0x34c 29>;
+        reset-names = "vdp";
+        hisilicon,crg = <&crg>;
+
+        ports {
+            #address-cells = <1>;
+            #size-cells = <0>;
+
+            port@0 {
+                reg = <0>;
+
+                vdp4_out_hdmi: endpoint {
+                    remote-endpoint = <&hdmi_in_vdp>;
+                };
+            };
+        };
+    };
+...
