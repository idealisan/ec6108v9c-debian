From 50d7cb6c0f1d80def2b40277c3b232bb83cf0f0b Mon Sep 17 00:00:00 2001
From: David Yang <mmyangfl@gmail.com>
Date: Wed, 21 Oct 2026 20:40:56 +0800
Subject: [PATCH 1/2] dt-bindings: timer: add the Hi3716CV200 per-CPU SP804
 timers

Neither the Cortex-A9 private timer nor the global timer of the
Hi3716CV200 counts, so the per-CPU clock events come from dedicated
SP804 channels. Document the compatible the local-timer driver binds:
reg and interrupts are one entry per CPU and matched positionally --
cell 4 with its own interrupt for the first CPU, cell 6 for the second
-- which is why the driver insists they stay in CPU order, and the
channel cells are separate from the arm,sp804 node that provides the
clocksource and the broadcast clock event. Add the schema so consumers
can bind.

Signed-off-by: David Yang <mmyangfl@gmail.com>
---
 .../hisilicon,hi3716cv200-smp-timer.yaml      | 59 +++++++++++++++++++
 1 file changed, 59 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/timer/hisilicon,hi3716cv200-smp-timer.yaml

--- /dev/null
+++ b/Documentation/devicetree/bindings/timer/hisilicon,hi3716cv200-smp-timer.yaml
@@ -0,0 +1,59 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/timer/hisilicon,hi3716cv200-smp-timer.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: HiSilicon Hi3716CV200 per-CPU SP804 local timers
+
+maintainers:
+  - David Yang <mmyangfl@gmail.com>
+
+description: |
+  Hi3716CV200 has no usable Cortex-A9 local timer: neither the private timer and
+  watchdog block nor the global timer in the A9 MPCore private region counts, so
+  the per-CPU clock events come from dedicated SP804 channels -- cell 4 for the
+  first CPU and cell 6 for the second, each with its own interrupt line.
+
+  These channels are separate from the arm,sp804 node that provides the
+  clocksource and the broadcast clock event, which remains the fallback for a
+  CPU with no channel of its own.
+
+properties:
+  compatible:
+    const: hisilicon,hi3716cv200-smp-timer
+
+  reg:
+    minItems: 1
+    maxItems: 8
+    description:
+      One entry per CPU, listed in CPU order; each is that CPU's SP804 channel.
+
+  interrupts:
+    minItems: 1
+    maxItems: 8
+    description:
+      One entry per CPU, in the same order as reg.
+
+  clocks:
+    maxItems: 1
+
+required:
+  - compatible
+  - reg
+  - interrupts
+  - clocks
+
+additionalProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/interrupt-controller/arm-gic.h>
+
+    timer@f8a2a000 {
+        compatible = "hisilicon,hi3716cv200-smp-timer";
+        reg = <0xf8a2a000 0x20>, <0xf8a2b000 0x20>;
+        interrupts = <GIC_SPI 26 IRQ_TYPE_LEVEL_HIGH>,
+                     <GIC_SPI 27 IRQ_TYPE_LEVEL_HIGH>;
+        clocks = <&xtal24mhz>;
+    };
