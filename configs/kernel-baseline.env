# Kernel source baseline for the histb 7.4 migration.
# The quilt series in patches/histb/ (117 upstream patches + our 820-01 board
# overlay) is written against a clean Linux v7.4-rc2 mainline tree.
#
# BASELINE_SHA is the v7.4-rc2 *annotated tag object*; the dereferenced commit
# (what `git archive`/`fetch --depth 1` actually needs) is BASE_COMMIT.
# scripts/build-kernel.sh asserts the submodule HEAD equals BASE_COMMIT and
# fetches it by SHA if not (a shallow submodule clone of the branch tip is
# 7.4-rc4 and would make the --fuzz=0 quilt series reject).
KERNEL_VERSION=7.4-rc2
BASELINE_TAG=v7.4-rc2
BASELINE_SHA=fd9230005e85472b81c1c7c16afe93dd878996b1
BASE_COMMIT=7475ea8b58616b33c04afb976cf0fbaad9dd63fb
DEFCONFIG=multi_v7_defconfig
DTS_DIR=arch/arm/boot/dts/hisilicon
DTS=hi3798mv100-ec6108v9c
HISTB_PATCHES=patches/histb
