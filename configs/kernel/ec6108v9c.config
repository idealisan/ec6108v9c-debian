# EC6108V9C (Hi3798MV100) - kernel config fragment for histb 7.4-rc2.
# Applied on top of multi_v7_defconfig by scripts/build-kernel.sh (which runs
# olddefconfig afterwards). Sources of truth for the 7.4 symbols:
#   TMP/gthifb-config/01-arch-arm.txt  (boot-critical arch/clock/protocol)
#   TMP/gthifb-config/02-select-y.txt  (every board-DT-enabled driver)
# The board DTS (810-03 + our 820-01 overlay) enables: emmc/sd, eth0, ir,
# hdmi(SiI9134 bridge), vdp(DRM KMS), gpu(lima), vdec/vpss/jpgd/venc/jpge,
# aiao, leds, thermal. Build them all in (=y) except lima (module, loaded by
# ec6108-gpu.service after userspace; avoids GPU probe on the boot path).
# '#' lines are comments understood by scripts/config.

# ---- boot protocol: APPENDED_DTB trio (cat zImage+DTB -> mkimage) ----
CONFIG_ARM_APPENDED_DTB=y
CONFIG_ARM_ATAG_DTB_COMPAT=y
CONFIG_ARM_ATAG_DTB_COMPAT_CMDLINE_FROM_BOOTLOADER=y
# ---- arch gates / VFP / LPAE off (Cortex-A9 head.S rejects LPAE) ----
CONFIG_ARCH_HISI=y
CONFIG_ARCH_HI3716CV200=y
CONFIG_VFP=y
CONFIG_VFPv3=y
CONFIG_NEON=y
CONFIG_KERNEL_MODE_NEON=y
# CONFIG_ARM_LPAE is not set
# ---- SoC clocks / timers / reset (7.4 crg-hi3798mv100.c) ----
CONFIG_COMMON_CLK=y
CONFIG_COMMON_CLK_HI3798MV100=y
CONFIG_COMMON_CLK_HI3716CV200=y
CONFIG_HISTB_SMP_TIMER=y
CONFIG_RESET_HISI=y
CONFIG_MFD_SYSCON=y

# ---- skeleton subsystem gates (no default; else whole families vanish) ----
CONFIG_NET=y
CONFIG_NETDEVICES=y
CONFIG_ETHERNET=y
CONFIG_NET_VENDOR_HISILICON=y
CONFIG_PHYLIB=y
CONFIG_DMADEVICES=y
CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
CONFIG_I2C=y
CONFIG_HID=y
CONFIG_HID_GENERIC=y
CONFIG_USB_HID=y
CONFIG_MEDIA_SUPPORT=y
CONFIG_VIDEO_DEV=y
CONFIG_RC_CORE=y
CONFIG_RC_DEVICES=y
CONFIG_GPIOLIB=y
CONFIG_WATCHDOG=y
CONFIG_NEW_LEDS=y
CONFIG_LEDS_CLASS=y
CONFIG_LEDS_GPIO=y
CONFIG_SPI=y
CONFIG_REGULATOR=y
CONFIG_PINCTRL=y
CONFIG_GENERIC_PHY=y
CONFIG_ATA=y
CONFIG_MTD=y
CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_SND_SOC=y
CONFIG_V4L_MEM2MEM_DRIVERS=y
CONFIG_CMA=y
CONFIG_DMA_CMA=y
CONFIG_DMABUF_HEAPS=y
CONFIG_DMABUF_HEAPS_CMA=y
CONFIG_DMABUF_HEAPS_SYSTEM=y

# ---- console / UART ----
CONFIG_SERIAL_AMBA_PL011=y
CONFIG_SERIAL_AMBA_PL011_CONSOLE=y
CONFIG_GPIO_PL061=y
CONFIG_ARM_SP805_WATCHDOG=y
# ---- wired Ethernet: FEMAC + Festa/Fixed PHY + hix5hd2 gmac ----
CONFIG_HISI_FEMAC=y
CONFIG_MDIO_HISI_FEMAC=y
CONFIG_HISI_FESTA_PHY=y
CONFIG_FIXED_PHY=y
CONFIG_HIX5HD2_GMAC=y
# ---- MMC: dw-mshc mv200/cv200 variants (810-02 &emmc/&sd compatible) ----
CONFIG_MMC_DW=y
CONFIG_MMC_DW_HI3798MV200=y
CONFIG_MMC_DW_HI3798CV200=y
# ---- infrared: hisilicon,hix5hd2-ir (+260/310 compatible/keymap) ----
CONFIG_IR_HIX5HD2=y
CONFIG_LIRC=y
CONFIG_IR_NEC_DECODER=y
CONFIG_IR_RC5_DECODER=y
CONFIG_IR_RC6_DECODER=y
CONFIG_IR_SONY_DECODER=y
CONFIG_IR_JVC_DECODER=y
CONFIG_IR_SANYO_DECODER=y
CONFIG_IR_SHARP_DECODER=y
CONFIG_IR_MCE_KBD_DECODER=y
CONFIG_IR_XMP_DECODER=y
# ---- USB / storage / input ----
CONFIG_USB=y
CONFIG_USB_EHCI_HCD=y
CONFIG_USB_OHCI_HCD=y
CONFIG_USB_EHCI_HCD_PLATFORM=y
CONFIG_USB_OHCI_HCD_PLATFORM=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_STORAGE=y
CONFIG_USB_UAS=y
CONFIG_SCSI=y
CONFIG_BLK_DEV_SD=y
CONFIG_CHR_DEV_SG=y
CONFIG_PHY_HISI_INNO_USB2=y
CONFIG_I2C_HIX5HD2=y
CONFIG_INPUT_EVDEV=y
CONFIG_INPUT_KEYBOARD=y
CONFIG_KEYBOARD_ATKBD=y
# ---- WiFi: RTL8188FU (USB 0bda:f179), mainline rtl8xxxu ----
# No initramfs: rtl8xxxu probe is a device initcall before root= mounts, so
# /lib/firmware is unreachable. Build the blob into vmlinux; EXTRA_FIRMWARE_DIR
# is set to the repo firmware/ path at build time by build-kernel.sh.
CONFIG_WIRELESS=y
CONFIG_CFG80211=y
CONFIG_MAC80211=y
CONFIG_RTL8XXXU=y
CONFIG_RTL8XXXU_UNTESTED=y
CONFIG_RFKILL=y
CONFIG_RFKILL_INPUT=y
CONFIG_WEXT_CORE=y
CONFIG_WEXT_PROC=y
CONFIG_CFG80211_WEXT=y
CONFIG_EXTRA_FIRMWARE="rtlwifi/rtl8188fufw.bin"
# ---- GPU/display: histb VDP KMS + SiI9134 HDMI bridge + lima render ----
# VDP = display-only KMS card; lima render node + Mesa kmsro/PRIME do the
# rendering. media_cma (160MiB, 810-03 DTS) supplies the scanout buffers.
CONFIG_DRM=y
CONFIG_DRM_HISTB_VDP=y
CONFIG_DRM_SII9134=y
CONFIG_DRM_LIMA=m
CONFIG_DRM_SCHED=y
CONFIG_DRM_GEM_SHMEM_HELPER=y
CONFIG_DRM_GEM_DMA_HELPER=y
CONFIG_DRM_KMS_HELPER=y
CONFIG_DRM_BRIDGE=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_DRM_LOAD_EDID_FIRMWARE=y
CONFIG_PM=y
CONFIG_PM_OPP=y
CONFIG_PM_DEVFREQ=y
CONFIG_DEVFREQ_GOV_SIMPLE_ONDEMAND=y
# ---- framebuffer console / VT ----
CONFIG_FB=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE_DETECT_PRIMARY=y
CONFIG_FRAMEBUFFER_CONSOLE_ROTATION=y
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_VT_HW_CONSOLE_BINDING=y
CONFIG_FONT_8x16=y
CONFIG_FONT_8x8=y
CONFIG_FONTS=y
CONFIG_LOGO=y
# ---- pstore/ramoops (820-01 DTS node) ----
CONFIG_PSTORE=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_PMSG=y
CONFIG_PSTORE_RAM=y
CONFIG_PSTORE_DEFLATE_COMPRESS=y
CONFIG_PSTORE_DEFLATE_COMPRESS_DEFAULT=y
# ---- thermal ----
CONFIG_THERMAL=y
CONFIG_THERMAL_OF=y
CONFIG_THERMAL_GOV_STEP_WISE=y
CONFIG_THERMAL_GOV_FAIR_SHARE=y
CONFIG_THERMAL_GOV_USER_SPACE=y
CONFIG_HWMON=y
CONFIG_CPU_THERMAL=y
# ---- filesystems (version-independent conveniences) ----
CONFIG_EXT4_FS=y
CONFIG_EXT4_FS_POSIX_ACL=y
CONFIG_EXT4_FS_SECURITY=y
CONFIG_F2FS_FS=y
CONFIG_F2FS_FS_SECURITY=y
CONFIG_BTRFS_FS=y
CONFIG_XFS_FS=y
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_XZ=y
CONFIG_SQUASHFS_ZSTD=y
CONFIG_OVERLAY_FS=y
CONFIG_EXFAT_FS=y
CONFIG_NTFS3_FS=y
CONFIG_VFAT_FS=y
CONFIG_FAT_FS=y
CONFIG_FUSE_FS=y
CONFIG_AUTOFS_FS=y
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_NLS_DEFAULT="utf8"
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_UTF8=y
CONFIG_NFS_FS=y
CONFIG_CIFS=m
CONFIG_CIFS_XATTR=y
CONFIG_JBD2=y
CONFIG_FS_ENCRYPTION=y
CONFIG_FS_VERITY=y
CONFIG_BLK_DEV_LOOP=y
CONFIG_BLK_DEV_RAM=y
# ---- networking helpers ----
CONFIG_INET=y
CONFIG_IP_PNP=y
CONFIG_IP_PNP_DHCP=y
CONFIG_PACKET=y
CONFIG_UNIX=y
CONFIG_BRIDGE=m
CONFIG_TUN=m
CONFIG_IPV6=y
CONFIG_NETFILTER=y
# ---- crypto ----
CONFIG_CRYPTO_SHA256=y
CONFIG_CRYPTO_AES=y
CONFIG_CRYPTO_CRC32C=y
# ---- devmem (VO register probe from userspace) ----
CONFIG_DEVMEM=y
# ---- security: minimal ----
CONFIG_SECURITY_SELINUX=n
CONFIG_SECURITY_APPARMOR=n
CONFIG_SECURITY=n
