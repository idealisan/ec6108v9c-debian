CONFIG_FB_HI3798MV100_HDMI_CONSOLE=y
# EC6108V9C (Hi3798MV100) - kernel config fragment, applied on top of
# hi3798mv100_defconfig by scripts/build-kernel.sh.
# Lines starting with '#' are comments understood by scripts/config.
# Built-in (=y) where the box needs it at boot; modules (=m) for the rest.
#
# ---- WiFi: RTL8188FU (USB 0bda:f179), mainline rtl8xxxu ----
CONFIG_WIRELESS=y
CONFIG_CFG80211=y
CONFIG_MAC80211=y
CONFIG_RTL8XXXU=y
CONFIG_RTL8XXXU_UNTESTED=y
CONFIG_RFKILL=y
CONFIG_RFKILL_INPUT=y
CONFIG_WEXT_CORE=y
CONFIG_WEXT_PROC=y
CONFIG_CFG80211_WEXT=y
# This boot chain has NO initramfs: the rtl8xxxu probe is a device initcall,
# long before root=mmcblk0p8 is mounted, so /lib/firmware on the rootfs is
# unreachable and request_firmware() fails with -ENOENT. Real HW showed exactly
# "direct firmware load for rtlwifi/rtl8188fufw.bin failed with error -2" and
# "RTL8xxxu: Probe of 3-2:1.0 failed with error -11" (-11 = -EAGAIN, the
# driver's request_firmware failure path). Build the blob into vmlinux so
# fw_get_builtin_firmware() satisfies it at early boot. The blob comes from
# linux-firmware (signature 0x88f1 -> 0x88f0, one of the signatures accepted
# by rtl8xxxu_load_firmware()). Debian's firmware-realtek does NOT ship the
# 8188FU blob (only 8188e/8188eu), hence firmware/rtlwifi/rtl8188fufw.bin here.
# EXTRA_FIRMWARE_DIR is set to an absolute path at build time by
# scripts/build-kernel.sh (Kconfig default /lib/firmware is unusable in CI).
CONFIG_EXTRA_FIRMWARE="rtlwifi/rtl8188fufw.bin"
#

# ---- pstore: survive a panic so the log can be read after reboot ----
# ramoops.mem_address / mem_size are passed via cmdline once a free DDR
# region is known (must not overlap hiboot framebuffer); see docs/020.
CONFIG_PSTORE=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_PMSG=y
CONFIG_PSTORE_RAM=y
CONFIG_PSTORE_DEFLATE_COMPRESS=y
CONFIG_PSTORE_DEFLATE_COMPRESS_DEFAULT=y

# ---- HDMI / framebuffer console (hiboot leaves a framebuffer) ----
CONFIG_FB=y
CONFIG_FB_SIMPLE=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE_DETECT_PRIMARY=y
CONFIG_FRAMEBUFFER_CONSOLE_ROTATION=y
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_VT_HW_CONSOLE_BINDING=y
CONFIG_FONT_8x16=y
CONFIG_FONT_8x8=y
CONFIG_FONTS=y
CONFIG_LOGO=y
#
# ---- Thermal: on-chip Tsensor -> /sys/class/thermal/thermal_zone0/temp ----
CONFIG_THERMAL=y
CONFIG_THERMAL_OF=y
CONFIG_THERMAL_GOV_STEP_WISE=y
CONFIG_THERMAL_GOV_FAIR_SHARE=y
CONFIG_THERMAL_GOV_USER_SPACE=y
CONFIG_THERMAL_EMULATION=y
CONFIG_HI3798MV100_TSENSOR=y
CONFIG_HWMON=y
CONFIG_CPU_THERMAL=y
#
# ---- USB / input (two USB ports, keyboard/mouse) ----
CONFIG_USB=y
CONFIG_USB_EHCI_HCD=y
CONFIG_USB_OHCI_HCD=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_STORAGE=y
CONFIG_USB_UAS=y
CONFIG_USB_HID=y
CONFIG_HID_GENERIC=y
CONFIG_INPUT_EVDEV=y
CONFIG_INPUT_KEYBOARD=y
CONFIG_KEYBOARD_ATKBD=y
CONFIG_SCSI=y
CONFIG_BLK_DEV_SD=y
CONFIG_CHR_DEV_SG=y
#
# ---- Filesystems: use the widest mainline 6.x support ----
CONFIG_EXT4_FS=y
CONFIG_EXT4_FS_POSIX_ACL=y
CONFIG_EXT4_FS_SECURITY=y
CONFIG_F2FS_FS=y
CONFIG_F2FS_FS_SECURITY=y
CONFIG_BTRFS_FS=y
CONFIG_XFS_FS=y
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_XZ=y
CONFIG_SQUASHFS_ZSTD=y
CONFIG_OVERLAY_FS=y
CONFIG_EXFAT_FS=y
CONFIG_NTFS3_FS=y
CONFIG_VFAT_FS=y
CONFIG_FAT_FS=y
CONFIG_FUSE_FS=y
CONFIG_AUTOFS_FS=y
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_NLS_DEFAULT="utf8"
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_UTF8=y
CONFIG_NFS_FS=y
CONFIG_CIFS=m
CONFIG_CIFS_XATTR=y
CONFIG_JBD2=y
CONFIG_FS_ENCRYPTION=y
CONFIG_FS_VERITY=y
#
# ---- Devmem access: probe hiboot VO registers from userspace (/dev/mem IO) ----
CONFIG_DEVMEM=y
CONFIG_STRICT_DEVMEM=y
#
# ---- Networking / DHCP (userspace client, but helpers useful) ----
CONFIG_NET=y
CONFIG_INET=y
CONFIG_IP_PNP=y
CONFIG_IP_PNP_DHCP=y
CONFIG_PACKET=y
CONFIG_UNIX=y
CONFIG_BRIDGE=m
CONFIG_TUN=m
CONFIG_IPV6=y
CONFIG_NETFILTER=y
#
# Wired Ethernet: hi3798mv100.dtsi declares eth0 (FEMAC @ 0x9840000) with
# status="disabled"; the board DTS enables it with &eth0 { status="okay"; }.
# The driver is already =y in hi3798mv100_defconfig (HISI_FEMAC /
# MDIO_HISI_FEMAC / NETDEVICES), and COMMON_CLK_HI3798 (= ARCH_HISI) provides
# the &crg clock/reset provider the probe needs. We restate them here so a
# future defconfig change or olddefconfig run cannot silently drop the MAC:
# without it eth0 never exists and systemd-networkd never starts a DHCP lease.
CONFIG_NET_VENDOR_HISILICON=y
CONFIG_HISI_FEMAC=y
CONFIG_MDIO_HISI_FEMAC=y
CONFIG_PHYLIB=y
CONFIG_NETDEVICES=y
#
# ---- Block / MMC / crypto ----
CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
CONFIG_BLK_DEV_LOOP=y
CONFIG_BLK_DEV_RAM=y
CONFIG_CRYPTO_SHA256=y
CONFIG_CRYPTO_AES=y
CONFIG_CRYPTO_CRC32C=y
#
# ---- Security: keep it minimal ----
# SELinux is not needed on this appliance and its host tool (genheaders)
# does not build on a Darwin host, which is where local iteration happens.
CONFIG_SECURITY_SELINUX=n
CONFIG_SECURITY_APPARMOR=n
CONFIG_SECURITY=n
