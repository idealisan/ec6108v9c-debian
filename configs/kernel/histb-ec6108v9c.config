# HISTB upstream (Linux 7.4-rc1 + histb-mainline/patches) config fragment.
# Applied on top of multi_v7_defconfig by scripts/build-kernel-histb.sh.
#
# This is the FIRST pipeline pass: goal is a compiling kernel + DTB + a U-disk
# flash package, not a perfectly tuned display stack. Symbols that do not exist
# in 7.4 are dropped by olddefconfig without failing the build; the CI log
# ("verify key options" step) tells us what actually landed, so we iterate from
# evidence rather than guessing. See docs/030-histb-build-pipeline.md.

# ---- SoC / boot: appended DTB + ATAG compat (hiboot hands over ATAG cmdline) ----
CONFIG_ARCH_HISI=y
CONFIG_ARM_APPENDED_DTB=y
CONFIG_ARM_ATAG_DTB_COMPAT=y
CONFIG_OF=y
CONFIG_USE_OF=y
CONFIG_ATAGS=y

# ---- Display: DRM VDP2 (32-bit ARM) + SiI9134 bridge (see docs/029) ----
# 600-17 defines DRM_HISTB_VDP2 (depends DRM && OF && ARM); 500-02 defines
# DRM_SII9134 (drivers/gpu/drm/bridge/Kconfig). VDP4 / DRM_HISTB_HDMI are
# ARM64 (mv200/mv200h) and deliberately NOT selected here.
CONFIG_DRM=y
CONFIG_DRM_HISTB_VDP2=y
CONFIG_DRM_SII9134=y
CONFIG_DRM_BRIDGE_CONNECTOR=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_FB=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE_DETECT_PRIMARY=y
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_VT_HW_CONSOLE_BINDING=y
CONFIG_LOGO=y

# ---- Clock / reset provider (HDMI ctrl/phy clocks, see 910-01 / 400-xx) ----
CONFIG_COMMON_CLK_HI3798=y
CONFIG_RESET_HISI=y
CONFIG_RESET_CONTROLLER=y
CONFIG_REGMAP_MMIO=y

# ---- Storage / root filesystem ----
CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
CONFIG_BLK_DEV_SD=y
CONFIG_SCSI=y
CONFIG_EXT4_FS=y
CONFIG_EXT4_FS_POSIX_ACL=y
CONFIG_VFAT_FS=y
CONFIG_FAT_FS=y

# ---- Network (FEMAC -> eth0, DHCP in userspace) ----
CONFIG_NET=y
CONFIG_INET=y
CONFIG_NETDEVICES=y
CONFIG_NET_VENDOR_HISILICON=y
CONFIG_HISI_FEMAC=y
CONFIG_PHYSLIB=y
CONFIG_PACKET=y
CONFIG_UNIX=y

# ---- USB / input ----
CONFIG_USB=y
CONFIG_USB_EHCI_HCD=y
CONFIG_USB_OHCI_HCD=y
CONFIG_USB_STORAGE=y
CONFIG_USB_HID=y

# ---- pstore / ramoops: only surviving log channel (no serial hardware) ----
CONFIG_PSTORE=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_PMSG=y
CONFIG_PSTORE_RAM=y
CONFIG_PSTORE_DEFLATE_COMPRESS=y

# ---- misc ----
CONFIG_DEVMEM=y
CONFIG_BLK_DEV_RAM=y
CONFIG_CRYPTO_SHA256=y
CONFIG_CRYPTO_CRC32C=y
