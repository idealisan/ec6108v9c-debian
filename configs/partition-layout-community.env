# Community (ECOO) partition layout - kept for diagnostics.
#
# The community image uses 9 partitions with the rootfs at p9 (LBA 0x131000)
# and a 512M "backup" partition at p8. A kernel built with this layout boots
# the COMMUNITY rootfs, which gives us SSH access to a box running our
# 6.x kernel - that is how we get a boot log (dmesg) without a serial console.
#
# Use it via: LAYOUT_ENV=configs/partition-layout-community.env
BLKDEVPARTS="mmcblk0:1M(boot),1M(bootargs),4M(baseparam),4M(pqparam),4M(logo),20M(kernel),64M(busybox),512M(backup),-(ubuntu)"
ROOT_DEV="mmcblk0p9"
MEM_SIZE="0x40000000"
MEM_SIZE_STR="1G"

# Optional extra kernel params (e.g. ramoops.mem_address=... for pstore).
EXTRA_CMDLINE=${EXTRA_CMDLINE:-}
KERNEL_CMDLINE_NO_MEM="model=mv100 clk_ignore_unused console=tty0 console=ttyAMA0,115200 root=${ROOT_DEV} rootfstype=ext4 rootwait rw blkdevparts=${BLKDEVPARTS} debian_flash=1 ${EXTRA_CMDLINE}"
KERNEL_CMDLINE="${KERNEL_CMDLINE_NO_MEM} mem=${MEM_SIZE_STR}"
