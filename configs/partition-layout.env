# Shared partition / memory layout for EC6108V9C (Hi3798MV100).
# SINGLE SOURCE OF TRUTH: both the kernel DTS (cmdline + /memory) and the
# U-disk flash package (p2 runtime env) source this file, so the root device
# and the partition table can never drift apart.
#
# The layout matches the community 9-partition scheme minus the 512M backup
# partition, which is reclaimed into the rootfs (last partition = p8).
#
# DDR size: verified 1 GiB on this box (/proc/iomem: 00000000-3fffffff).
# MEM_SIZE / MEM_SIZE_STR must be adjusted for other DDR variants.
BLKDEVPARTS="mmcblk0:1M(boot),1M(bootargs),4M(baseparam),4M(pqparam),4M(logo),20M(kernel),64M(busybox),-(debian)"
ROOT_DEV="mmcblk0p8"
MEM_SIZE="0x40000000"
MEM_SIZE_STR="1G"

# Kernel command line without mem=. The p2 runtime env uses this (mem= is
# selected by hiboot through the bootargs_<size> variables), while the DTB
# uses the full line below.
# Optional extra kernel params (e.g. ramoops.mem_address=... for pstore).
EXTRA_CMDLINE=${EXTRA_CMDLINE:-}
# net.ifnames=0 keeps the FEMAC interface named eth0. Debian's predictable
# interface naming can rename it (e.g. end0), and systemd-networkd's
# [Match] Name=eth0 would then never match - the box boots, eth0 exists, but
# no DHCP lease is ever requested and no IP appears in the router.
#
# fbcon=map:0 is the plan-B fix for "green boot marker is visible but no
# console text". On ARM, fb_is_primary_device() (arch/arm/include/asm/fb.h)
# is hardcoded to 0, so with CONFIG_FRAMEBUFFER_CONSOLE_DETECT_PRIMARY=y the
# fbcon_select_primary() path in do_fb_registered() can never mark our
# runtime-registered simplefb as the primary device. The "map:" setup handler
# (drivers/video/fbdev/core/fbcon.c, __setup("fbcon=")) sets map_override=1,
# which makes that branch a no-op, and pins con2fb_map_boot[] to fb0 so the
# VC->fb0 takeover happens. Pure cmdline: no kernel config change (which
# olddefconfig could silently revert) and no driver change. See docs/024 6.4.
# root= MUST carry the /dev/ prefix. name_to_dev_t() (init/do_mounts.c)
# routes "mmcblk0p8" to devt_from_devnum(), which parses it as HEX and bails
# on the very first 'm' -> returns 0 forever. That made the rootwait loop at
# do_mounts.c:635 (`while (driver_probe_done() || (ROOT_DEV =
# name_to_dev_t(...)) == 0) msleep(5);`) spin SILENTLY with no printk at all -
# the exact real-HW symptom "kernel alive, USB irq still works, but boot stops
# after 'random: crng init done' with no further text". With /dev/ prefix it
# goes through devt_from_devname() -> blk_lookup_devt() -> real partition dev_t.
#
# rootwait is replaced by rootdelay=5 on purpose: if the root device is still
# missing we WANT mount_root() to fail loudly with "VFS: Cannot open root
# device" + "here are the available partitions" + panic (all visible on our
# CON_ANYTIME framebuffer console), instead of silently waiting forever.
KERNEL_CMDLINE_NO_MEM="model=mv100 clk_ignore_unused console=tty0 console=ttyAMA0,115200 root=/dev/${ROOT_DEV} rootfstype=ext4 rootdelay=5 rw blkdevparts=${BLKDEVPARTS} net.ifnames=0 fbcon=map:0 debian_flash=1 ${EXTRA_CMDLINE}"

# Full command line baked into the DTB (/chosen/bootargs). It is
# authoritative: with CONFIG_ARM_APPENDED_DTB the DT command line replaces
# whatever the bootloader passes, so it must be complete.
#
# clk_ignore_unused is mandatory: the 6.x crg-hi3798 clock driver is enabled
# by default and would otherwise gate the VO/HDMI/VDP clocks that hiboot
# left running, leaving the HDMI output dark.
#
# mem= is mandatory as well: the upstream board DTB has no /memory node and
# without mem= the kernel would come up with zero RAM.
KERNEL_CMDLINE="${KERNEL_CMDLINE_NO_MEM} mem=${MEM_SIZE_STR}"
